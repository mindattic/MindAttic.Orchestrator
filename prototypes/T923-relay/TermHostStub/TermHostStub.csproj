<Project Sdk="Microsoft.NET.Sdk">

  <!-- M.ORCH-T923: throwaway Phase 0 prototype of the CLI host (spike M.ORCH-T922). Not part of MindAttic.Orchestrator.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TermHostStub</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- The same bundled ConPTY (conpty.dll + OpenConsole.exe) the app gets through EasyWindowsTerminalControl, not the inbox one. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
  </ItemGroup>

</Project>
