<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- For the dashboard's view models (MindAttic.Orchestrator.Wpf). -->
    <UseWPF>true</UseWPF>
    <!-- SnapshotWriterProgram.Main: SnapshotFileTests start this assembly as separate writer processes. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>MindAttic.Orchestrator.Tests.SnapshotWriterProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MindAttic.Orchestrator.Core\MindAttic.Orchestrator.Core.csproj" />
    <ProjectReference Include="..\..\src\MindAttic.Orchestrator.Cli\MindAttic.Orchestrator.Cli.csproj" />
    <ProjectReference Include="..\..\src\MindAttic.Orchestrator.Wpf\MindAttic.Orchestrator.Wpf.csproj" />
    <!-- TermHost's protocol, options and replay pieces (M.ORCH-T924, M.ORCH-T927). -->
    <ProjectReference Include="..\..\src\MindAttic.Orchestrator.Term\MindAttic.Orchestrator.Term.csproj" />
    <ProjectReference Include="..\..\src\MindAttic.Orchestrator.TermHost\MindAttic.Orchestrator.TermHost.csproj" />
  </ItemGroup>

</Project>
