<Grid x:Class="MindAttic.Orchestrator.Wpf.Views.RoadmapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
      xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
      xmlns:views="clr-namespace:MindAttic.Orchestrator.Wpf.Views"
      Background="{DynamicResource MaChrome}">
    <Grid.Resources>
        <!-- One block (M.ORCH-T2386): a repo in the grid, or a ticket in a level row. Name (two lines, then trimmed), its id or
             milestone muted, a fill bar and percent, what it holds, and who has it. -->
        <DataTemplate x:Key="RoadmapBlock" DataType="{x:Type vm:RoadmapBlockViewModel}">
            <Button Style="{StaticResource MaTileButton}" Height="Auto" Margin="0" Padding="{StaticResource SpaceS}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    Command="{Binding DataContext.Roadmap.SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}"
                    CommandParameter="{Binding}" mc:MaTile.IsSelected="{Binding IsSelected}" ContextMenuOpening="Block_ContextMenuOpening" mc:MaCallout.ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding SpokenName}">
                <StackPanel>
                    <DockPanel>
                        <mc:MaBadge DockPanel.Dock="Right" Style="{StaticResource MaTag}" Content="{Binding Initials}" Margin="{StaticResource SpaceLS}"
                                    mc:MaCallout.ToolTip="{Binding WhoName}" Visibility="{Binding HasWho, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MaMutedText}" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="{StaticResource SpaceTS}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" />
                        <ProgressBar Style="{StaticResource MaProgressBar}" Height="6" VerticalAlignment="Center"
                                     Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Fill}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MaMutedText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="{StaticResource SpaceM}">
        <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Back to terminal" Padding="{StaticResource SpaceHLVS}"
                Command="{Binding ShowTerminalCommand}" AutomationProperties.Name="Close the Roadmap and show the terminal" />
        <TextBlock Style="{StaticResource MaHeading}" VerticalAlignment="Center">
            <Run Text="Roadmap" /><Run Text="  " /><Run Text="{Binding Roadmap.SummaryText, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
        </TextBlock>
    </DockPanel>
    <ScrollViewer x:Name="Body" Grid.Row="1" Style="{StaticResource MaBodyScroll}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Content" Margin="{StaticResource SpaceM}">
            <StackPanel x:Name="Rows">
                <DockPanel>
                    <ListBox DockPanel.Dock="Right" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Roadmap.Sorts}"
                             SelectedItem="{Binding Roadmap.Sort}" AutomationProperties.Name="Sort the repos" />
                    <TextBox Style="{StaticResource MaTextBox}" Text="{Binding Roadmap.Filter, UpdateSourceTrigger=PropertyChanged}"
                             Margin="{StaticResource SpaceRS}" AutomationProperties.Name="Filter the repos by name or milestone" />
                </DockPanel>
                <ItemsControl Style="{StaticResource MaList}" ItemsSource="{Binding Roadmap.Crumbs}" Margin="{StaticResource SpaceTS}"
                              AutomationProperties.Name="Where you are: repo, epic, feature, story">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RoadmapCrumb}">
                            <Button Style="{StaticResource MaTextButton}" Content="{Binding Text}" Padding="{StaticResource SpaceHSVXS}" Margin="0"
                                    Command="{Binding DataContext.Roadmap.CrumbCommand, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Back to {0}'}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="RepoGrid" Style="{StaticResource MaTileList}" ItemsSource="{Binding Roadmap.Repos}" Margin="{StaticResource SpaceTS}"
                              mc:MaList.MinItemWidth="{Binding Roadmap.BlockWidth}" ItemTemplate="{StaticResource RoadmapBlock}"
                              AutomationProperties.Name="Repos" />
                <ItemsControl Style="{StaticResource MaList}" ItemsSource="{Binding Roadmap.Levels}" AutomationProperties.Name="Levels under the selection">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RoadmapLevelViewModel}">
                            <StackPanel Margin="{Binding DataContext.Roadmap.RowGapMargin, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MaSectionLabel}" />
                                <ItemsControl Style="{StaticResource MaTileList}" ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource RoadmapBlock}"
                                              mc:MaList.MinItemWidth="{Binding DataContext.Roadmap.BlockWidth, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}"
                                              AutomationProperties.Name="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Canvas x:Name="Connectors" IsHitTestVisible="False" />
        </Grid>
    </ScrollViewer>
</Grid>
