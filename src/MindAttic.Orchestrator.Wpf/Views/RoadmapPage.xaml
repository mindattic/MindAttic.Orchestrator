<Grid x:Class="MindAttic.Orchestrator.Wpf.Views.RoadmapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
      xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
      xmlns:views="clr-namespace:MindAttic.Orchestrator.Wpf.Views"
      Background="{DynamicResource MaChrome}">
    <Grid.Resources>
        <!-- The last breadcrumb's padding: a crumb button's SpaceHSVXS plus MaTextButton's 1px transparent border. -->
        <Thickness x:Key="RoadmapCrumbTextPadding">9,5,9,5</Thickness>
        <!-- One list row (M.ORCH-T2394): a repo, or a ticket in the column of its parent's children. Its name (wrapping), its id,
             level and what it holds muted, its description as plain text up to the Vault's line count, a fill bar and percent,
             and who has it. -->
        <DataTemplate x:Key="RoadmapRow" DataType="{x:Type vm:RoadmapRowViewModel}">
            <Button Style="{StaticResource MaTileButton}" Height="Auto" Margin="0" Padding="{StaticResource SpaceS}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    Command="{Binding DataContext.Roadmap.SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}"
                    CommandParameter="{Binding}" mc:MaTile.IsSelected="{Binding IsSelected}" ContextMenuOpening="Row_ContextMenuOpening"
                    AutomationProperties.Name="{Binding SpokenName}">
                <StackPanel>
                    <DockPanel>
                        <mc:MaBadge DockPanel.Dock="Right" Style="{StaticResource MaTag}" Content="{Binding Initials}" Margin="{StaticResource SpaceLS}"
                                    VerticalAlignment="Top" mc:MaCallout.ToolTip="{Binding WhoName}" Visibility="{Binding HasWho, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource MaTileSubtitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Margin="{StaticResource SpaceTS}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="{x:Static vm:RoadmapRowViewModel.DescriptionLineHeight}"
                               MaxHeight="{Binding DescriptionMaxHeight}" Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                    <DockPanel Margin="{StaticResource SpaceTS}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" />
                        <ProgressBar Style="{StaticResource MaProgressBar}" Height="4" VerticalAlignment="Center"
                                     Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Fill}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MaTileSubtitle}" TextWrapping="Wrap"
                               Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="{StaticResource SpaceM}">
        <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Back to terminal" Padding="{StaticResource SpaceHLVS}"
                Command="{Binding ShowTerminalCommand}" AutomationProperties.Name="Close the Roadmap and show the terminal" />
        <TextBlock Style="{StaticResource MaHeading}" VerticalAlignment="Center">
            <Run Text="Roadmap" /><Run Text="  " /><Run Text="{Binding Roadmap.SummaryText, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
        </TextBlock>
    </DockPanel>
    <ItemsControl Grid.Row="1" Style="{StaticResource MaList}" ItemsSource="{Binding Roadmap.Crumbs}" Margin="{StaticResource SpaceHMVXS}"
                  AutomationProperties.Name="Where you are: repo, epic, feature, story">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <!-- A classic rail (M.ORCH-T2399): a chevron between crumbs, outside them; every crumb but the last a button back
                 there, the last plain text padded as the button's padding plus its 1px transparent border, so both line up. -->
            <DataTemplate DataType="{x:Type vm:RoadmapCrumb}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MaMuted}"
                               Margin="{StaticResource SpaceHSVXS}" VerticalAlignment="Center" AutomationProperties.Name="then"
                               Visibility="{Binding HasChevron, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource MaTextButton}" Content="{Binding Name}" Padding="{StaticResource SpaceHSVXS}" Margin="0"
                            VerticalAlignment="Center" Visibility="{Binding IsLink, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.Roadmap.CrumbCommand, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Back to {0}'}" />
                    <TextBlock Text="{Binding Name}" Padding="{StaticResource RoadmapCrumbTextPadding}" Margin="0" VerticalAlignment="Center"
                               Visibility="{Binding IsLast, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Name, StringFormat='You are at {0}'}" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- Drill-down columns (M.ORCH-T2394): the repos, then one list per opened row, side by side and scrolling sideways; each
         column scrolls down on its own. -->
    <ScrollViewer x:Name="Body" Grid.Row="2" Style="{StaticResource MaBodyScroll}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
            <Grid Width="{Binding Roadmap.ColumnWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Repos" Style="{StaticResource MaSectionLabel}" />
                <StackPanel Grid.Row="1">
                    <TextBox Style="{StaticResource MaTextBox}" Text="{Binding Roadmap.Filter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter the repos by name or milestone" />
                    <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Roadmap.Sorts}" Margin="{StaticResource SpaceTS}"
                             SelectedItem="{Binding Roadmap.Sort}" AutomationProperties.Name="Sort the repos" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,8,12,0">
                    <ItemsControl Style="{StaticResource MaRowList}" ItemsSource="{Binding Roadmap.Repos}" ItemTemplate="{StaticResource RoadmapRow}"
                                  AutomationProperties.Name="Repos" />
                </ScrollViewer>
            </Grid>
            <ItemsControl x:Name="OpenColumns" Style="{StaticResource MaList}" ItemsSource="{Binding Roadmap.Columns}" AutomationProperties.Name="Opened lists">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoadmapColumnViewModel}">
                        <Grid Margin="{StaticResource SpaceLM}"
                              Width="{Binding DataContext.Roadmap.ColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type views:RoadmapPage}}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource MaSectionLabel}" TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="1" Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,8,12,0">
                                <ItemsControl Style="{StaticResource MaRowList}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RoadmapRow}"
                                              AutomationProperties.Name="{Binding Title}" />
                            </ScrollViewer>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Grid>
