<Window x:Class="MindAttic.Orchestrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
        xmlns:local="clr-namespace:MindAttic.Orchestrator.Wpf"
        mc:McWindow.DarkTitleBar="True"
        Title="MindAttic Orchestrator" Width="1480" Height="920" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/logo.ico"
        Background="{StaticResource McChrome}" Foreground="{StaticResource McText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static vm:WindowCommands.FocusSearch}" />
        <KeyBinding Key="Escape" Command="{x:Static vm:WindowCommands.Escape}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ZoomResetCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- One repo tile. -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:RepoTileViewModel}">
            <Button Style="{StaticResource RepoTile}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Headline}"
                    AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Accent}" CornerRadius="3,0,0,3" />
                    <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TokensText}" Style="{StaticResource McTileSubtitle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Tokens today" />
                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource PulseDot}" Fill="{Binding Accent}"
                                     VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource McTileSubtitle}"
                                   Margin="16,4,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- A header card: every one is a button, so keyboard users reach it and its tooltip (shown on focus too). -->
        <Style x:Key="SmallStat" TargetType="Button" BasedOn="{StaticResource StatCard}">
            <!-- The AlignedGrid gives every tile the same width and the gaps between them; a tile carries no size or margin. -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="14,0,16,0" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- A body view (repos, queue, audit, agents): the same 24px gutters as the header and toolbar. While the vertical
             scroll bar shows, it sits inside the right gutter instead of pushing the content in (M.ORCH-T192). -->
        <Style x:Key="BodyScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="24,0,24,16" />
            <Style.Triggers>
                <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                    <Setter Property="Padding" Value="{x:Static local:Gutters.BesideScrollBar}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header, read left to right: the work (who needs you, who's working, their subagents, what's queued), then the
             tokens (this 5-hour window, the week, the pace ledger, today). Every card is a button that goes somewhere. -->
        <!-- The header owns the window's left/right gutter; nothing inside it adds its own, so the tiles and the chart
             share both edges (M.ORCH-T192). The tiles are equal cells that together span the row at any width. -->
        <StackPanel x:Name="Header" Grid.Row="0" Margin="24,18,24,0">
        <local:AlignedGrid x:Name="StatTiles" MinItemWidth="160" Gap="10" RowGap="10" Balanced="True" UniformRows="True"
                           AutomationProperties.Name="Summary">
            <Button Command="{Binding FocusCommand}" CommandParameter="Waiting" ToolTip="Repos whose agent stopped and is waiting for you. Shows only those."
                    AutomationProperties.Name="{Binding WaitingCount, StringFormat='{}{0} need you: show only those repos'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallStat}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Focus}" Value="Waiting">
                                <Setter Property="BorderBrush" Value="{x:Static vm:Palette.Waiting}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding WaitingCount}" Style="{StaticResource StatValue}" Foreground="{x:Static vm:Palette.Waiting}" />
                    <TextBlock Text="Need you" Style="{StaticResource McTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding FocusCommand}" CommandParameter="Working" ToolTip="Repos with an agent mid-turn right now. Shows only those."
                    AutomationProperties.Name="{Binding WorkingCount, StringFormat='{}{0} working: show only those repos'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallStat}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Focus}" Value="Working">
                                <Setter Property="BorderBrush" Value="{x:Static vm:Palette.Working}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding WorkingCount}" Style="{StaticResource StatValue}" Foreground="{x:Static vm:Palette.Working}" />
                    <TextBlock Text="Working" Style="{StaticResource McTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SmallStat}" Command="{Binding ShowViewCommand}" CommandParameter="Agents"
                    ToolTip="Subagents running inside every CLI and autopilot agent. Opens the agent board."
                    AutomationProperties.Name="{Binding SubagentCount, StringFormat='{}{0} subagents running: open the agent board'}">
                <StackPanel>
                    <TextBlock Text="{Binding SubagentCount}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="Subagents" Style="{StaticResource McTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding FocusCommand}" CommandParameter="Tickets" ToolTip="Repos with open tickets and no session. Shows only those."
                    AutomationProperties.Name="{Binding TicketCount, StringFormat='{}{0} open tickets: show repos with tickets and no session'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallStat}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Focus}" Value="Tickets">
                                <Setter Property="BorderBrush" Value="{x:Static vm:Palette.Tickets}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding TicketCount}" Style="{StaticResource StatValue}" Foreground="{x:Static vm:Palette.Tickets}" />
                    <TextBlock Text="Open tickets" Style="{StaticResource McTileSubtitle}" />
                </StackPanel>
            </Button>

            <!-- Budget: the current 5-hour block. Click to set limits. -->
            <Button Style="{StaticResource SmallStat}" HorizontalContentAlignment="Stretch" Command="{Binding ToggleSettingsCommand}"
                    ToolTip="{Binding BudgetTooltip}"
                    AutomationProperties.Name="{Binding BudgetHeadline, StringFormat='5-hour window {0} used: open budget settings'}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding BudgetHeadline}" Style="{StaticResource StatValue}"
                                   Foreground="{Binding BudgetBrush}" />
                        <TextBlock Text="{Binding BudgetCaption}" Style="{StaticResource McTileSubtitle}" VerticalAlignment="Center"
                                   Margin="8,4,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <Grid Height="6" Margin="0,4,0,4">
                        <Border Background="{StaticResource McControlBorder}" CornerRadius="3" />
                        <Border Background="{Binding BudgetBrush}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BudgetFill}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <!-- While pacing holds work back, that's the line that matters; the full detail stays in the tooltip. -->
                    <TextBlock Text="{Binding BudgetDetail}" Style="{StaticResource McTileSubtitle}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding PaceText, Converter={x:Static vm:Converters.EmptyToVisible}}" />
                    <TextBlock Text="{Binding PaceText}" Style="{StaticResource McTileSubtitle}" Foreground="{Binding PaceBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding PaceText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                </StackPanel>
            </Button>
            <!-- Weekly: the other half of /status's picture; the 5-hour card never shows it on its own. -->
            <Button Style="{StaticResource SmallStat}" Command="{Binding ToggleSettingsCommand}"
                    ToolTip="How much of Claude's weekly limit is left (/status reports the used share). Opens settings, where the weekly reset is set."
                    AutomationProperties.Name="{Binding WeeklyHeadline, StringFormat='Week {0}: open settings'}">
                <StackPanel>
                    <TextBlock Text="{Binding WeeklyHeadline}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding WeeklyCaption}" Style="{StaticResource McTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SmallStat}" Command="{Binding ShowViewCommand}" CommandParameter="Repos"
                    ToolTip="Claude Code tokens since midnight, every session (cache reads included). Opens the repos, busiest first."
                    AutomationProperties.Name="{Binding TokensToday, StringFormat='{}{0} tokens today: open the repos'}">
                <StackPanel>
                    <TextBlock Text="{Binding TokensToday}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding TokensDetail}" Style="{StaticResource McTileSubtitle}" />
                </StackPanel>
            </Button>
        </local:AlignedGrid>
        <!-- This 5-hour window's utilization (M.ORCH-T191): its own full-width row under the tiles, tall enough that the
             pace line straight to the target at the reset, the window's own line (red while over that pace, green under)
             and where the recent rate ends up are easy to read. The caption says it in words. -->
        <Border x:Name="UtilizationCard" Style="{StaticResource Card}" Margin="0,12,0,12" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding UtilizationText, StringFormat='5-hour utilization: {0}'}"
                Visibility="{Binding UtilizationText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
            <StackPanel>
                <TextBlock Text="5-hour utilization" Style="{StaticResource SectionLabel}" />
                <local:UtilizationChart Data="{Binding Utilization}" Height="260" Margin="0,8,0,8" />
                <TextBlock Text="{Binding UtilizationText}" Style="{StaticResource McTileSubtitle}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Margin="24,8,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <ListBox Style="{StaticResource PillChoice}" ItemsSource="{Binding ViewChoices}" Padding="0"
                         SelectedItem="{Binding ViewChoice}" VerticalAlignment="Center" Margin="0,6,14,0"
                         AutomationProperties.Name="View" />
                <Grid Width="300" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsReposView, Converter={StaticResource Visible}}">
                    <TextBox x:Name="SearchBox" Style="{StaticResource McTextBox}" Height="32"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search repos and tickets" />
                    <TextBlock Text="Search repos and tickets   Ctrl+F" Style="{StaticResource Muted}" IsHitTestVisible="False"
                               Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Visibility>
                            <Binding Path="Search" Converter="{x:Static vm:Converters.EmptyToVisible}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
                <ToggleButton Style="{StaticResource PillToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding ShowQuiet}" Content="Show quiet repos"
                              Visibility="{Binding IsReposView, Converter={StaticResource Visible}}" />
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ZoomText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                           ToolTip="Ctrl+0 resets the zoom" />
                <TextBlock Text="{Binding Clock.Text}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.Name="Current time" ToolTip="Current time" />
                <TextBlock Text="{Binding RefreshInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource McButton}" Command="{Binding RefreshCommand}" Content="Refresh" ToolTip="F5" />
                <Button Style="{StaticResource McButton}" Command="{Binding ToggleSettingsCommand}" Content="Settings" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Toasts: what just happened (a session finished its turn, the pace changed). Their own row, so they push the page
             down instead of covering whatever has keyboard focus (WCAG 2.4.11); MainWindow also reads each one out. -->
        <ItemsControl x:Name="ToastRow" Grid.Row="2" ItemsSource="{Binding Toasts}" Margin="24,0,24,6" Focusable="False" AutomationProperties.Name="Notifications">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border Background="{StaticResource McSurface}" BorderBrush="{Binding Accent}" BorderThickness="1"
                            CornerRadius="6" Margin="0,0,8,8" Width="340">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="{Binding Accent}" CornerRadius="5,0,0,5" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource McToolButton}" Content="&#xE711;" FontSize="10"
                                    VerticalAlignment="Top" Margin="0,4,4,0" ToolTip="Dismiss"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Dismiss: {0}'}"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left"
                                    FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding Title}"
                                    AutomationProperties.HelpText="{Binding Body}"
                                    Command="{Binding DataContext.OpenToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Margin="12,10,4,10" />
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource McText}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="34" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Body: grouped tiles, and the selected repo's detail pane. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="ReposBody" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsReposView, Converter={StaticResource Visible}}">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileGroupViewModel}">
                                <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Visible}}" Margin="0,4,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="14" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:AlignedGrid MinItemWidth="240" Gap="10" RowGap="10" UniformRows="True" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                                Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                        <TextBlock Text="Nothing needs you right now." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="No agent is working or waiting and no tickets match. Clear the search or show quiet repos."
                                   Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Detail pane -->
            <Border Grid.Column="1" Width="420" Background="#FF23252B" BorderBrush="{StaticResource McChromeBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowDetail, Converter={StaticResource Visible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,20" DataContext="{Binding}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource McToolButton}" Content="&#xE711;"
                                    Command="{Binding SelectCommand}" CommandParameter="{Binding Selected}"
                                    ToolTip="Close (Esc)" AutomationProperties.Name="Close details" />
                            <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        </DockPanel>
                        <Button Style="{StaticResource McTextButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="8,3" MinHeight="24"
                                Command="{Binding OpenFolderCommand}" ToolTip="Open in Explorer"
                                AutomationProperties.Name="{Binding Selected.Path, StringFormat='Open {0} in Explorer'}"
                                Visibility="{Binding Selected.HasFolder, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding Selected.Path}" FontSize="11" Foreground="{StaticResource McMuted}" TextTrimming="CharacterEllipsis" />
                        </Button>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" BorderBrush="{Binding Selected.Accent}">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.StateLabel}" Foreground="{Binding Selected.Accent}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Selected.Headline}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Start a session -->
                        <TextBlock Text="START A SESSION" Style="{StaticResource SectionLabel}" />
                        <ListBox Style="{StaticResource PillChoice}" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                                 AutomationProperties.Name="Agent provider" />
                        <Grid Margin="0,4,0,0">
                            <TextBox Style="{StaticResource McTextBox}" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="Opening prompt (optional)" />
                            <TextBlock Text="Opening prompt (optional), or pick a ticket below" Style="{StaticResource Muted}"
                                       IsHitTestVisible="False" Margin="9,6,0,0"
                                       Visibility="{Binding Prompt, Converter={x:Static vm:Converters.EmptyToVisible}}" />
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource McPrimaryButton}" Command="{Binding StartCommand}">
                                <TextBlock>
                                    <Run Text="Start " /><Run Text="{Binding Provider, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                            <TextBlock Text="Opens a Launcher tab rooted here. The prompt is pre-filled, not sent."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource McFocus}" />

                        <!-- Live tabs -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Hosts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="LAUNCHER TABS" Style="{StaticResource SectionLabel}" />
                            <ItemsControl ItemsSource="{Binding Selected.Hosts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HostRowViewModel}">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource McButton}" Content="Send" Margin="6,0,0,0"
                                                            Padding="12,5" Command="{Binding SendCommand}" IsDefault="False" />
                                                    <Grid>
                                                        <TextBox Style="{StaticResource McTextBox}" Height="30"
                                                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Text to type into this tab" />
                                                        <TextBlock Text="Reply to this tab…" Style="{StaticResource Muted}"
                                                                   IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding Draft, Converter={x:Static vm:Converters.EmptyToVisible}}" />
                                                    </Grid>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Feedback}" Style="{StaticResource Muted}" Margin="0,4,0,0">
                                                    <TextBlock.Visibility>
                                                        <Binding Path="Feedback" Converter="{x:Static vm:Converters.EmptyToCollapsed}" />
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Open tickets -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Tickets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource SectionLabel}">
                                <Run Text="OPEN TICKETS · " /><Run Text="{Binding Selected.Tickets.Count, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Selected.Tickets}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TicketRowViewModel}">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource McTextButton}" Padding="10,3" MinHeight="24"
                                                            Content="Use as prompt" AutomationProperties.Name="{Binding Id, StringFormat='Use {0} as the prompt'}"
                                                            Command="{Binding DataContext.UseTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Run Text="{Binding Id, Mode=OneWay}" Foreground="{x:Static vm:Palette.Tickets}" FontWeight="SemiBold" />
                                                        <Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource McMuted}" />
                                                        <Run Text="  " /><Run Text="{Binding Date, Mode=OneWay}" Foreground="{StaticResource McMuted}" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Tokens -->
                        <StackPanel Visibility="{Binding Selected.HasUsage, Converter={StaticResource Visible}}">
                            <TextBlock Text="TOKENS TODAY" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource Card}">
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageOutput}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="output" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageInput}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="input" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageCacheWrite}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="cache write" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageCacheRead}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="cache read" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- Recent sessions -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Sessions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="RECENT CLAUDE SESSIONS" Style="{StaticResource SectionLabel}" />
                            <ItemsControl ItemsSource="{Binding Selected.Sessions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionRowViewModel}">
                                        <Grid Margin="0,0,0,6" ToolTip="{Binding SessionId}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ShortId}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Grid.Column="1" Text="{Binding Model}" Style="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="2" Text="{Binding LastWrite}" Style="{StaticResource Muted}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Tokens}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Queue view: every open ticket across the workspace, and what the scheduler proposes. -->
            <ScrollViewer x:Name="QueueBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsQueueView, Converter={StaticResource Visible}}">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Left">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SlotsText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AutopilotText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </DockPanel>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{x:Static vm:Palette.Waiting}"
                            Visibility="{Binding HasHold, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Hold}" Foreground="{x:Static vm:Palette.Waiting}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding QueueMessage}" Foreground="{StaticResource McFocus}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding QueueMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                    <!-- Finished work: closed tickets whose assignment or worktree is still around. -->
                    <ItemsControl ItemsSource="{Binding Finished}" Focusable="False" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FinishedViewModel}">
                                <Border Style="{StaticResource Card}" BorderBrush="{x:Static vm:Palette.Working}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource McButton}" Padding="12,5"
                                                Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                                ToolTip="git keeps the worktree if it has uncommitted changes; the branch is never deleted" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource McButton}" Padding="12,5" Margin="0,0,8,0"
                                                Content="Details" Command="{Binding DetailsCommand}"
                                                ToolTip="The sessions that worked on it and the commits that mention it" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Proposals -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proposals.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="NEXT UP" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Proposals}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QueueRowViewModel}">
                                    <Border Style="{StaticResource Card}" Width="370" Margin="0,0,10,10" BorderBrush="{x:Static vm:Palette.Working}">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" Foreground="{x:Static vm:Palette.Working}" />
                                                <Run Text="  " /><Run Text="{Binding Repo, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource McMuted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,10,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource McPrimaryButton}" Content="Start" Padding="16,5"
                                                        Command="{Binding StartCommand}" ToolTip="Opens a tab with the ticket pre-filled as its prompt; you press Enter" />
                                                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <Run Text="{Binding Reason, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Where, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Full queue -->
                    <TextBlock Style="{StaticResource SectionLabel}">
                        <Run Text="QUEUE · " /><Run Text="{Binding QueueCount, Mode=OneWay}" /><Run Text=" waiting · reserved first, then priority, smallest estimate, fixes before features, oldest" />
                    </TextBlock>
                    <TextBlock Text="{Binding EmptyQueueText, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Queue}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueRowViewModel}">
                                <Border Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource McToolButton}" Width="24" Height="24" FontSize="10" Content="&#xE70E;"
                                                    Command="{Binding UpCommand}" ToolTip="Raise priority" AutomationProperties.Name="Raise priority" />
                                            <Button Style="{StaticResource McToolButton}" Width="24" Height="24" FontSize="10" Content="&#xE70D;"
                                                    Command="{Binding DownCommand}" ToolTip="Lower priority" AutomationProperties.Name="Lower priority" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Id}" FontWeight="SemiBold" Foreground="{x:Static vm:Palette.Tickets}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Repo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                            <Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource McMuted}" />
                                            <Run Text="{Binding Priority, Mode=OneWay}" Foreground="{x:Static vm:Palette.Waiting}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="5" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Summary}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="6" Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="7" Orientation="Horizontal">
                                            <Button Style="{StaticResource McButton}" Padding="12,4" Content="Start" Command="{Binding StartCommand}"
                                                    Visibility="{Binding IsAssigned, Converter={x:Static vm:Converters.FalseToVisible}}" />
                                            <Button Style="{StaticResource McButton}" Padding="12,4" Content="Release" Command="{Binding ReleaseCommand}"
                                                    ToolTip="Put it back in the queue (the session and any worktree are left alone)"
                                                    Visibility="{Binding IsAssigned, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Audit view: what's duplicated across repos and which shared agent files drifted. -->
            <ScrollViewer x:Name="AuditBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsAuditView, Converter={StaticResource Visible}}">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Left">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource McPrimaryButton}" Content="Run audit" Padding="16,6"
                                Command="{Binding RunAuditCommand}" />
                        <TextBlock Text="{Binding AuditInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding DuplicatesHeader}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Code that lives in more than one repo. Identical copies are the easiest wins: move one into the suggested home and reference it."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Duplicates}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                <Border Style="{StaticResource Card}" Width="380" Margin="0,0,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource McTextButton}" Padding="10,3" Content="Compare"
                                                    Command="{Binding CompareCommand}" ToolTip="Diff the first two copies (VS Code if installed)" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{x:Static vm:Palette.Waiting}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Identical}" Value="True">
                                                                <Setter Property="Foreground" Value="{x:Static vm:Palette.Working}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                        <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AuditFileViewModel}">
                                                    <Button Command="{Binding OpenCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                            HorizontalContentAlignment="Left" ToolTip="Open" MinHeight="24"
                                                            FocusVisualStyle="{StaticResource FocusRing}">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="Open {0} {1}">
                                                                <Binding Path="Repo" />
                                                                <Binding Path="RelativePath" />
                                                            </MultiBinding>
                                                        </AutomationProperties.Name>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter Margin="0,1" VerticalAlignment="Center" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Repo, Mode=OneWay}" Foreground="{StaticResource McText}" />
                                                            <Run Text="{Binding RelativePath, Mode=OneWay}" Foreground="{StaticResource McMuted}" />
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding More}" Style="{StaticResource Muted}" Margin="0,2,0,0" ToolTip="{Binding AllFiles}"
                                                   Visibility="{Binding More, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DriftHeader}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="For each agent file most repos share, the version most repos have is canonical. Drifted copies are stale edits of it; custom ones are different files under the same name."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Drift}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriftViewModel}">
                                <Border Style="{StaticResource Card}" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{x:Static vm:Palette.Waiting}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource McMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Repo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding File}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Similarity}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Style="{StaticResource McButton}" Padding="12,4" Content="Compare"
                                                Command="{Binding CompareCommand}" ToolTip="Diff against the canonical version" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding MissingHeader}" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Missing}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MissingViewModel}">
                                <Border Style="{StaticResource Card}" Padding="10,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource McTextButton}" Padding="10,3" Content="See a copy"
                                                Command="{Binding ExampleCommand}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding File, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                                                <Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource McMuted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Repos}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Agent board: every Claude CLI and autopilot agent as a card, its running subagents inside it. Waiting-on-you
                 first. State is a word and a glyph as well as a colour (WCAG 1.4.1). -->
            <ScrollViewer x:Name="AgentsBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsAgentsView, Converter={StaticResource Visible}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <TextBlock Text="Agents" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding AgentsSummary}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Left" Margin="0,30,0,0"
                                Visibility="{Binding HasAgents, Converter={x:Static vm:Converters.FalseToVisible}}">
                        <TextBlock Text="No agent is running right now." FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Open a Claude CLI in a repo, or type /autopilot in one, and it shows up here with its subagents inside it."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ItemsControl x:Name="AgentCards" ItemsSource="{Binding Agents}" Focusable="False" AutomationProperties.Name="Agents">
                        <ItemsControl.ItemsPanel>
                            <!-- Equal columns and gaps that fill the width, flush with the tiles' edges (M.ORCH-T192). -->
                            <ItemsPanelTemplate><local:AlignedGrid MinItemWidth="420" Gap="12" RowGap="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AgentRowViewModel}">
                                <Border Background="{StaticResource McSurface}" BorderBrush="{StaticResource McControlBorder}" BorderThickness="1"
                                        CornerRadius="6">
                                    <DockPanel>
                                        <!-- The state's colour down the left edge: a cue, never the only one. -->
                                        <Border DockPanel.Dock="Left" Width="5" Background="{Binding StateBrush}" CornerRadius="5,0,0,5" />
                                        <StackPanel Margin="14,12,14,12">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" BorderBrush="{Binding StateBrush}" BorderThickness="1" CornerRadius="10"
                                                        Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StateGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                   Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                           ToolTip="How long it's been on this" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Repo}" Style="{StaticResource Heading}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <!-- The ticket opens its history; with no ticket, the line is plain text, not a dead button. -->
                                            <Button Command="{Binding DataContext.ShowTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource McTextButton}" Padding="4,2" MinHeight="24" Margin="-4,6,0,0"
                                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                    Visibility="{Binding HasTicket, Converter={StaticResource Visible}}"
                                                    ToolTip="Open its full row and history" AutomationProperties.Name="{Binding Headline, StringFormat='Ticket {0}: open its history'}">
                                                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <TextBlock Text="{Binding Headline}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasTicket, Converter={x:Static vm:Converters.FalseToVisible}}" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Doing}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Doing, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding HoldNote}" Foreground="{x:Static vm:Palette.Waiting}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HoldNote, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                                            <!-- Its subagents, inside it. -->
                                            <Border Background="{StaticResource McChrome}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0"
                                                    Visibility="{Binding HasSubagents, Converter={StaticResource Visible}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SubagentsHeader}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Subagents}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:SubagentRowViewModel}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Border BorderBrush="{StaticResource McControlBorder}" BorderThickness="1" CornerRadius="3"
                                                                            Padding="5,0" Margin="0,1,8,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding Type}" FontSize="11" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Task}" TextWrapping="Wrap" MaxHeight="36"
                                                                               TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Task}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Doing}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Settings flyout -->
        <Border Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Right" Width="400" Background="#FF23252B"
                BorderBrush="{StaticResource McChromeBorder}" BorderThickness="1,1,0,0"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource Visible}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,20" DataContext="{Binding Settings}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource McToolButton}" Content="&#xE711;" ToolTip="Close"
                                Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Close settings" />
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                    </DockPanel>

                    <TextBlock Text="TOKEN BUDGET" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Uncached tokens (input + cache writes + output). Accepts 20M, 500k, 1.5B. Leave blank to use the limits learned from the times you actually hit the wall."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Per 5-hour block" Margin="0,4,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Text="{Binding BlockBudget, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Budget per 5-hour block" />
                    <TextBlock Text="Per week" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Text="{Binding WeeklyBudget, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Weekly budget" />
                    <TextBlock Text="Week resets (local time)" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Width="160" HorizontalAlignment="Left"
                             Text="{Binding WeeklyReset, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly reset day and time" />
                    <TextBlock Text="When Claude's weekly limit restarts, e.g. Mon 9:00 AM or Tue 5pm. Blank uses the reset your last weekly limit hit reported, or a rolling 7 days before you've had one."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="Warn at (%)" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                             Text="{Binding WarnPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Warn percent" />
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding Pacing}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                  Content="Pace to the reset" />
                    <TextBlock Text="Caps new sessions so spend lands on the target as the 5-hour window resets, instead of hitting the wall and waiting. The week is shown, never paced. Off: new work holds at the warn line."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="Pace target (% of the 5-hour limit by its reset)" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                             Text="{Binding PaceTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pace target percent" />
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding ThrottleAgents}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                  Content="Hold running agents" />
                    <TextBlock Text="While the draw won't last until the reset, every Claude agent (subagents too) waits before each tool call, and is let go the moment it fits."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="Longest hold per tool call (seconds)" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                             Text="{Binding MaxDelay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Longest hold in seconds" />
                    <TextBlock Text="Exempt from pacing" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Text="{Binding ExemptCommands, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Commands exempt from pacing" />
                    <TextBlock Text="Slash commands, comma-separated. A turn typed as one of them (and a Skill call naming one) skips every pace gate: no hold, no subagent wait, no stop. Its spend still counts. Blank exempts none."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="SCHEDULER" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Max concurrent sessions (working + waiting)" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource McTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                             Text="{Binding MaxSessions, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Max concurrent sessions" />
                    <TextBlock Text="Provider for dispatched tickets" Margin="0,10,0,4" />
                    <ListBox Style="{StaticResource PillChoice}" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                             AutomationProperties.Name="Dispatch provider" />
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding Autopilot}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                  Content="Autopilot" />
                    <TextBlock Text="Type /autopilot in a CLI and that CLI works its repo's tickets (or -repo=a,b, or all) through its own subagents, each in its own worktree, as many at once as the pace allows; no other CLI is affected. Off here pauses it in every CLI; /autopilot off ends it in that one."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource McRec}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"
                               Visibility="{Binding Error, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource McPrimaryButton}" Content="Save" Padding="20,6"
                                Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" BorderBrush="{StaticResource McChromeBorder}" BorderThickness="0,1,0,0" Padding="24,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"
                           Text="F5 refresh · Ctrl+F search · Ctrl +/− zoom · Esc close" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" Margin="0,0,16,0">
                    <Run Text="{Binding RepoCount, Mode=OneWay}" /><Run Text=" repos under " /><Run Text="{Binding WorkspaceRoot, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="Announcer" DockPanel.Dock="Left" Width="0" Height="0" Opacity="0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Foreground="{StaticResource McRec}" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}">
                    <TextBlock.ToolTip>
                        <ItemsControl ItemsSource="{Binding Warnings}" />
                    </TextBlock.ToolTip>
                    <Run Text="{Binding Warnings.Count, Mode=OneWay}" /><Run Text=" ticket file problem(s), hover for details" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Covers every row until the first refresh lands (M.ORCH-T184). -->
        <Border x:Name="Loader" Grid.RowSpan="5" Panel.ZIndex="100" Background="{StaticResource McChrome}"
                Visibility="{Binding IsLoading, Converter={StaticResource Visible}}"
                AutomationProperties.Name="Loading the dashboard" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Turns on its own thread, so it keeps turning while this window's thread applies the first
                     snapshot and lays the dashboard out (M.ORCH-T200). -->
                <local:ThreadedSpinner x:Name="LoaderSpinner" Width="44" Height="44" StrokeThickness="4" Stroke="{StaticResource McAccent}"
                                       HorizontalAlignment="Center" />
                <TextBlock Margin="0,16,0,0" FontSize="15" HorizontalAlignment="Center" Text="Loading the workspace…" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Text="Reading every repo's sessions, tickets and usage" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
