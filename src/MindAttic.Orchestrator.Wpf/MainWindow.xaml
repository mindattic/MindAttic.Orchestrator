<Window x:Class="MindAttic.Orchestrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
        xmlns:local="clr-namespace:MindAttic.Orchestrator.Wpf"
        mc:MaWindow.DarkTitleBar="True"
        Title="MindAttic Orchestrator" Width="1480" Height="920" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/logo.ico"
        Background="{DynamicResource MaChrome}" Foreground="{DynamicResource MaText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static vm:WindowCommands.FocusSearch}" />
        <KeyBinding Key="Escape" Command="{x:Static vm:WindowCommands.Escape}" />
        <!-- The next and the previous login's tab (M.ORCH-T613). -->
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <!-- Ctrl+Plus / Ctrl+Minus / Ctrl+0 (main row and number pad) are the library's ZoomLevel's, added in MainWindow.xaml.cs. -->
    </Window.InputBindings>

    <Window.Resources>
        <!-- One repo tile. -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:RepoTileViewModel}">
            <Button Style="{StaticResource RepoTile}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Headline}"
                    AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Accent}" CornerRadius="3,0,0,3" />
                    <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TokensText}" Style="{StaticResource MaTileSubtitle}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Tokens today" />
                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Accent}"
                                     VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource MaTileSubtitle}"
                                   Margin="16,4,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A ticket id: a link that opens the ticket in Tickets Desktop to view, approve, prioritize or close it (M.ORCH-T500).
             Its CommandParameter is the id. The library's MaHyperlink (MaLink, SemiBold, underlined on hover and keyboard focus,
             so it reads as a link without colour), plus the command and tooltip. -->
        <Style x:Key="TicketLink" TargetType="Hyperlink" BasedOn="{StaticResource MaHyperlink}">
            <Setter Property="Command" Value="{Binding DataContext.OpenInTicketsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ToolTip" Value="Open it in Tickets Desktop to view, approve, prioritize or close it" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AccountMenuHeading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaMutedText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,4" />
        </Style>

        <!-- The account menu's row text (M.ORCH-T568): the signed-in row's whole line turns green instead of a separate
             green "Signed in" line underneath it. -->
        <Style x:Key="AccountRowText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MaGood}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountRowMutedText" TargetType="TextBlock" BasedOn="{StaticResource MaMutedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MaGood}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A body view (repos, queue, audit, agents): the same 24px gutters as the header and toolbar. While the vertical
             scroll bar shows, it sits inside the right gutter instead of pushing the content in (M.ORCH-T192). Based on the
             theme's implicit ScrollViewer, so it keeps the dark corner and scroll bars. -->
        <Style x:Key="BodyScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="24,0,24,16" />
            <Style.Triggers>
                <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                    <Setter Property="Padding" Value="{x:Static local:Gutters.BesideScrollBar}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One dashboard tab per Claude login (M.ORCH-T613): the global ~/.claude login first, then each per-CLI login under
             ~/.claude-accounts, by its name (M.ORCH-T614, its email in the tooltip) and its terminal tabs' color (M.ORCH-T616),
             with how many of its repos need you. Everything below is the chosen login's: the window shows that tab's view model
             (MainWindow.xaml.cs sets its DataContext), and this strip keeps the global login's tab's, which holds every tab.
             Shown once there's a second login; Ctrl+Tab and Ctrl+Shift+Tab step through them. Its own row above the header,
             so the header, chart and view pills can fold away on a tab while the strip stays. -->
        <ListBox x:Name="LoginTabStrip" Grid.Row="0" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding LoginTabs}" SelectedItem="{Binding SelectedTab}"
                 Padding="0" Margin="24,14,24,0" AutomationProperties.Name="Claude logins, one dashboard tab each"
                 Visibility="{Binding HasLoginTabs, Converter={StaticResource Visible}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding TabTip}" AutomationProperties.Name="{Binding TabTip}">
                        <Ellipse Width="10" Height="10" Fill="{Binding TabBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding TabBadge, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <Run Text="&#x2022; " /><Run Text="{Binding TabBadge, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" need you" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Each person's two tabs (M.ORCH-T622): their Dashboard (the tiles, the chart, the view pills and the chosen view) and
             their Terminals (one terminal tab per CLI of theirs open in a pane here). On Terminals the header, the chart and the
             view pills fold away, so the panes fill the window below the person tabs. -->
        <ListBox x:Name="PageTabStrip" Grid.Row="1" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}"
                 Padding="0" Margin="24,10,24,0" AutomationProperties.Name="{Binding TabTitle, StringFormat='{}{0}: dashboard or terminals'}"
                 AutomationProperties.HelpText="{Binding Terminals.Summary}" ToolTip="{Binding Terminals.Summary}"
                 Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}" />

        <!-- Header, read left to right: the work (who needs you, who's working, their subagents, what's queued), then the
             tokens (this 5-hour window, the week, the pace ledger, today). Every card is a button that goes somewhere. -->
        <!-- The header owns the window's left/right gutter; nothing inside it adds its own, so the tiles and the chart
             share both edges (M.ORCH-T192). The tiles are equal cells that together span the row at any width. -->
        <StackPanel x:Name="Header" Grid.Row="2" Margin="24,18,24,0" Visibility="{Binding ShowsDashboard, Converter={StaticResource Visible}}">
        <!-- The account menu, upper right (M.ORCH-T492), as a normal app has it: the signed-in account's email ("API key" while
             the Vault's key bills, M.ORCH-T436), which opens a table of every account in the roster (seat, week used and
             left, its reset, the 5-hour window, when it was read; the signed-in one marked, the most headroom starred).
             Hovering a row highlights it; clicking one opens its login in the browser. The last row bills the API key, for
             emergencies (M.ORCH-T566). The tooltip says who every CLI bills; the line beside it what the last switch did and
             which open CLIs still bill the other thing. -->
        <!-- Upper left (M.ORCH-T493): the clock, when the dashboard last refreshed, Refresh (F5) and Settings, so the upper
             right holds only the account menu. -->
        <DockPanel x:Name="AccountRow" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel x:Name="HeaderControls" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Clock.Text}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.Name="Current time" ToolTip="Current time" />
                <TextBlock Text="{Binding RefreshInfo}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource MaButton}" Command="{Binding RefreshCommand}" Content="Refresh" ToolTip="F5" />
                <Button Style="{StaticResource MaButton}" Command="{Binding ToggleSettingsCommand}" Content="Settings" Margin="8,0,0,0" />
                <!-- Open Launcher (M.ORCH-T615): the Launcher's menu as this tab's login (MindAttic.Launcher with its account), so
                     every repo CLI started from it runs on that login and shows in this tab; on the global login's tab, unscoped. -->
                <Button Style="{StaticResource MaButton}" Command="{Binding OpenLauncherCommand}" Content="Open Launcher" Margin="8,0,0,0"
                        ToolTip="{Binding TabTitle}" ToolTipService.ShowOnDisabled="False"
                        AutomationProperties.Name="{Binding TabTitle, StringFormat='Open the Launcher as {0}'}" />
            </StackPanel>
            <Button x:Name="AccountMenuButton" DockPanel.Dock="Right" Style="{StaticResource MaButton}" VerticalAlignment="Center"
                    Margin="12,0,0,0" Padding="12,4" AutomationProperties.Name="{Binding AccountCorner, StringFormat='Account: {0}. Opens the account menu'}"
                    AutomationProperties.HelpText="{Binding BillingClis}">
                <Button.ToolTip>
                    <TextBlock>
                        <Run Text="{Binding BillingHeadline, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                        <Run Text="{Binding BillingClis, Mode=OneWay}" />
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{Binding BillingBrush}" />
                    <TextBlock Text="{Binding AccountCorner}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding BillingBrush}" />
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding BillingDetail}" Style="{StaticResource MaTileSubtitle}" TextWrapping="Wrap" VerticalAlignment="Center"
                       TextAlignment="Right" Margin="12,0,0,0"
                       Visibility="{Binding BillingDetail, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
        </DockPanel>

        <!-- The account menu's popup (M.ORCH-T566): a table, not a text menu, so picking an account is "hover the row, click
             it" rather than reading a long joined sentence. StaysOpen="False" gives it the usual light-dismiss (an outside
             click or losing focus closes it) for free; the trigger button's own toggle is wired in code-behind, since a plain
             Click there would immediately reopen what the outside click just closed. -->
        <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountMenuButton}" Placement="Custom"
               AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Fade">
            <Border Style="{StaticResource MaCard}" Padding="4,8" Margin="0">
                <StackPanel>
                    <!-- 8px sides: the rows' button Padding, so each heading starts where its cells do. -->
                    <Grid Margin="8,0,8,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Account" Style="{StaticResource AccountMenuHeading}" />
                        <TextBlock Grid.Column="2" Text="5h used" Style="{StaticResource AccountMenuHeading}" />
                        <TextBlock Grid.Column="3" Text="5h resets" Style="{StaticResource AccountMenuHeading}" />
                        <TextBlock Grid.Column="4" Text="Week usage" Style="{StaticResource AccountMenuHeading}" />
                        <TextBlock Grid.Column="5" Text="Week resets" Style="{StaticResource AccountMenuHeading}" />
                        <TextBlock Grid.Column="6" Text="Last Checked" Style="{StaticResource AccountMenuHeading}" />
                    </Grid>
                    <ItemsControl x:Name="AccountRows" ItemsSource="{Binding AccountMenuItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountMenuItem}">
                                <Button CommandParameter="{Binding Id}" ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Label}">
                                    <Button.Style>
                                        <!-- MaToolButton (M.ORCH-T499): transparent at rest, MaHover on mouse-over or keyboard
                                             focus, so hovering or tabbing to a row is the only cue needed before clicking it
                                             (or pressing Enter/Space) picks that account. -->
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaToolButton}">
                                            <Setter Property="Width" Value="Auto" />
                                            <Setter Property="Height" Value="Auto" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="8,6" />
                                            <Style.Triggers>
                                                <!-- Sets it apart from the accounts above it; MaToolButton's own template draws no
                                                     border for Margin to play against, so a gap is all a trigger here can add. -->
                                                <DataTrigger Binding="{Binding IsApiKey}" Value="True">
                                                    <Setter Property="Margin" Value="0,6,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <!-- MaToolButton (the row's Style) sets FontFamily to the icon font, which inherits down to
                                         every cell unless reset here: only the Icon TextBlock below wants that font. -->
                                    <Grid TextElement.FontFamily="Segoe UI">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Empty space, not a person icon, for every row but the signed-in one: the checkmark is
                                             the only icon the roster shows, so this column just reserves its width (M.ORCH-T568). -->
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                                                   Style="{StaticResource AccountRowText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Account}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Style="{StaticResource AccountRowText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding FiveHourUsed}" Style="{StaticResource AccountRowText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding FiveHourResets}" Style="{StaticResource AccountRowMutedText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding WeekUsage}" Style="{StaticResource AccountRowText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding WeekResets}" Style="{StaticResource AccountRowMutedText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{Binding LastRead}" Style="{StaticResource AccountRowMutedText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <local:AlignedGrid x:Name="StatTiles" MinItemWidth="160" Gap="10" RowGap="10" Balanced="True" UniformRows="True"
                           AutomationProperties.Name="Summary">
            <Button Command="{Binding FocusCommand}" CommandParameter="Waiting" ToolTip="Repos whose agent stopped and is waiting for you. Shows only those."
                    AutomationProperties.Name="{Binding WaitingCount, StringFormat='{}{0} need you: show only those repos'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaSmallStat}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Focus}" Value="Waiting">
                                <Setter Property="BorderBrush" Value="{DynamicResource MaWarn}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding WaitingCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource MaWarn}" />
                    <TextBlock Text="Need you" Style="{StaticResource MaTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding FocusCommand}" CommandParameter="Working" ToolTip="Repos with an agent mid-turn right now. Shows only those."
                    AutomationProperties.Name="{Binding WorkingCount, StringFormat='{}{0} working: show only those repos'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaSmallStat}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Focus}" Value="Working">
                                <Setter Property="BorderBrush" Value="{DynamicResource MaGood}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding WorkingCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource MaGood}" />
                    <TextBlock Text="Working" Style="{StaticResource MaTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaSmallStat}" Command="{Binding ShowViewCommand}" CommandParameter="Agents"
                    ToolTip="Subagents running inside every CLI and autopilot agent. Opens the agent board."
                    AutomationProperties.Name="{Binding SubagentCount, StringFormat='{}{0} subagents running: open the agent board'}">
                <StackPanel>
                    <TextBlock Text="{Binding SubagentCount}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="Subagents" Style="{StaticResource MaTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding FocusCommand}" CommandParameter="Tickets" ToolTip="Repos with open tickets and no session. Shows only those."
                    AutomationProperties.Name="{Binding TicketCount, StringFormat='{}{0} open tickets: show repos with tickets and no session'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaSmallStat}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Focus}" Value="Tickets">
                                <Setter Property="BorderBrush" Value="{DynamicResource MaLink}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding TicketCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource MaLink}" />
                    <TextBlock Text="Open tickets" Style="{StaticResource MaTileSubtitle}" />
                </StackPanel>
            </Button>

            <!-- Budget: the current 5-hour block. Click to set limits. -->
            <Button Style="{StaticResource MaSmallStat}" HorizontalContentAlignment="Stretch" Command="{Binding ToggleSettingsCommand}"
                    ToolTip="{Binding BudgetTooltip}"
                    AutomationProperties.Name="{Binding BudgetHeadline, StringFormat='5-hour window {0} used: open budget settings'}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding BudgetHeadline}" Style="{StaticResource StatValue}"
                                   Foreground="{Binding BudgetBrush}" />
                        <TextBlock Text="{Binding BudgetCaption}" Style="{StaticResource MaTileSubtitle}" VerticalAlignment="Center"
                                   Margin="8,4,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <ProgressBar x:Name="BudgetBar" Style="{StaticResource MaProgressBar}" Margin="0,4,0,4" Maximum="1"
                                 Value="{Binding BudgetFill, Mode=OneWay}" Foreground="{Binding BudgetBrush}" Focusable="False"
                                 AutomationProperties.Name="5-hour window used" />
                    <!-- While pacing holds work back, that's the line that matters; the full detail stays in the tooltip. -->
                    <TextBlock Text="{Binding BudgetDetail}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding PaceText, Converter={x:Static vm:Converters.EmptyToVisible}}" />
                    <TextBlock Text="{Binding PaceText}" Style="{StaticResource MaTileSubtitle}" Foreground="{Binding PaceBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding PaceText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                </StackPanel>
            </Button>
            <!-- Weekly: the other half of /status's picture; the 5-hour card never shows it on its own. -->
            <Button Style="{StaticResource MaSmallStat}" Command="{Binding ToggleSettingsCommand}"
                    ToolTip="How much of Claude's weekly limit is left (/status reports the used share). Opens settings, where the weekly reset is set."
                    AutomationProperties.Name="{Binding WeeklyHeadline, StringFormat='Week {0}: open settings'}">
                <StackPanel>
                    <TextBlock Text="{Binding WeeklyHeadline}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding WeeklyCaption}" Style="{StaticResource MaTileSubtitle}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaSmallStat}" Command="{Binding ShowViewCommand}" CommandParameter="Repos"
                    ToolTip="Claude Code tokens since midnight, every session (cache reads included). Opens the repos, busiest first."
                    AutomationProperties.Name="{Binding TokensToday, StringFormat='{}{0} tokens today: open the repos'}">
                <StackPanel>
                    <TextBlock Text="{Binding TokensToday}" Style="{StaticResource StatValue}" />
                    <TextBlock Text="{Binding TokensDetail}" Style="{StaticResource MaTileSubtitle}" />
                </StackPanel>
            </Button>
        </local:AlignedGrid>
        <!-- This 5-hour window's utilization (M.ORCH-T191): its own full-width row under the tiles, tall enough that the
             pace line straight to the target at the reset, the window's own line (red while over that pace, green under)
             and where the recent rate ends up are easy to read. The caption says it in words. -->
        <Border x:Name="UtilizationCard" Style="{StaticResource MaCard}" Margin="0,12,0,12" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding UtilizationText, StringFormat='5-hour utilization: {0}'}"
                Visibility="{Binding UtilizationText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
            <StackPanel>
                <TextBlock Text="5-hour utilization" Style="{StaticResource MaSectionLabel}" />
                <mc:MaLineChart x:Name="UtilizationChart" Data="{Binding Utilization, Converter={x:Static local:UtilizationChartData.Converter}}"
                                Height="260" Margin="0,8,0,8" />
                <TextBlock Text="{Binding UtilizationText}" Style="{StaticResource MaTileSubtitle}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="3" Margin="24,8,24,10" Visibility="{Binding ShowsDashboard, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding ViewChoices}" Padding="0"
                         SelectedItem="{Binding ViewChoice}" VerticalAlignment="Center" Margin="0,6,14,0"
                         AutomationProperties.Name="View" />
                <TextBox x:Name="SearchBox" Style="{StaticResource MaTextBox}" Width="300" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         mc:MaTextBox.Placeholder="Search repos and tickets   Ctrl+F"
                         AutomationProperties.Name="Search repos and tickets"
                         Visibility="{Binding IsReposView, Converter={StaticResource Visible}}" />
                <ToggleButton Style="{StaticResource MaPillToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding ShowQuiet}" Content="Show quiet repos"
                              Visibility="{Binding IsReposView, Converter={StaticResource Visible}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                            Visibility="{Binding IsReposView, Converter={StaticResource Visible}}">
                    <TextBlock Text="Sort by" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding RepoSorts}" Padding="0"
                             SelectedItem="{Binding RepoSort}" VerticalAlignment="Center" Margin="0,6,0,0"
                             AutomationProperties.Name="Sort repos by" />
                </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Zoom.Text}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="0,0,12,0"
                           ToolTip="Ctrl+0 resets the zoom" />
            </StackPanel>
        </Grid>

        <!-- Toasts: what just happened (a session finished its turn, the pace changed). Their own row, so they push the page
             down instead of covering whatever has keyboard focus (WCAG 2.4.11). The library's MaToastHost: each ToastViewModel's
             Title, Body and Accent on an MaToast, clicking it opens what it's about, its x dismisses it, and each new one is read
             out politely. -->
        <mc:MaToastHost x:Name="ToastRow" Grid.Row="4" ItemsSource="{Binding Toasts}" Margin="24,0,24,6"
                        OpenCommand="{Binding OpenToastCommand}" DismissCommand="{Binding DismissToastCommand}"
                        AutomationProperties.Name="Notifications" />

        <!-- A roster account not signed in on this machine yet (M.ORCH-T615): its tab shows only its Sign in, then, once signed
             in, the whole dashboard and Open Launcher at the next refresh. -->
        <StackPanel Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24"
                    Visibility="{Binding IsTabSignedIn, Converter={x:Static vm:Converters.FalseToVisible}}">
            <TextBlock Text="{Binding SignInPrompt}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14" />
            <Button Style="{StaticResource MaPrimaryButton}" Command="{Binding SignInTabCommand}" Content="Sign in" Padding="18,6"
                    HorizontalAlignment="Center" AutomationProperties.Name="{Binding TabTitle, StringFormat='Sign {0} in'}" />
            <TextBlock Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                       Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Body: grouped tiles, and the selected repo's detail pane; or, on the Terminals tab, only the person's terminals. -->
        <Grid Grid.Row="5" Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="ReposBody" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsReposView, Converter={StaticResource Visible}}">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileGroupViewModel}">
                                <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Visible}}" Margin="0,4,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource MaHeading}" FontSize="14" />
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource MaMutedText}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource MaMutedText}" Margin="14,0,0,0" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:AlignedGrid MinItemWidth="240" Gap="10" RowGap="10" UniformRows="True" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"
                                Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                        <TextBlock Text="Nothing needs you right now." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="No agent is working or waiting and no tickets match. Clear the search or show quiet repos."
                                   Style="{StaticResource MaMutedText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Detail pane: the window's own MaChrome, set off by its left border, so its MaCards stand out from it. -->
            <Border x:Name="DetailPane" Grid.Column="1" Width="420" Background="{DynamicResource MaChrome}" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowDetail, Converter={StaticResource Visible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,20" DataContext="{Binding}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#xE711;"
                                    Command="{Binding SelectCommand}" CommandParameter="{Binding Selected}"
                                    ToolTip="Close (Esc)" AutomationProperties.Name="Close details" />
                            <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        </DockPanel>
                        <Button Style="{StaticResource MaTextButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="8,3" MinHeight="24"
                                Command="{Binding OpenFolderCommand}" ToolTip="Open in Explorer"
                                AutomationProperties.Name="{Binding Selected.Path, StringFormat='Open {0} in Explorer'}"
                                Visibility="{Binding Selected.HasFolder, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding Selected.Path}" FontSize="11" Foreground="{DynamicResource MaMuted}" TextTrimming="CharacterEllipsis" />
                        </Button>

                        <Border Style="{StaticResource MaCard}" Margin="0,14,0,0" BorderBrush="{Binding Selected.Accent}">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.StateLabel}" Foreground="{Binding Selected.Accent}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Selected.Headline}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Start a session -->
                        <TextBlock Text="START A SESSION" Style="{StaticResource MaSectionLabel}" />
                        <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                                 AutomationProperties.Name="Agent provider" />
                        <!-- The Claude login it opens on (M.ORCH-T613): a login's own dashboard tab starts on that login and
                             shows no choice; the global login's tab starts on the global login, or on Auto (M.ORCH-T605). -->
                        <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Logins}" SelectedItem="{Binding Login}" Margin="0,4,0,0"
                                 Visibility="{Binding ShowLogins, Converter={StaticResource Visible}}"
                                 AutomationProperties.Name="Claude login" />
                        <TextBox Style="{StaticResource MaTextArea}" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 Height="64" Margin="0,4,0,0" mc:MaTextBox.Placeholder="Opening prompt (optional), or pick a ticket below"
                                 AutomationProperties.Name="Opening prompt (optional)" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Command="{Binding StartCommand}">
                                <TextBlock>
                                    <Run Text="Start " /><Run Text="{Binding Provider, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                            <TextBlock Text="Opens a Launcher tab rooted here. The prompt is pre-filled, not sent."
                                       Style="{StaticResource MaMutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MaFocus}" />

                        <!-- Live tabs -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Hosts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="LAUNCHER TABS" Style="{StaticResource MaSectionLabel}" />
                            <ItemsControl ItemsSource="{Binding Selected.Hosts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HostRowViewModel}">
                                        <Border Style="{StaticResource MaCard}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <!-- Brings this tab's own Windows Terminal window up, on this tab (M.ORCH-T619). -->
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Go to tab" Margin="10,0,0,0" Padding="12,5"
                                                            Command="{Binding DataContext.GoToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="Bring this tab's terminal to the front, on this tab"
                                                            AutomationProperties.Name="{Binding Detail, StringFormat='Go to the tab, {0}'}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" ToolTip="{Binding DetailTip}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Send" Margin="6,0,0,0"
                                                            Padding="12,5" Command="{Binding SendCommand}" IsDefault="False" />
                                                    <TextBox Style="{StaticResource MaTextBox}" Height="30"
                                                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                                             mc:MaTextBox.Placeholder="Reply to this tab…"
                                                             AutomationProperties.Name="Text to type into this tab" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Feedback}" Style="{StaticResource MaMutedText}" Margin="0,4,0,0">
                                                    <TextBlock.Visibility>
                                                        <Binding Path="Feedback" Converter="{x:Static vm:Converters.EmptyToCollapsed}" />
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Open tickets -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Tickets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource MaSectionLabel}">
                                <Run Text="OPEN TICKETS · " /><Run Text="{Binding Selected.Tickets.Count, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Selected.Tickets}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TicketRowViewModel}">
                                        <Border Style="{StaticResource MaCard}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaTextButton}" Padding="10,3" MinHeight="24"
                                                            Content="Use as prompt" AutomationProperties.Name="{Binding Id, StringFormat='Use {0} as the prompt'}"
                                                            Command="{Binding DataContext.UseTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                                                   AutomationProperties.Name="{Binding Id, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Id, Mode=OneWay}" /></Hyperlink>
                                                        <Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                                        <Run Text="  " /><Run Text="{Binding Date, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Tokens -->
                        <StackPanel Visibility="{Binding Selected.HasUsage, Converter={StaticResource Visible}}">
                            <TextBlock Text="TOKENS TODAY" Style="{StaticResource MaSectionLabel}" />
                            <Border Style="{StaticResource MaCard}">
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageOutput}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="output" Style="{StaticResource MaMutedText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageInput}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="input" Style="{StaticResource MaMutedText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageCacheWrite}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="cache write" Style="{StaticResource MaMutedText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Selected.UsageCacheRead}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="cache read" Style="{StaticResource MaMutedText}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- Recent sessions -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.Sessions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="RECENT CLAUDE SESSIONS" Style="{StaticResource MaSectionLabel}" />
                            <ItemsControl ItemsSource="{Binding Selected.Sessions}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionRowViewModel}">
                                        <Grid Margin="0,0,0,6" ToolTip="{Binding SessionId}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ShortId}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Grid.Column="1" Text="{Binding Model}" Style="{StaticResource MaMutedText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding LastWrite}" Style="{StaticResource MaMutedText}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Tokens}" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Queue view: every open ticket across the workspace, and what the scheduler proposes. -->
            <ScrollViewer x:Name="QueueBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsQueueView, Converter={StaticResource Visible}}">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Left">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SlotsText}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AutopilotText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" />
                    </DockPanel>

                    <Border Style="{StaticResource MaCard}" Margin="0,12,0,0" BorderBrush="{DynamicResource MaWarn}"
                            Visibility="{Binding HasHold, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Hold}" Foreground="{DynamicResource MaWarn}" TextWrapping="Wrap" />
                    </Border>
                    <!-- Reminders the daemon texts through Psst when they're due (orchestrator remind, M.ORCH-T477). -->
                    <Border Style="{StaticResource MaCard}" Margin="0,12,0,0"
                            Visibility="{Binding HasReminders, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding RemindersTitle}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Reminders}" Focusable="False" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="orchestrator remind --cancel &lt;id&gt; drops one." Style="{StaticResource MaMutedText}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding QueueMessage}" Foreground="{DynamicResource MaFocus}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding QueueMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                    <!-- Finished work: closed tickets whose assignment or worktree is still around. -->
                    <ItemsControl ItemsSource="{Binding Finished}" Focusable="False" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FinishedViewModel}">
                                <Border Style="{StaticResource MaCard}" BorderBrush="{DynamicResource MaGood}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Padding="12,5"
                                                Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                                ToolTip="git keeps the worktree if it has uncommitted changes; the branch is never deleted" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Padding="12,5" Margin="0,0,8,0"
                                                Content="Details" Command="{Binding DetailsCommand}"
                                                ToolTip="The sessions that worked on it and the commits that mention it" />
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding TicketId}"
                                                       AutomationProperties.Name="{Binding TicketId, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding TicketId, Mode=OneWay}" /></Hyperlink><Run Text="{Binding TextAfterId, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Proposals -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proposals.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="NEXT UP" Style="{StaticResource MaSectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Proposals}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QueueRowViewModel}">
                                    <Border Style="{StaticResource MaCard}" Width="370" Margin="0,0,10,10" BorderBrush="{DynamicResource MaGood}">
                                        <StackPanel>
                                            <TextBlock>
                                                <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}" Foreground="{DynamicResource MaGood}"
                                                           AutomationProperties.Name="{Binding Id, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Id, Mode=OneWay}" /></Hyperlink>
                                                <Run Text="  " /><Run Text="{Binding Repo, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,10,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Start" Padding="16,5"
                                                        Command="{Binding StartCommand}" ToolTip="Opens a tab with the ticket pre-filled as its prompt; you press Enter" />
                                                <TextBlock Style="{StaticResource MaMutedText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <Run Text="{Binding Reason, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Where, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Full queue -->
                    <TextBlock Style="{StaticResource MaSectionLabel}">
                        <Run Text="QUEUE · " /><Run Text="{Binding QueueCount, Mode=OneWay}" /><Run Text=" waiting · reserved first, then priority, smallest estimate, fixes before features, oldest" />
                    </TextBlock>
                    <TextBlock Text="{Binding EmptyQueueText, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MaMutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Queue}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueRowViewModel}">
                                <Border Padding="10,8">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource MaCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MaToolButton}" Width="24" Height="24" FontSize="10" Content="&#xE70E;"
                                                    Command="{Binding UpCommand}" ToolTip="Raise priority" AutomationProperties.Name="Raise priority" />
                                            <Button Style="{StaticResource MaToolButton}" Width="24" Height="24" FontSize="10" Content="&#xE70D;"
                                                    Command="{Binding DownCommand}" ToolTip="Lower priority" AutomationProperties.Name="Lower priority" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                                       AutomationProperties.Name="{Binding Id, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Id, Mode=OneWay}" /></Hyperlink>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding Repo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                            <Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                            <Run Text="{Binding Priority, Mode=OneWay}" Foreground="{DynamicResource MaWarn}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="5" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Summary}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="6" Text="{Binding Status}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="7" Orientation="Horizontal">
                                            <Button Style="{StaticResource MaButton}" Padding="12,4" Content="Start" Command="{Binding StartCommand}"
                                                    Visibility="{Binding IsAssigned, Converter={x:Static vm:Converters.FalseToVisible}}" />
                                            <Button Style="{StaticResource MaButton}" Padding="12,4" Content="Release" Command="{Binding ReleaseCommand}"
                                                    ToolTip="Put it back in the queue (the session and any worktree are left alone)"
                                                    Visibility="{Binding IsAssigned, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Audit view: what's duplicated across repos and which shared agent files drifted. -->
            <ScrollViewer x:Name="AuditBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsAuditView, Converter={StaticResource Visible}}">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Left">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Run audit" Padding="16,6"
                                Command="{Binding RunAuditCommand}" />
                        <TextBlock Text="{Binding AuditInfo}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding DuplicatesHeader}" Style="{StaticResource MaSectionLabel}" />
                    <TextBlock Text="Code that lives in more than one repo. Identical copies are the easiest wins: move one into the suggested home and reference it."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Duplicates}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                <Border Style="{StaticResource MaCard}" Width="380" Margin="0,0,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource MaTextButton}" Padding="10,3" Content="Compare"
                                                    Command="{Binding CompareCommand}" ToolTip="Diff the first two copies (VS Code if installed)" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MaWarn}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Identical}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource MaGood}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                        <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AuditFileViewModel}">
                                                    <!-- MaTextButton with no fill (M.ORCH-T499), its content left-aligned (M.COMP-T36). -->
                                                    <Button Command="{Binding OpenCommand}" Style="{StaticResource MaTextButton}" Background="Transparent"
                                                            Padding="0,1" Margin="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                            ToolTip="Open" MinHeight="24">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="Open {0} {1}">
                                                                <Binding Path="Repo" />
                                                                <Binding Path="RelativePath" />
                                                            </MultiBinding>
                                                        </AutomationProperties.Name>
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Repo, Mode=OneWay}" Foreground="{DynamicResource MaText}" />
                                                            <Run Text="{Binding RelativePath, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding More}" Style="{StaticResource MaMutedText}" Margin="0,2,0,0" ToolTip="{Binding AllFiles}"
                                                   Visibility="{Binding More, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding DriftHeader}" Style="{StaticResource MaSectionLabel}" />
                    <TextBlock Text="For each agent file most repos share, the version most repos have is canonical. Drifted copies are stale edits of it; custom ones are different files under the same name."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Drift}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriftViewModel}">
                                <Border Style="{StaticResource MaCard}" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaWarn}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Repo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding File}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MaMutedText}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Similarity}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Style="{StaticResource MaButton}" Padding="12,4" Content="Compare"
                                                Command="{Binding CompareCommand}" ToolTip="Diff against the canonical version" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding MissingHeader}" Style="{StaticResource MaSectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Missing}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MissingViewModel}">
                                <Border Style="{StaticResource MaCard}" Padding="10,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaTextButton}" Padding="10,3" Content="See a copy"
                                                Command="{Binding ExampleCommand}" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding File, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                                                <Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Repos}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource MaMutedText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Agent board: every Claude CLI and autopilot agent as a card, its running subagents inside it. Waiting-on-you
                 first. State is a word and a glyph as well as a colour (WCAG 1.4.1). -->
            <ScrollViewer x:Name="AgentsBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsAgentsView, Converter={StaticResource Visible}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <TextBlock Text="Agents" Style="{StaticResource MaHeading}" />
                        <TextBlock Text="{Binding AgentsSummary}" Style="{StaticResource MaMutedText}" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Left" Margin="0,30,0,0"
                                Visibility="{Binding HasAgents, Converter={x:Static vm:Converters.FalseToVisible}}">
                        <TextBlock Text="No agent is running right now." FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Open a Claude CLI in a repo, or type /allocate in one, and it shows up here with its subagents inside it."
                                   Style="{StaticResource MaMutedText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ItemsControl x:Name="AgentCards" ItemsSource="{Binding Agents}" Focusable="False" AutomationProperties.Name="Agents">
                        <ItemsControl.ItemsPanel>
                            <!-- Equal columns and gaps that fill the width, flush with the tiles' edges (M.ORCH-T192). -->
                            <ItemsPanelTemplate><local:AlignedGrid MinItemWidth="420" Gap="12" RowGap="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AgentRowViewModel}">
                                <!-- The library's MaCard without its bottom margin (the AlignedGrid owns the gaps, M.ORCH-T192) and without
                                     its padding (the state stripe runs to the card's edge) (M.ORCH-T182). -->
                                <Border x:Name="AgentCard" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource MaCard}">
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                    <DockPanel IsEnabled="{Binding IsUnlocked}">
                                        <!-- The state's colour down the left edge: a cue, never the only one. -->
                                        <Border DockPanel.Dock="Left" Width="5" Background="{Binding StateBrush}" CornerRadius="5,0,0,5" />
                                        <StackPanel Margin="14,12,14,12">
                                            <DockPanel>
                                                <mc:MaBadge x:Name="StatePill" DockPanel.Dock="Left" Glyph="{Binding StateGlyph}" Content="{Binding StateLabel}"
                                                            Foreground="{Binding StateBrush}" Margin="0,0,10,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center"
                                                           ToolTip="How long it's been on this" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Repo}" Style="{StaticResource MaHeading}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <!-- The Claude login this CLI bills (M.ORCH-T606), so one on the wrong account shows. -->
                                            <TextBlock Text="{Binding Login}" Style="{StaticResource MaMutedText}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LoginTip}" Visibility="{Binding Login, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                            <!-- The ticket opens its history; with no ticket, the line is plain text, not a dead button. -->
                                            <Button Command="{Binding DataContext.ShowTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource MaTextButton}" Padding="4,2" MinHeight="24" Margin="-4,6,0,0"
                                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                                    Visibility="{Binding HasTicket, Converter={StaticResource Visible}}"
                                                    ToolTip="Open its full row and history" AutomationProperties.Name="{Binding Headline, StringFormat='Ticket {0}: open its history'}">
                                                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <TextBlock Text="{Binding Headline}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasTicket, Converter={x:Static vm:Converters.FalseToVisible}}" />
                                            <DockPanel Margin="0,4,0,0">
                                                <!-- The headline opens its history here; this opens the ticket itself in Tickets Desktop (M.ORCH-T500). -->
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="12"
                                                           Visibility="{Binding HasTicket, Converter={StaticResource Visible}}">
                                                    <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding TicketId}"
                                                               AutomationProperties.Name="{Binding TicketId, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="Open in Tickets" /></Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource MaMutedText}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Doing}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Doing, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                            <!-- To this CLI's own terminal tab (M.ORCH-T619), and Move to another signed-in login (M.ORCH-T607);
                                                 only a CLI in a Launcher tab has either. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasHost, Converter={StaticResource Visible}}">
                                                <Button Command="{Binding DataContext.GoToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource MaButton}" Content="Go to tab" Padding="12,5"
                                                        ToolTip="Bring this CLI's terminal to the front, on its tab"
                                                        AutomationProperties.Name="{Binding Repo, StringFormat='Go to the {0} tab'}" />
                                                <Button x:Name="AgentMoveToButton" Click="OnMoveToClick" Style="{StaticResource MaButton}" Content="Move to ▾" Padding="12,5" Margin="8,0,0,0"
                                                        ToolTip="Move this CLI to another signed-in login: its Launcher tab restarts it with claude --resume on that login at its next idle point, keeping its session"
                                                        AutomationProperties.Name="{Binding Repo, StringFormat='Move the {0} CLI to another login'}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding HoldNote}" Foreground="{DynamicResource MaWarn}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HoldNote, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                            <!-- The tickets this CLI claimed, only its own (M.ORCH-T532). -->
                                            <TextBlock Text="{Binding Claims}" Style="{StaticResource MaMutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Claims, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                                            <!-- Its subagents, inside it. -->
                                            <Border x:Name="SubagentPanel" Style="{StaticResource MaCard}" Background="{DynamicResource MaChrome}" Padding="10,8" Margin="0,10,0,0"
                                                    Visibility="{Binding HasSubagents, Converter={StaticResource Visible}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SubagentsHeader}" Style="{StaticResource MaSectionLabel}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Subagents}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:SubagentRowViewModel}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <mc:MaBadge x:Name="SubagentTag" Style="{StaticResource MaTag}" Content="{Binding Type}" Margin="0,1,8,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Task}" TextWrapping="Wrap" MaxHeight="36"
                                                                               TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Task}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource MaMutedText}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Doing}" Style="{StaticResource MaMutedText}" Margin="0,2,0,0" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- A move in flight (M.ORCH-T638): the card is locked under a translucent veil until its CLI lands on the new login. -->
                                    <Grid x:Name="AgentMovingOverlay" Visibility="{Binding IsMoving, Converter={StaticResource Visible}}">
                                        <Border Background="{DynamicResource MaChrome}" Opacity="0.82" CornerRadius="5" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <mc:MaSpinner Width="20" Height="20" StrokeThickness="2" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding MovingText}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Accounts view (M.ORCH-T603): one card per Claude login (the global ~/.claude one, then each per-CLI login under
                 ~/.claude-accounts), with who's signed in, its plan, its 5-hour and weekly use, the daemon's pace for it and every
                 live CLI on it. Signed in or not is a word and a glyph as well as a colour (WCAG 1.4.1). -->
            <ScrollViewer x:Name="AccountsBody" Grid.ColumnSpan="2" Style="{StaticResource BodyScroll}"
                          Visibility="{Binding IsAccountsView, Converter={StaticResource Visible}}">
                <StackPanel>
                    <!-- The view's toolbar: Add account and Sign in all (M.ORCH-T604); room for more account actions here. -->
                    <DockPanel x:Name="AccountsToolbar" Margin="0,4,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBox x:Name="NewAccountBox" Style="{StaticResource MaTextBox}" Width="260" Height="32" VerticalAlignment="Center"
                                     Text="{Binding NewAccountEmail, UpdateSourceTrigger=PropertyChanged}"
                                     mc:MaTextBox.Placeholder="name@company.com"
                                     AutomationProperties.Name="Email of the account to add" />
                            <Button Style="{StaticResource MaPrimaryButton}" Content="Add account" Padding="14,5" Margin="8,0,0,0"
                                    Command="{Binding AddAccountCommand}" VerticalAlignment="Center"
                                    ToolTip="Sign in a per-CLI login of its own for this email (orchestrator login --account), opening its login in the browser. The global login is left as it is." />
                            <Button x:Name="SignInAllButton" Style="{StaticResource MaButton}" Content="Sign in all" Padding="14,5" Margin="8,0,0,0"
                                    Command="{Binding SignInAllCommand}" VerticalAlignment="Center"
                                    ToolTip="Give every account in the roster with no per-CLI login yet its own (~/.claude-accounts), opening each one's login in the browser in turn, so every Claude Team seat stays signed in side by side. The global login stays the default." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Accounts" Style="{StaticResource MaHeading}" />
                            <TextBlock Text="{Binding LoginCardsSummary}" Style="{StaticResource MaMutedText}" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                    <ItemsControl x:Name="LoginCardList" ItemsSource="{Binding LoginCards}" Focusable="False" AutomationProperties.Name="Claude logins">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><local:AlignedGrid MinItemWidth="420" Gap="12" RowGap="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LoginCardViewModel}">
                                <Border x:Name="LoginCard" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource MaCard}">
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="5" Background="{Binding StateBrush}" CornerRadius="5,0,0,5" />
                                        <StackPanel Margin="14,12,14,12">
                                            <DockPanel>
                                                <mc:MaBadge DockPanel.Dock="Right" Glyph="{Binding StateGlyph}" Content="{Binding SignedInText}"
                                                            Foreground="{Binding StateBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                <!-- The login's name (M.ORCH-T614), its email in the tooltip; Rename sets it. -->
                                                <Button DockPanel.Dock="Right" Style="{StaticResource MaTextButton}" Content="Rename" Padding="6,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RenameLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRename, Converter={StaticResource Visible}}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Rename {0}'}"
                                                        ToolTip="Give this login a name (orchestrator accounts alias &lt;email&gt; &lt;name&gt;)" />
                                                <TextBlock Text="{Binding Title}" ToolTip="{Binding TitleTip}" Style="{StaticResource MaHeading}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Cancel" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Save" Padding="12,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.SaveLoginAliasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Save the name; a blank name goes back to the email's part before the @" />
                                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Text="{Binding AliasDraft, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                         AutomationProperties.Name="{Binding AliasEmail, StringFormat='Name for {0}'}" ToolTip="{Binding AliasEmail}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource MaMutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Plan, Mode=OneWay}" Foreground="{DynamicResource MaText}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Mismatch}" Foreground="{DynamicResource MaWarn}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding Mismatch, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="5 hours" Style="{StaticResource MaMutedText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding FiveHourUsed}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Text="{Binding FiveHourResets}" Style="{StaticResource MaMutedText}" />
                                                <TextBlock Grid.Row="1" Text="Week" Style="{StaticResource MaMutedText}" Margin="0,2,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WeekUsed}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeekResets}" Style="{StaticResource MaMutedText}" Margin="0,2,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding PaceText}" Style="{StaticResource MaMutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding CanSignIn, Converter={StaticResource Visible}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Sign in" Padding="14,4"
                                                        Command="{Binding DataContext.SignInLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Sign in {0}'}"
                                                        ToolTip="Open this account's login in the browser (orchestrator login --account)" />
                                                <TextBlock Text="Nobody is signed in to this login, so no CLI can run on it." Style="{StaticResource MaMutedText}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding SignInHint}" Foreground="{DynamicResource MaWarn}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding SignInHint, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />

                                            <!-- The live CLIs on this login, one row each. -->
                                            <Border x:Name="LoginCliPanel" Style="{StaticResource MaCard}" Background="{DynamicResource MaChrome}" Padding="10,8" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ClisHeader}" Style="{StaticResource MaSectionLabel}" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Clis}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:LoginCliViewModel}">
                                                                <Grid>
                                                                <DockPanel x:Name="LoginCliRow" Margin="0,2,0,2" ToolTip="{Binding SessionId}" IsEnabled="{Binding IsUnlocked}">
                                                                    <!-- Move to another signed-in login (M.ORCH-T607). -->
                                                                    <Button x:Name="LoginCliMoveToButton" DockPanel.Dock="Right" Click="OnMoveToClick" Style="{StaticResource MaTextButton}"
                                                                            Content="Move to ▾" FontSize="12" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                            ToolTip="Move this CLI to another signed-in login at its next idle point, keeping its session"
                                                                            AutomationProperties.Name="{Binding Repo, StringFormat='Move the {0} CLI to another login'}" />
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShortId}" Style="{StaticResource MaMutedText}"
                                                                               FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" Foreground="{Binding StateBrush}"
                                                                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Repo}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </DockPanel>
                                                                <Grid x:Name="LoginCliMovingOverlay" Visibility="{Binding IsMoving, Converter={StaticResource Visible}}">
                                                                    <Border Background="{DynamicResource MaChrome}" Opacity="0.82" />
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                        <mc:MaSpinner Width="14" Height="14" StrokeThickness="2" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding MovingText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- The person's Terminals tab (M.ORCH-T618, M.ORCH-T622): their CLIs opened inside the Orchestrator ("Where CLIs
                 open" in Settings), one terminal tab each with its login's badge and color (M.ORCH-T616), filling the window
                 below the person tabs (the header, chart and view pills fold away). The terminals are native windows drawn over
                 WPF, so the whole view is hidden (never collapsed: they keep their size) while Settings or the loader is over it.
                 Every pane's terminal lives in the one host grid below; only the shown person's chosen one is visible.
                 Visibility reads the window's view model: this element's own DataContext is Terminals, which has none. -->
            <!-- A refresh really running behind the shown view (M.ORCH-T634): a small spinner at its bottom; switching never waits. -->
            <mc:MaSpinner x:Name="ViewSpinner" Grid.ColumnSpan="2" Width="20" Height="20" StrokeThickness="2"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Panel.ZIndex="5" IsHitTestVisible="False"
                          Visibility="{Binding IsViewBusy, Converter={StaticResource Visible}}"
                          AutomationProperties.Name="Refreshing this view" />

            <DockPanel x:Name="TerminalsBody" Grid.ColumnSpan="2" Margin="24,0,24,16"
                       Visibility="{Binding DataContext.TerminalsVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                       DataContext="{Binding Terminals}">
                <DockPanel x:Name="TerminalsReopen" DockPanel.Dock="Top" Margin="0,0,0,8"
                           Visibility="{Binding HasReopen, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Dismiss" Padding="14,4" Margin="8,0,0,0"
                            Command="{Binding DismissReopenCommand}" VerticalAlignment="Center"
                            ToolTip="Forget them: nothing is reopened" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Reopen" Padding="14,4" Margin="8,0,0,0"
                            Command="{Binding ReopenCommand}" VerticalAlignment="Center"
                            ToolTip="Open each one again in a pane of its own, on the login it ran on, resuming its Claude conversation (claude --resume)" />
                    <TextBlock Text="{Binding ReopenText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>

                <ListBox x:Name="TerminalTabs" DockPanel.Dock="Top" ItemsSource="{Binding Panes}" SelectedItem="{Binding SelectedPane}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,6" AutomationProperties.Name="Terminal panes"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TerminalPaneViewModel}">
                            <Border x:Name="TerminalTab" BorderBrush="{Binding TabBrush}" BorderThickness="0,0,0,3" Padding="8,4,4,4"
                                    ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Title}">
                                <Grid>
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsUnlocked}">
                                    <Border Background="{Binding TabBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeForeground}" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource MaMutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <!-- Go to: its repo on this person's dashboard; Move to: its CLI to another signed-in login (M.ORCH-T622). -->
                                    <Button x:Name="PaneGoToButton" Style="{StaticResource MaTextButton}" Content="Go to" FontSize="12" Padding="6,1" Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ShowPaneRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Request.Repo, StringFormat='Go to {0} on the dashboard'}"
                                            ToolTip="Show its repo on this person's dashboard: its detail, tickets and agents" />
                                    <Button x:Name="PaneMoveToButton" Click="OnMoveToClick" Style="{StaticResource MaTextButton}" Content="Move to ▾" FontSize="12"
                                            Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Request.Repo, StringFormat='Move the {0} CLI to another login'}"
                                            ToolTip="Move this CLI to another signed-in login at its next idle point, keeping its session; its pane moves to that person's Terminals" />
                                    <Button Style="{StaticResource MaButton}" Content="✕" Padding="6,0" Margin="8,0,0,0" FontSize="11"
                                            Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Close {0}'}"
                                            ToolTip="Close this pane, ending its CLI" />
                                </StackPanel>
                                <Grid x:Name="PaneMovingOverlay" Visibility="{Binding IsMoving, Converter={StaticResource Visible}}">
                                    <Border Background="{DynamicResource MaChrome}" Opacity="0.82" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <mc:MaSpinner Width="14" Height="14" StrokeThickness="2" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding MovingText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Only in the Terminals view (M.ORCH-T625): collapsed elsewhere so it can never draw over another view's heading. -->
                <TextBlock x:Name="TerminalsEmptyHint" DockPanel.Dock="Top" TextWrapping="Wrap"
                           Text="No terminals open for this login. With Settings, Where CLIs open: Orchestrator, a CLI started from the Orchestrator (Start, the Queue, autopilot, orchestrator start) opens as a pane of its own here, on the Terminals tab of the login it runs on.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MaMutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasPanes}" Value="False" />
                                        <Condition Binding="{Binding DataContext.IsTerminalsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- The panes' terminals, one per pane, stacked: only the selected one shows (MainWindow.xaml.cs adds and removes them). -->
                <Grid x:Name="TerminalPanesHost" />
            </DockPanel>

        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="6" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,1,0,0" Padding="24,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MaMutedText}"
                           Text="F5 refresh · Ctrl+Tab next login · Ctrl+F search · Ctrl +/− zoom · Esc close" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource MaMutedText}" Margin="0,0,16,0">
                    <Run Text="{Binding RepoCount, Mode=OneWay}" /><Run Text=" repos under " /><Run Text="{Binding WorkspaceRoot, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="Announcer" DockPanel.Dock="Left" Width="0" Height="0" Opacity="0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Foreground="{DynamicResource MaBad}" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}">
                    <TextBlock.ToolTip>
                        <ItemsControl ItemsSource="{Binding Warnings}" />
                    </TextBlock.ToolTip>
                    <Run Text="{Binding WarningsText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Covers every row until the first refresh lands (M.ORCH-T184). -->
        <Border x:Name="Loader" Grid.RowSpan="7" Panel.ZIndex="100" Background="{DynamicResource MaChrome}"
                Visibility="{Binding IsLoading, Converter={StaticResource Visible}}"
                AutomationProperties.Name="Loading the dashboard" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The library's MaSpinner turns on its own thread, so it keeps turning while this window's thread applies the
                     first snapshot and lays the dashboard out (M.ORCH-T200); MaAccent from its implicit style. -->
                <mc:MaSpinner x:Name="LoaderSpinner" Width="44" Height="44" StrokeThickness="4" HorizontalAlignment="Center"
                              AutomationProperties.Name="Loading the dashboard" />
                <TextBlock Margin="0,16,0,0" FontSize="15" HorizontalAlignment="Center" Text="Loading the workspace…" />
                <TextBlock Style="{StaticResource MaMutedText}" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Text="Reading every repo's sessions, tickets and usage" />
            </StackPanel>
        </Border>

        <!-- Settings (M.ORCH-T498): the shared MaModal, centred over a dimmed window, instead of the old right-side flyout.
             Esc, its close button and the backdrop all close it through ToggleSettingsCommand (which reloads the saved
             settings, dropping unsaved edits, as the flyout's close did); focus is held inside while open and goes back to
             the Settings button (or stat card) after. Last in the root grid, spanning every row, over the loader too. -->
        <mc:MaModal x:Name="SettingsModal" Grid.RowSpan="7" Title="Settings" AutomationProperties.Name="Settings"
                    IsOpen="{Binding IsSettingsOpen}" CloseCommand="{Binding ToggleSettingsCommand}">
            <StackPanel DataContext="{Binding Settings}">
                <TextBlock Text="TOKEN BUDGET" Style="{StaticResource MaSectionLabel}" Margin="0,4,0,8" />
                <TextBlock Text="Uncached tokens (input + cache writes + output). Accepts 20M, 500k, 1.5B. Leave blank to use Claude's own reported limit, or else the limits learned from the times you actually hit the wall."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Per 5-hour block" Margin="0,4,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Text="{Binding BlockBudget, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Budget per 5-hour block" />
                <TextBlock Text="Per week" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Text="{Binding WeeklyBudget, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Weekly budget" />
                <TextBlock Text="Week resets (local time)" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="160" HorizontalAlignment="Left"
                         Text="{Binding WeeklyReset, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly reset day and time" />
                <TextBlock Text="When Claude's weekly limit restarts, e.g. Mon 9:00 AM or Tue 5pm. Claude's own reported reset comes first; blank uses the reset your last weekly limit hit reported, or a rolling 7 days before you've had one."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="Warn at (%)" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                         Text="{Binding WarnPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Warn percent" />
                <TextBlock Text="Weekly reserve (% of each account's week kept back)" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                         Text="{Binding WeeklyReserve, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly reserve percent" />
                <TextBlock Text="0 to 50. Every CLI on an account stops at 100 minus this of that account's week (95% at the default 5), so the CLIs never burn the whole week. Each login is held to its own line."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding Pacing}" Margin="0,12,0,0" HorizontalAlignment="Left"
                              Content="Pace to the reset" />
                <TextBlock Text="Caps new sessions so spend lands on the target as the 5-hour window resets, instead of hitting the wall and waiting. The week is shown, never paced. Off: new work holds at the warn line."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="Pace target (% of the 5-hour limit by its reset)" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                         Text="{Binding PaceTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pace target percent" />
                <TextBlock Text="Pace profile" Margin="0,10,0,4" />
                <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding PaceProfiles}" SelectedItem="{Binding PaceProfile}"
                         AutomationProperties.Name="Pace profile" />
                <TextBlock Text="Linear spreads what's left evenly to the reset. Front-loaded aims at target × elapsed^k, spending faster early and easing off, and starts no new subagent or ticket past 85%. Switch any time: the next pace check follows the new curve."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="Front-loaded curve exponent k (0.1 to 1; lower front-loads more)" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                         Text="{Binding PaceCurveK, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Front-loaded curve exponent" />
                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding ThrottleAgents}" Margin="0,12,0,0" HorizontalAlignment="Left"
                              Content="Hold running agents" />
                <TextBlock Text="While the draw won't last until the reset, every Claude agent (subagents too) waits before each tool call, and is let go the moment it fits."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="Longest hold per tool call (seconds)" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                         Text="{Binding MaxDelay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Longest hold in seconds" />
                <TextBlock Text="Exempt from pacing" Margin="0,10,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Text="{Binding ExemptCommands, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Commands exempt from pacing" />
                <TextBlock Text="Slash commands, comma-separated. A turn typed as one of them (and a Skill call naming one) skips every pace gate: no hold, no subagent wait, no stop. Its spend still counts. Blank exempts none."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="SCHEDULER" Style="{StaticResource MaSectionLabel}" />
                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding AutoLogin}" Margin="0,0,0,0" HorizontalAlignment="Left"
                              Content="One CLI per account (Auto login)" />
                <TextBlock Text="A new Claude tab (Start on Auto in the global login's tab, orchestrator start without --account, autopilot's starts, the Launcher's accounts pick) goes on a signed-in per-CLI login no CLI runs on yet, most headroom first, else the global login. Off: the global login unless one is chosen."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding RebalanceLogins}" Margin="0,0,0,0" HorizontalAlignment="Left"
                              Content="Rebalance when an account runs low" />
                <TextBlock Text="A CLI whose login crosses its 5-hour pace target or its weekly stop line is moved by the daemon to a signed-in per-CLI login with no CLI and more headroom: it restarts with claude --resume at its next idle point, keeping its session, and you're toasted. Off: every CLI stays on its login."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                <TextBlock Text="Where CLIs open" Margin="0,0,0,4" />
                <ListBox x:Name="TerminalHostChoice" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding TerminalHosts}" SelectedItem="{Binding TerminalHost}"
                         AutomationProperties.Name="Where CLIs open" />
                <TextBlock Text="Windows Terminal opens each CLI in a Windows Terminal window of its login's own. Orchestrator opens it as a terminal pane in the Terminals view here, running the same Launcher tab; the panes close with this window, which then offers to resume them (claude --resume) the next time it opens. Only CLIs opened after a Save follow it."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                <TextBlock Text="Max concurrent sessions (working + waiting)" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                         Text="{Binding MaxSessions, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Max concurrent sessions" />
                <TextBlock Text="Provider for dispatched tickets" Margin="0,10,0,4" />
                <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                         AutomationProperties.Name="Dispatch provider" />
                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding Autopilot}" Margin="0,8,0,0" HorizontalAlignment="Left"
                              Content="Autopilot" />
                <TextBlock Text="Type /allocate in a CLI and that CLI works its repo's tickets (or -repo=a,b, or all) through its own subagents, each in its own worktree, as many at once as the pace allows; no other CLI is affected. Off here pauses it in every CLI; /allocate off ends it in that one."
                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource MaBad}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding Error, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </StackPanel>
            <mc:MaModal.Footer>
                <DockPanel DataContext="{Binding Settings}" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Save" Padding="20,6"
                            Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource MaMutedText}" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>
    </Grid>
</Window>
