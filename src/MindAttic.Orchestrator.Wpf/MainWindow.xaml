                                             Margin="{StaticResource SpaceLXS}" Value="{Binding WeeklyLimitPercent, Mode=OneWay}"
                                             Foreground="{Binding WeeklyLimitBrush}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowsFiveHourChart, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding UsageLambdaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                                    <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                                                 Margin="{StaticResource SpaceLXS}" Value="{Binding FiveHourLimitPercent, Mode=OneWay}"
                                                 Foreground="{Binding FiveHourLimitBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- This login's own menu (Open Project, Run Launcher, User Settings, Change Color), reachable
                                 with a tap or a left click (M.ORCH-T1793): the exact same menu the row's own right-click opens
