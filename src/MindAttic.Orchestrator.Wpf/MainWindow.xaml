<Window x:Class="MindAttic.Orchestrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
        xmlns:local="clr-namespace:MindAttic.Orchestrator.Wpf"
        mc:MaWindow.ThemedTitleBar="True"
        Title="MindAttic Orchestrator" Width="1480" Height="920" MinWidth="320" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/logo.ico"
        Background="{DynamicResource MaChrome}" Foreground="{DynamicResource MaText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Escape" Command="{x:Static vm:WindowCommands.Escape}" />
        <!-- The next and the previous login's tab (M.ORCH-T613). -->
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <!-- The next and the previous CLI (Terminal) tab of the shown login's (M.ORCH-T824): works even while a terminal
             holds keyboard focus, since plain Left/Right there move the CLI's own cursor instead of the tab strip's selection. -->
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding Terminals.PreviousCommand}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding Terminals.NextCommand}" />
        <!-- Ctrl+Plus / Ctrl+Minus / Ctrl+0 (main row and number pad) are the library's ZoomLevel's, added in MainWindow.xaml.cs.
             While a terminal holds focus only F5, Ctrl+Tab, Ctrl+Shift+Tab, Ctrl+Left/Right (and the paste keys) act
             (M.ORCH-T846): every other binding here (Esc, the zoom keys) is gated so its key reaches the CLI. -->

    </Window.InputBindings>

    <Window.Resources>
        <!-- A ticket id: a link that opens the ticket in Tickets Desktop to view, approve, prioritize or close it (M.ORCH-T500).
             Its CommandParameter is the id. The library's MaHyperlink (MaLink, SemiBold, underlined on hover and keyboard focus,
             so it reads as a link without colour), plus the command and tooltip. -->
        <Style x:Key="TicketLink" TargetType="Hyperlink" BasedOn="{StaticResource MaHyperlink}">
            <Setter Property="Command" Value="{Binding DataContext.OpenInTicketsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ToolTip" Value="{DynamicResource TicketLinkCallout}" />
        </Style>
        <!-- The TicketLink's tooltip as the library's callout (M.ORCH-T1552). A Hyperlink isn't a FrameworkElement, so
             mc:MaCallout.ToolTip can't reach it: the callout itself is its ToolTip, a fresh one per link (x:Shared). -->
        <mc:MaCalloutToolTip x:Key="TicketLinkCallout" x:Shared="False" Content="Open it in Tickets Desktop to view, approve, prioritize, assign, block or close it" />


        <!-- A ticket on a person's Tickets view (M.ORCH-T668): who it's assigned to, with their status light; while its user is out
             of room it says why it waits. Assigning, reassigning and "Redelegate now" are Tickets Desktop's (M.ORCH-T762): the
             Assign in Tickets link, like the id and title, opens the ticket there. -->
        <DataTemplate x:Key="UserTicketTemplate" DataType="{x:Type vm:UserTicketRowViewModel}">
            <Border x:Name="UserTicketCard" Style="{StaticResource MaRowCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SpaceLM}">
                        <mc:MaStatusLight x:Name="AssigneeLight" Status="{Binding Assignee.Status, TargetNullValue={x:Static mc:MaStatus.Other}}" Label="{Binding Assignee.StatusLabel}" Margin="{StaticResource SpaceRS}"
                                          VerticalAlignment="Center" Visibility="{Binding IsPinned, Converter={StaticResource Visible}}" />
                        <TextBlock x:Name="AssigneeText" Text="{Binding AssigneeText}" VerticalAlignment="Center" Margin="{StaticResource SpaceRM}"
                                   mc:MaCallout.ToolTip="Who it's assigned to: it's dispatched only on their login, and waits for them while they're out of room" />
                        <TextBlock VerticalAlignment="Center">
                            <Hyperlink x:Name="AssignInTickets" Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                       AutomationProperties.Name="{Binding Id, StringFormat='Assign {0} in Tickets Desktop'}"><Hyperlink.ToolTip><mc:MaCalloutToolTip Content="Assign, reassign or redelegate it in Tickets Desktop" /></Hyperlink.ToolTip><Run Text="Assign in Tickets" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock>
                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                       AutomationProperties.Name="{Binding Id, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Id, Mode=OneWay}" /></Hyperlink>
                            <Run Text="  " /><Run Text="{Binding Repo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                            <Run Text="{Binding Priority, Mode=OneWay}" Foreground="{DynamicResource MaWarn}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock TextTrimming="CharacterEllipsis" mc:MaCallout.ToolTip="{Binding Summary}" Margin="{StaticResource RowGutter}">
                            <!-- The title opens it too (M.ORCH-T762: every ticket id or title the dashboard shows links there). -->
                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                       AutomationProperties.Name="{Binding Summary, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Summary, Mode=OneWay}" /></Hyperlink>
                        </TextBlock>
                        <!-- Its status, muted; while it waits for its user, in MaWarn and SemiBold (M.ORCH-T667: one line each,
                             the other collapsed, so no style of the dashboard's own). The ids it names link into Tickets Desktop. -->
                        <Grid x:Name="UserTicketStatus" Margin="{StaticResource RowGutter}" Visibility="{Binding Status, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <TextBlock local:TicketText.Text="{Binding Status}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                                       Visibility="{Binding IsWaiting, Converter={x:Static vm:Converters.FalseToVisible}}" />
                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" TextWrapping="Wrap"
                                       Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A ticket card in the unified sidebar list (M.ORCH-T1770, replacing M.ORCH-T1439's single whole-card button): two
             independent click targets, a Play button that jumps to the CLI and person working it (JumpToCliCommand, hidden
             while nobody is) and a Ticket button that opens it in Tickets Desktop (OpenInTicketsCommand) - no x:Key, so this
             (and the two templates below) apply implicitly by DataType wherever ItemTemplate isn't set, letting one
             ItemsControl mix task rows and ticket rows in the same "Active" list (MainViewModel.TaskList.cs's ActiveItems).
             Its id and friendly name as "ID · name" (M.ORCH-T1450, falling back to a cut summary with no name yet), then its
             repo with its type and priority, muted, the title up to two lines, then its status or why it waits. The
             library's MaRowCard: a Border, not a button, so the two buttons below are its only click targets (the pattern
             UserTicketTemplate above already uses for its own Hyperlinks). -->
        <DataTemplate DataType="{x:Type vm:UserTicketRowViewModel}">
            <!-- Padding="0" + MaAccentBar flush to the card's own edges, not MaTag's rounded 4px MaBadge floating inside the
                 card's default padding (M.ORCH-T1800): the stripe treatment every card in this list shares with
                 TaskRowViewModel's below, the one the mismatch was measured against. -->
            <Border x:Name="SidebarTicketCard" Style="{StaticResource MaRowCard}" Padding="0">
                <DockPanel>
                <Border x:Name="SidebarTicketAccent" Style="{StaticResource MaAccentBar}" Width="3" CornerRadius="0" Background="{Binding Accent}" Focusable="False" />
                <!-- Every card in this list shares this same lower-right icon trio (M.ORCH-T1825, the owner's mockup):
                     focus (jump to the CLI), ticket (open it in Tickets Desktop) and paragraph (review/edit its whole
                     ticket or task in the detail modal). Bottom-aligned, not Top, so it reads as the card's own corner
                     rather than floating beside its title. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="{StaticResource SpaceLM}">
                    <!-- A magnifying glass, not the Play triangle (M.ORCH-T1882, the owner's report): this only switches to
                         the CLI already working it, to look at it - it starts nothing, and the triangle read as run/execute. -->
                    <Button x:Name="SidebarTicketPlayButton" Style="{StaticResource MaToolButton}" Content="&#xE721;" Margin="{StaticResource SpaceRXS}"
                            Command="{Binding DataContext.JumpToCliCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            mc:MaCallout.ToolTip="Jump to the CLI working it" AutomationProperties.Name="{Binding PlayName}"
                            Visibility="{Binding CanPlay, Converter={StaticResource Visible}}" />
                    <Button x:Name="SidebarTicketOpenButton" Style="{StaticResource MaToolButton}" Content="&#xE8EC;" Margin="{StaticResource SpaceRXS}"
                            Command="{Binding DataContext.OpenInTicketsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                            mc:MaCallout.ToolTip="Open it in Tickets Desktop" AutomationProperties.Name="{Binding OpenName}" />
                    <Button x:Name="SidebarTicketDetailButton" Style="{StaticResource MaToolButton}" Content="&#xE70F;"
                            Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            mc:MaCallout.ToolTip="Review its whole ticket" AutomationProperties.Name="{Binding Caption, StringFormat='Review {0}'}" />
                </StackPanel>
                <StackPanel Margin="8,6,8,6">
                    <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MaTileSubtitle}" Margin="{StaticResource SpaceLS}">
                            <Run Text="{Binding Type, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Priority, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding Repo}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="{StaticResource RowGutter}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="34" />
                    <Grid Margin="{StaticResource RowGutter}" Visibility="{Binding Status, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsWaiting, Converter={x:Static vm:Converters.FalseToVisible}}" />
                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" TextWrapping="Wrap"
                                   Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}" />
                    </Grid>
                </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A live, ticket-less activity card in the unified sidebar list (M.ORCH-T1519, restructured by M.ORCH-T1770): the
             same lower-right icon pair as every other card (M.ORCH-T1825) - a Play button that jumps to its CLI, and a
             paragraph button that reviews its own CLI's detail - minus the Ticket button, since there's no ticket yet. Its
             title is the session's current "Doing" text instead of a ticket summary, so a busy member never reads as having
             nothing active just because nothing's been attributed to a ticket yet. No x:Key: implicit by DataType, like the
             ticket template above. -->
        <DataTemplate DataType="{x:Type vm:LiveActivityRowViewModel}">
            <!-- Same flush MaAccentBar stripe and card padding as UserTicketTemplate/TaskRowViewModel share (M.ORCH-T1800). -->
            <Border x:Name="SidebarActivityCard" Style="{StaticResource MaRowCard}" Padding="0">
                <DockPanel>
                <Border x:Name="SidebarActivityAccent" Style="{StaticResource MaAccentBar}" Width="3" CornerRadius="0" Background="{Binding Accent}" Focusable="False" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="{StaticResource SpaceLM}">
                    <!-- A magnifying glass, not the Play triangle (M.ORCH-T1882): see SidebarTicketPlayButton above. -->
                    <Button x:Name="SidebarActivityPlayButton" Style="{StaticResource MaToolButton}" Content="&#xE721;" Margin="{StaticResource SpaceRXS}"
                            Command="{Binding DataContext.JumpToCliCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            mc:MaCallout.ToolTip="Jump to its CLI" AutomationProperties.Name="{Binding PlayName}" />
                    <Button x:Name="SidebarActivityDetailButton" Style="{StaticResource MaToolButton}" Content="&#xE70F;"
                            Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            mc:MaCallout.ToolTip="Review its detail" AutomationProperties.Name="{Binding Repo, StringFormat='Review {0}'}" />
                </StackPanel>
                <StackPanel Margin="8,6,8,6">
                    <TextBlock Text="{Binding Repo}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="{StaticResource RowGutter}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="34" />
                    <!-- Flagged past the grace period (M.ORCH-T1520): a UI-only nudge, not a block. -->
                    <TextBlock Text="{Binding OverdueText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}"
                               TextWrapping="Wrap" Margin="{StaticResource RowGutter}" Visibility="{Binding IsOverdue, Converter={StaticResource Visible}}" />
                </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A Task List row in the unified sidebar list (M.ORCH-T1593, restructured by M.ORCH-T1770): one process spending
             tokens right now (a working CLI, or one of its subagents, indented under it), its owner's name in their tab
             colour and the same colour as its left stripe, then its ticket ("ID · name", or "No ticket"). The same
             lower-right icon trio as every other card (M.ORCH-T1825): a Play button that jumps to its own CLI, a Ticket
             button that opens its ticket in Tickets Desktop (hidden while it has none), and a paragraph button that
             reviews its whole ticket or task in the detail modal. No x:Key: implicit by DataType, like the two templates
             above, so it sits in the same ItemsControl as a ticket row with no ItemTemplate split by kind. -->
        <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
            <Border x:Name="SidebarTaskCard" Style="{StaticResource MaRowCard}" Padding="0">
                <DockPanel Margin="{Binding Indent}">
                    <!-- The owner's-colour stripe (M.ORCH-T1626): the library's MaAccentBar, 3px and square to keep the row's look. -->
                    <Border Style="{StaticResource MaAccentBar}" Width="3" CornerRadius="0" Background="{Binding OwnerBrush}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="{StaticResource SpaceLM}">
                        <!-- A magnifying glass, not the Play triangle (M.ORCH-T1882): see SidebarTicketPlayButton above. -->
                        <Button x:Name="SidebarTaskPlayButton" Style="{StaticResource MaToolButton}" Content="&#xE721;" Margin="{StaticResource SpaceRXS}"
                                Command="{Binding DataContext.JumpToCliCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                mc:MaCallout.ToolTip="Jump to its CLI" AutomationProperties.Name="{Binding PlayName}" />
                        <Button x:Name="SidebarTaskOpenButton" Style="{StaticResource MaToolButton}" Content="&#xE8EC;" Margin="{StaticResource SpaceRXS}"
                                Command="{Binding DataContext.OpenInTicketsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TicketId}"
                                mc:MaCallout.ToolTip="Open its ticket in Tickets Desktop" AutomationProperties.Name="{Binding TicketText, StringFormat='Open {0} in Tickets Desktop'}"
                                Visibility="{Binding HasTicket, Converter={StaticResource Visible}}" />
                        <Button x:Name="SidebarTaskDetailButton" Style="{StaticResource MaToolButton}" Content="&#xE70F;"
                                Command="{Binding DataContext.OpenTaskDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                mc:MaCallout.ToolTip="Review its whole ticket or task" AutomationProperties.Name="{Binding TicketText, StringFormat='Review {0}'}" />
                    </StackPanel>
                    <StackPanel Margin="8,6,8,6">
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Owner, Mode=OneWay}" Foreground="{Binding OwnerBrush, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                            <Run Text="  " /><Run Text="{Binding Tokens, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                        </TextBlock>
                        <TextBlock Text="{Binding TicketText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="{StaticResource RowGutter}" />
                        <TextBlock Text="{Binding Repo}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Doing}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The login tab strip's own sigma/lambda bars (M.ORCH-T1536), the same pair as the pinned Usage tab's own header,
             but in MaTabItem.TrailingContent rather than the Header (M.COMP-T172): Trailing/TrailingContent dock to the
             strip's trailing edge in TabStripPlacement="Left" the way the header never does, so this is what actually gets
             the bars right-aligned, where embedding them in the Header DataTemplate (M.ORCH-T1532's first cut) could not.
             Hidden per row by its own root Visibility (ShowsTabUsageBars) exactly as before; TrailingContent itself is
             always set ({Binding}, the login's own MainViewModel), so the trigger that collapses PART_TrailingContent on a
             null TrailingContent never fires here - this is what hides it instead. The lambda pair collapses on its own
             (ShowsFiveHourChart, M.ORCH-T1540) for a solo Ultra login, which has no 5-hour window to show. -->
        <!-- A person's hover tooltip (M.ORCH-T1814, M.COMP-T193's MaCallout.ToolTipTemplate): the text the tooltip always
             had (figures, resets, cutoffs, active CLIs). Its 5-hour chart thumbnail is gone (M.ORCH-T1887): nobody ever saw
             it, so the chart lives under each CLI's terminal instead (TerminalUsageChart). The tooltip isn't in the row's
             visual tree, so this binds to the tooltip's own value: the login's MainViewModel. -->
        <DataTemplate x:Key="LoginHoverTipTemplate" DataType="{x:Type vm:MainViewModel}">
            <TextBlock Text="{Binding TabHoverTip}" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="LoginUsageBarsTemplate" DataType="{x:Type vm:MainViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowsTabUsageBars, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding UsageSigmaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" />
                <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                             Margin="{StaticResource SpaceLXS}" Value="{Binding WeeklyLimitPercent, Mode=OneWay}"
                             Foreground="{Binding WeeklyLimitBrush}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowsFiveHourChart, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding UsageLambdaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                    <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                                 Margin="{StaticResource SpaceLXS}" Value="{Binding FiveHourLimitPercent, Mode=OneWay}"
                                 Foreground="{Binding FiveHourLimitBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The menu bar (row 0, M.ORCH-T1499) is the window's own fixed top strip. The login tabs (row 1) and the CLI tab bar
             (row 2, TerminalsPanel) are the other fixed rows (M.ORCH-T1302): you always see who's selected and which CLI is
             shown. Everything else - the chosen terminal, the 5-hour chart right after it, the stats, the 5-hour chart and
             Tickets - lives in AgentsBody (row 3), one scrolling panel, so scrolling down past the terminal reaches the rest.
             The status bar (row 4) stays its own fixed footer, as it always was. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The login tabs are a sidebar on the left (M.ORCH-T1431): column 0 holds who, column 1 their CLIs and body. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- One dashboard tab per Claude login (M.ORCH-T613): the global ~/.claude login first, then each per-CLI login under
             ~/.claude-accounts, by its name (M.ORCH-T614, its email in the tooltip) and its terminal tabs' color (M.ORCH-T616),
             with how many of its repos need you. Everything below is the chosen login's: the window shows that tab's view model
             (MainWindow.xaml.cs sets its DataContext), and this strip keeps the global login's tab's, which holds every tab.
             Shown once there's a second login; Ctrl+Tab and Ctrl+Shift+Tab step through them. Its own row above the header,
             so the header, chart and view pills can fold away on a tab while the strip stays. -->
        <!-- Dark (the default) or light, every view following at once (ThemeChoice, M.ORCH-T678): no switch of its own in this
             window any more (M.ORCH-T1512, it wasn't used often enough to earn a permanent icon), set instead from
             MindAttic.Vault.Desktop's Orchestrator settings page. This window only applies the saved choice at start
             (App.xaml.cs) and follows a change made there live (ThemeChoice.Follow, MainWindow.xaml.cs). -->
        <!-- No emergency billing toggle any more (M.ORCH-T906, which replaced M.ORCH-T770's): the Vault's API key is a person
             with its own tab in the strip below, its own Launcher and CLIs billing API credits; orchestrator billing stays the
             command-line tool. -->
        <!-- The app's menu bar (M.ORCH-T1499): a full-width strip above the sidebar and the terminal body, right-aligned.
             Holds what used to be the sidebar's own window-tools row (Team Wall, Tickets, Logins, Settings, Wind down),
             moved here so it's reachable regardless of which login's tab is open, plus this host machine's own C: free
             space and RAM load (DiskFreeText/RamUtilizationText, MainViewModel.HostStats.cs), refreshed every RefreshAsync
             tick (5s). Bound to the global login's tab in code-behind (MenuBarTools.DataContext = model), like OrgStrip:
             these five tools and the two readouts are the same regardless of which login's tab is shown. -->
        <Border x:Name="MenuBar" Style="{StaticResource MaStatusBar}" Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
            <Grid x:Name="MenuBarRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The phone layout's first row (M.ORCH-T1568, M.ORCH-T1571): the menu button top left, with the tools staying
                 top right; the shown person's own CLI tab strip (scroll arrows and all) is the row under it, as on the
                 desktop. The menu button opens the sidebar itself as a drawer (M.ORCH-T1570: orgs, every person with their
                 badges and right-click menu, their ticket cards), which is why the person picker that used to sit beside it
                 is gone (M.ORCH-T1815): the drawer lists the same logins (OrgTabs) and more. Collapsed on the desktop
                 (MainWindow.Compact.cs shows it). -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid x:Name="PhonePickers" Visibility="Collapsed" Margin="{StaticResource SpaceRS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DrawerButton" Grid.Column="0" Style="{StaticResource MaToolButton}" Content="&#xE700;" Click="DrawerButton_Click"
                        Margin="{StaticResource SpaceRS}" mc:MaCallout.ToolTip="People, organizations and their tickets" AutomationProperties.Name="Show people and tickets" />
            </Grid>
            <!-- This host's own C: free space and RAM load, upper left (M.ORCH-T1499, moved to the corner and given bars
                 by M.ORCH-T1875, the owner's request): a short label and a small usage bar for each, the same
                 MaProgressBar/BandBrush pairing as the login tab strip's own Sigma/Lambda bars (LoginUsageBarsTemplate
                 above), so host and login usage read the same way. Collapsed in the phone layout like the readouts it
                 replaces (MainWindow.Compact.cs's ApplyCompact). -->
            <StackPanel x:Name="HostStatsBars" Orientation="Horizontal" VerticalAlignment="Center"
                        AutomationProperties.Name="This machine's disk and RAM use">
                <TextBlock Text="C:" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" />
                <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                             Margin="{StaticResource SpaceLXS}" Value="{Binding DiskUsedPercent, Mode=OneWay}"
                             Foreground="{Binding DiskUsedBrush}" mc:MaCallout.ToolTip="Free space on the system drive" />
                <TextBlock x:Name="DiskFreeText" Text="{Binding DiskFreeText}" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceLS}"
                           mc:MaCallout.ToolTip="Free space on the system drive" AutomationProperties.Name="{Binding DiskFreeText}"
                           Visibility="{Binding DiskFreeText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="RAM" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" Margin="{StaticResource SpaceLM}" />
                <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                             Margin="{StaticResource SpaceLXS}" Value="{Binding RamUsedPercent, Mode=OneWay}"
                             Foreground="{Binding RamUsedBrush}" mc:MaCallout.ToolTip="{Binding RamToolTip}" />
                <!-- The memory guard's level (M.ORCH-T1498): muted while ok, MaWarn while it holds new work, MaBad once it sheds
                     subagents or refuses tool calls; one of the three shows, the tooltip says what's held. -->
                <TextBlock x:Name="RamUtilizationText" Text="{Binding RamCalmText}" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceLS}"
                           mc:MaCallout.ToolTip="{Binding RamToolTip}" AutomationProperties.Name="{Binding RamCalmText}"
                           Visibility="{Binding RamCalmText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock x:Name="RamWarnText" Text="{Binding RamWarnText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceLS}"
                           mc:MaCallout.ToolTip="{Binding RamToolTip}" AutomationProperties.Name="{Binding RamToolTip}"
                           Visibility="{Binding RamWarnText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock x:Name="RamBadText" Text="{Binding RamBadText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceLS}"
                           mc:MaCallout.ToolTip="{Binding RamToolTip}" AutomationProperties.Name="{Binding RamToolTip}"
                           Visibility="{Binding RamBadText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="MenuBarTools" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right" AutomationProperties.Name="Window tools and host status">
                <!-- On the host, the org members connected from their own PCs with their member keys (hub phase 1, M.ORCH-T1640):
                     a people glyph and a count, the tooltip naming them; collapsed when none is, and on every other machine. -->
                <StackPanel x:Name="ConnectedMembersChip" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SpaceRL}"
                            mc:MaCallout.ToolTip="{Binding ConnectedMembersToolTip}" AutomationProperties.Name="{Binding ConnectedMembersText}"
                            Visibility="{Binding ConnectedMembersText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRS}" />
                    <TextBlock x:Name="ConnectedMembersText" Text="{Binding ConnectedMembersText}" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" />
                </StackPanel>
                <!-- Allocation paused globally (the orchestrator settings allocate switch off, M.ORCH-T1491): in MaWarn like the memory
                     guard's held readout, shown only while the master switch is off, so a CLI's /allocate handing out nothing
                     is never silent. -->
                <TextBlock x:Name="AllocatePausedText" Text="{Binding AllocatePausedText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRL}"
                           mc:MaCallout.ToolTip="{Binding AllocatePausedToolTip}" AutomationProperties.Name="{Binding AllocatePausedText}"
                           Visibility="{Binding AllocatePausedText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <!-- The first load lifted its loader before the ticket database answered (M.ORCH-T1936): in MaWarn, shown only
                     until that read lands and fills the dashboard in. -->
                <TextBlock x:Name="TicketsLoadingText" Text="{Binding TicketsLoadingText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRL}"
                           mc:MaCallout.ToolTip="The ticket database is slow to answer; the dashboard fills in once it does" AutomationProperties.Name="{Binding TicketsLoadingText}"
                           AutomationProperties.LiveSetting="Polite" Visibility="{Binding TicketsLoadingText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <!-- The disk floor's hold (M.ORCH-T1679/T1692): in MaBad, shown only while the drive is under the floor even after a
                     self-cleanup, so nothing new starting is never silent; the tooltip says how much space lifts it. -->
                <TextBlock x:Name="DiskHoldText" Text="{Binding DiskHoldText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceRL}"
                           mc:MaCallout.ToolTip="{Binding DiskHoldToolTip}" AutomationProperties.Name="{Binding DiskHoldToolTip}"
                           Visibility="{Binding DiskHoldText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <Button x:Name="TeamWallButton" Style="{StaticResource MaToolButton}" Content="&#xE716;" Click="TeamWallButton_Click"
                        mc:MaCallout.ToolTip="Team Wall: everyone's live CLIs" AutomationProperties.Name="Team Wall" />
                <!-- The owner inbox (M.ORCH-T1689): everything waiting on the owner (approvals, tickets parked on them, stale and
                     orphaned tickets nobody picked up, logins to sign in again, consent requests), its count on the button
                     while there is any; it opens InboxModal. In the menu bar, so it stays in the phone layout too. -->
                <Grid x:Name="InboxTool" VerticalAlignment="Center">
                    <Button x:Name="InboxButton" Style="{StaticResource MaToolButton}" Content="&#xE715;" Command="{Binding ToggleInboxCommand}"
                            mc:MaCallout.ToolTip="{Binding InboxToolTip}" AutomationProperties.Name="{Binding InboxToolTip}" />
                    <mc:MaBadge x:Name="InboxBadge" Style="{StaticResource MaTag}" MinWidth="16" Height="16" Padding="3,0" BorderThickness="0" Content="{Binding InboxBadge}"
                                Background="{DynamicResource MaWarn}" Foreground="{DynamicResource MaOnAccent}" FontSize="9" FontWeight="Bold"
                                HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Focusable="False"
                                Visibility="{Binding HasInbox, Converter={StaticResource Visible}}" />
                </Grid>
                <!-- The saved plans (M.ORCH-T1826): half-formed ideas and features not ready for an implementation ticket yet,
                     each a markdown file under docs\plans in the workspace or a repo; the tooltip says how many, and it
                     opens PlansModal. Segoe's Lightbulb glyph. In the menu bar, so it stays in the phone layout too. -->
                <Button x:Name="PlansButton" Style="{StaticResource MaToolButton}" Content="&#xE82F;" Command="{Binding TogglePlansCommand}"
                        mc:MaCallout.ToolTip="{Binding PlansToolTip}" AutomationProperties.Name="{Binding PlansToolTip}" />
                <Button x:Name="TicketsButton" Style="{StaticResource MaToolButton}" Content="&#xE8EC;" Command="{Binding OpenTicketsAppCommand}"
                        mc:MaCallout.ToolTip="Open Tickets" AutomationProperties.Name="Open Tickets" />
                <Button x:Name="LoginsButton" Style="{StaticResource MaToolButton}" Content="&#xE77B;" Command="{Binding ToggleLoginsCommand}"
                        mc:MaCallout.ToolTip="User Management" AutomationProperties.Name="User Management" />
                <Button x:Name="SettingsButton" Style="{StaticResource MaToolButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                        mc:MaCallout.ToolTip="Settings (opens MindAttic Vault)" AutomationProperties.Name="Settings" />
                <!-- Save (M.ORCH-T1769, replacing Save all &amp; close's M.ORCH-T1724 force-close-and-exit, now retired):
                     left click quicksaves the shown CLI alone; right click opens Quick Save All / Quick Load All
                     (OnSaveButtonContextMenu), each confirmed first and reporting how long it took once it's done. -->
                <Button x:Name="SaveButton" Style="{StaticResource MaToolButton}" Content="&#xE74E;" Command="{Binding QuicksaveShownCommand}"
                        ContextMenuOpening="OnSaveButtonContextMenu"
                        mc:MaCallout.ToolTip="Quicksave the shown CLI; right-click (or the chevron beside it) for Quick Save All or Quick Load All"
                        AutomationProperties.Name="Quicksave the shown CLI (right-click, or the chevron beside it, for Quick Save All or Quick Load All)" />
                <!-- The Save button's own menu, reachable with a left click (M.ORCH-T1793): a right-click-only menu isn't
                     reachable on touch or in the phone layout, so this tiny chevron opens the exact same Quick Save
                     All / Quick Load All menu the button's own right-click does (ShowSaveMenu). -->
                <Button x:Name="SaveMoreButton" Style="{StaticResource MaToolButton}" Content="&#xE70D;" Width="16" FontSize="8" Margin="2,0,8,0"
                        Click="SaveMoreButton_Click"
                        mc:MaCallout.ToolTip="Quick Save All or Quick Load All" AutomationProperties.Name="Quick Save All or Quick Load All" />
            </StackPanel>
            </Grid>
        </Border>

        <!-- Top-aligned with a star middle row (M.ORCH-T1431): the tools sit right under the last login, and a list too long for
             the window scrolls on its own rather than pushing the tools off the bottom. Its top matches the CLI tab bar's. -->
        <Border x:Name="Sidebar" Style="{StaticResource MaSidePane}" Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" MinWidth="170"
                BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,0,1,0" Padding="12,8,12,8"
                AutomationProperties.Name="People and window tools">
        <!-- Since M.ORCH-T1439 the logins are Auto, and the ticket cards take whatever height is left, scrolling on their own.
             The window tools' own row (M.ORCH-T1431) moved up into the window's menu bar (M.ORCH-T1499). -->
        <Grid x:Name="TopRow">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Organizations above people (M.ORCH-T655): one pill per org (orchestrator orgs add), shown once there's a second,
             with how many of its people's repos need you; the person tabs below are the chosen org's. Kept on the global login's
             tab (MainWindow.xaml.cs), which holds every org, like the person strip under it. -->
        <ListBox x:Name="OrgStrip" Grid.Row="0" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}"
                 Padding="0" Margin="{StaticResource SpaceBS}" AutomationProperties.Name="Organizations, each with its own people"
                 Visibility="{Binding HasOrgs, Converter={StaticResource Visible}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OrgViewModel}">
                    <StackPanel x:Name="OrgItem" Orientation="Horizontal" mc:MaCallout.ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                        <TextBlock VerticalAlignment="Center" Margin="{StaticResource SpaceLS}"
                                   Visibility="{Binding Badge, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <Run Text="&#x2022; " /><Run Text="{Binding Badge, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" need you" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- The org-wide login actions (Add login, Sign in all, Report) moved from here into Settings' Logins tab (M.ORCH-T804). -->
        <!-- A vertical sidebar (M.ORCH-T1431, in place of M.ORCH-T822's horizontal scroller and its < > arrows): one row per
             login, each as wide as the column (the strip's own TabPanel stretches them, so no code-behind sizing any more). -->
        <ScrollViewer x:Name="LoginTabScroller" Grid.Row="1" Style="{StaticResource MaBodyScroll}" mc:MaScrollArea.Gutter="0"
                      MaxHeight="{Binding ActualHeight, ElementName=TopRow, Converter={x:Static vm:Converters.Share}, ConverterParameter=0.5}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowsFlatLoginStrip, Converter={StaticResource Visible}}">
        <mc:MaTabControl x:Name="LoginTabStrip" ShowContent="False" TabStripPlacement="Left" ItemsSource="{Binding OrgTabs}" SelectedItem="{Binding StripSelection}"
                         AutomationProperties.Name="Claude logins, one dashboard tab each"
                         ContextMenuOpening="OnLoginTabContextMenu">
            <!-- Status at a glance (M.ORCH-T630), all the library's MaTabItem (M.ORCH-T667): a status badge before the name
                 (M.ORCH-T757, boxed M.ORCH-T1173, in place of the status light): a gray box with a tiny "zzz" while the login has
                 no CLI open or every one of its open CLIs (hosted inside the Orchestrator's Terminals panel or outside it) has
                 stopped (M.ORCH-T890); a green box with its open CLI count while any of them is working (M.ORCH-T1261); an orange
                 box flashing between that count and "?" when one of them is genuinely blocked on the person (what used to be a
                 separate trailing flag, M.ORCH-T790, then a static "?", M.ORCH-T1261), which wins over idle or busy when both are
                 true; a gray 'disabled' icon (its own glyph, unboxed), a small lock
                 past its 5-hour or weekly cutoff while still signed in (the tab stays put and clickable, only held back from
                 new work), or the old blocked glyph while it's actually unusable (signed out, M.ORCH-T1254). Every badge's word
                 is in the tooltip and the accessible name, so neither
                 colour nor the picture is the only cue; the person's terminal colour is the tab's accent, and its trailing text
                 their live weekly and 5-hour use against their own cutoffs, "Σ: 15% | λ: 29%" (M.ORCH-T793/T968/T1251, cutoffs in
                 the tooltip; no 'N need you' count, no '% left'). -->
            <!-- The API key is a person here like any other (M.ORCH-T906): its tab comes after everyone's, its trailing text its
                 money ("$37.66 left") rather than 5-hour and weekly use. -->
            <mc:MaTabControl.ItemContainerStyle>
                <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                    <Setter Property="Accent" Value="{Binding TabBrush}" />
                    <!-- The plain percent figures ("Σ: 15% | λ: 29%") move to the tooltip (M.ORCH-T1532): the bars at the
                         strip's trailing edge below show them instead, so Trailing only still carries text for the cases a
                         bar can't say (unsigned, the API key's money, "sign in again", "stale · read Xh ago" -
                         TabTrailingFace). -->
                    <Setter Property="Trailing" Value="{Binding TabTrailingFace}" />
                    <!-- Right-aligned (M.ORCH-T1536, M.COMP-T172): TrailingContent docks exactly where Trailing does, which
                         in TabStripPlacement="Left" (the control's own template) is the strip's trailing edge - the Header
                         DataTemplate below never gets that treatment, so the bars couldn't live there. Always set; the
                         template's own root hides itself per row (ShowsTabUsageBars). -->
                    <Setter Property="TrailingContent" Value="{Binding}" />
                    <Setter Property="TrailingContentTemplate" Value="{StaticResource LoginUsageBarsTemplate}" />
                    <!-- A callout pointing at the sidebar (M.ORCH-T1441): its arrow touches the tab's right edge, and it flips, or slides
                         up or down, to stay on the tab's monitor (the library's MaCallout, M.COMP-T167). Its figures show up
                         with no more than CliTooltipDelayMs's wait (M.ORCH-T1532, M.ORCH-T1823: a Vault setting in place of the
                         old hardcoded 0 - ToolTipService's own delay on the owning tab, since MaCalloutToolTip is still a plain
                         ToolTip underneath, so that delay still governs it) to read a login's usage. -->
                    <Setter Property="ToolTipService.InitialShowDelay" Value="{Binding CliTooltipDelayMs}" />
                    <Setter Property="mc:MaCallout.ToolTip" Value="{Binding}" />
                    <Setter Property="mc:MaCallout.ToolTipTemplate" Value="{StaticResource LoginHoverTipTemplate}" />
                    <Setter Property="mc:MaCallout.Placement" Value="Right" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding TabTip}" />
                </Style>
            </mc:MaTabControl.ItemContainerStyle>
            <mc:MaTabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <StackPanel x:Name="LoginTabItem" Orientation="Horizontal">
                        <Grid x:Name="TabStatusIcon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource SpaceRS}">
                            <!-- Idle, or every open CLI has stopped (M.ORCH-T890): a gray box, "zzz" (M.ORCH-T1173). A fixed Grid
                                 size (M.ORCH-T1206, 20x20 M.ORCH-T1272) reserves one consistent footprint across tabs: each badge
                                 still renders at its own natural size (FontSize tuned per symbol), centered, so the tab strip
                                 doesn't jitter width or height depending on which one a tab happens to be showing. -->
                            <mc:MaBadge x:Name="TabIdleBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="zzz" Background="{DynamicResource MaMuted}"
                                        Foreground="{DynamicResource MaOnAccent}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                        Visibility="{Binding ShowsIdleBadge, Converter={StaticResource Visible}}" />
                            <!-- Busy: a green box with the library's own spinner (M.ORCH-T1270, in place of the open CLI count
                                 badge from M.ORCH-T890/M.ORCH-T1261); the count stays in the tooltip/accessible name (TabActivityWord).
                                 The original ring, sized to three arcs (M.ORCH-T1414): its dash is 6 on, 4 off in stroke widths, so a
                                 14px ring needs a 1.327px stroke for its circumference, pi x (14 - 1.327), to hold exactly three. -->

                            <mc:MaBadge x:Name="TabBusyBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                        Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding TabActivityWord}"
                                        Visibility="{Binding ShowsBusyBadge, Converter={StaticResource Visible}}">
                                <!-- Inside the ring, how many of this person's CLIs are thinking plus their running subagents
                                     (M.ORCH-T1447), so handing them more work is an informed choice; hidden while nothing thinks.
                                     The count comes from the agent board the refresh already reads, in words for screen readers. -->
                                <Grid>
                                    <mc:MaSpinner Kind="Ring" Width="14" Height="14" StrokeThickness="1.327" Stroke="{DynamicResource MaOnAccent}" />
                                    <TextBlock x:Name="TabThinkingCount" Text="{Binding TabThinkingCountText}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource MaOnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabThinkingWord}"
                                               Visibility="{Binding ShowsTabThinkingCount, Converter={StaticResource Visible}}" />
                                </Grid>
                            </mc:MaBadge>
                            <!-- One of this person's CLIs is genuinely blocked on them (a permission prompt, a question, or a
                                 /crossrepo or /allocate only they may type, M.ORCH-T790): an orange box, over the idle or busy box
                                 above while it's true, a plain "?" (M.ORCH-T1270, in place of the M.ORCH-T1261 count/? flash). -->
                            <mc:MaBadge x:Name="TabAskingBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="?" Background="{DynamicResource MaWarn}"
                                        Foreground="{DynamicResource MaOnAccent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        mc:MaCallout.ToolTip="{Binding TabNeedsYouTip}" AutomationProperties.Name="Blocked waiting on you"
                                        Visibility="{Binding TabNeedsYou, Converter={StaticResource Visible}}" />
                            <TextBlock x:Name="TabDisabledIcon" Text="{Binding TabDisabledGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource MaMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                       Visibility="{Binding IsTabDisabled, Converter={StaticResource Visible}}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TabFaceTitle}" FontWeight="SemiBold" />
                            <!-- Signed in as another account (M.ORCH-T1954): the same warning as the tree node's. -->
                            <TextBlock Text="{Binding WrongAccountLine}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}"
                                       Visibility="{Binding WrongAccountLine, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                        </StackPanel>
                        <!-- This login's own menu, reachable with a tap or a left click (M.ORCH-T1793): the exact same menu the
                             tab's own right-click opens (OnLoginTabContextMenu), the flat strip's twin of the tree header's own
                             LoginTreeMoreButton above. -->
                        <Button x:Name="LoginTabMoreButton" Style="{StaticResource MaToolButton}" Content="&#xE712;" Margin="{StaticResource SpaceLS}"
                                Click="LoginTabMoreButton_Click"
                                mc:MaCallout.ToolTip="Open Project, Run Launcher, User Settings, Change Color"
                                AutomationProperties.Name="{Binding TabTitle, StringFormat='More actions for {0}'}"
                                Visibility="{Binding IsPersonTab, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DataTemplate>
            </mc:MaTabControl.ItemTemplate>
        </mc:MaTabControl>
        </ScrollViewer>
        <!-- The collapsible tree sidebar (M.ORCH-T1759, TreeMenuLayout, default on, in place of LoginTabScroller above): each
             login a node with a chevron that expands to its own open CLI/Launcher panes, so the CLI tab bar
             (TerminalsPanel) stays hidden and AgentsBody spans the whole right side (its Grid.Row/RowSpan, bound to
             TreeMenuLayout via Converters.BodyRow/BodyRowSpan, further down). Only the selected login starts expanded
             (MainViewModel.IsExpanded, forced true by Select); the chevron alone toggles it, never selection, so another
             login's panes can be peeked at without leaving the one shown. Clicking the login's own header row toggles it
             (M.ORCH-T1877: on release, never after a drag; collapsing it, or selecting and opening it, showing its
             Usage), which is why there's no separate nested Usage row among the children below any more (M.ORCH-T1768: it
             was left over from before that header click did this, so it was redundant - removed, not merely hidden, by
             binding straight to Terminals.Panes instead of Terminals.StripItems, which still carries the pinned Usage
             marker for the flat strip below). v1 scope (not asked for, and the flat strip above keeps them): no
             drag-reorder, no rename-in-place, no per-pane close button here; switch the setting off for those. -->
        <ScrollViewer x:Name="LoginTreeScroller" Grid.Row="1" Style="{StaticResource MaBodyScroll}" mc:MaScrollArea.Gutter="0"
                      MaxHeight="{Binding ActualHeight, ElementName=TopRow, Converter={x:Static vm:Converters.Share}, ConverterParameter=0.5}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowsLoginTree, Converter={StaticResource Visible}}">
        <ItemsControl x:Name="LoginTree" Style="{StaticResource MaList}" ItemsSource="{Binding OrgTabs}"
                      DragOver="LoginTree_DragOver" Drop="LoginTree_Drop"
                      AutomationProperties.Name="Claude logins, each expanding to its open CLI panes">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <!-- The login's colour stripe runs the whole height of its tree, header and open panes alike
                         (M.ORCH-T1812, the owner's mockup), so it sits beside both rather than in the header alone.
                         Its bottom margin is the Vault's LoginTreeGutterPx (M.ORCH-T1824, the owner's mockup, default
                         10px), not a hardcoded 2px: a real gutter between one person's whole section and the next's,
                         rather than the same small gap every sibling row inside a section already has. -->
                    <Grid x:Name="LoginTreeNode" Margin="{Binding LoginTreeGutter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource MaAccentBar}" Width="3" CornerRadius="0" SnapsToDevicePixels="False"
                                Background="{Binding TabBrush}" Margin="0,2,6,2" />
                    <StackPanel Grid.Column="1">
                        <Grid x:Name="LoginTreeHeader" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="LoginTreeHeader_MouseLeftButtonDown"
                              MouseLeftButtonUp="LoginTreeHeader_MouseLeftButtonUp"
                              ContextMenuOpening="LoginTreeHeader_ContextMenuOpening"
                              ToolTipService.InitialShowDelay="{Binding CliTooltipDelayMs}" mc:MaCallout.ToolTip="{Binding}" mc:MaCallout.ToolTipTemplate="{StaticResource LoginHoverTipTemplate}" AutomationProperties.Name="{Binding TabTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The hover highlight (M.ORCH-T1891, Ryan: "not sure whats highlighted when I mouse over"): the
                                 library's own MaShapeBorder (M.ORCH-T1893: a plain Border isn't library-styled) with its MaHover
                                 fill, behind the row's content, shown only while the mouse is over this header (LoginTreeHeader,
                                 the Grid this template names above). Drawn first so the selected login's own highlight just below
                                 still wins where the two overlap. -->
                            <mc:MaShapeBorder Grid.ColumnSpan="5" Fill="{DynamicResource MaHover}" Margin="0" SnapsToDevicePixels="False"
                                    Visibility="{Binding IsMouseOver, ElementName=LoginTreeHeader, Converter={StaticResource Visible}}" />
                            <!-- The selected login's highlight: the library's MaChromeBorder fill (MaDivider, sized to the whole
                                 row) behind the row's content, shown only for the selected login. -->
                            <Border Grid.ColumnSpan="5" Style="{StaticResource MaDivider}" Height="Auto" Margin="0" SnapsToDevicePixels="False"
                                    Visibility="{Binding IsTabSelected, Converter={StaticResource Visible}}" />
                            <!-- The expand/collapse chevron alone (M.ORCH-T1759): its own click is marked handled so it never
                                 also selects this login via the header's handler above it in the visual tree. Collapsed, not
                                 merely hidden, on a login with nothing to expand into (M.ORCH-T1824, e.g. the API key's row,
                                 which has no CLI/Launcher panes of its own): Terminals.HasPanes, so the row never offers to
                                 open a node with no children, and its Auto column drops to 0 width, letting the name column
                                 shift left to fill the gap rather than leaving a blank chevron-sized hole. -->
                            <TextBlock Grid.Column="1" Text="{Binding IsExpanded, Converter={x:Static vm:Converters.Chevron}}" Width="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                       Visibility="{Binding Terminals.HasPanes, Converter={StaticResource Visible}}"
                                       MouseLeftButtonDown="LoginTreeChevron_MouseLeftButtonDown" />
                            <!-- The name has its own column and trims with an ellipsis (M.ORCH-T1812): it used to share
                                 one with the usage bars, so in a narrow sidebar the two drew over each other. -->
                            <DockPanel Grid.Column="2" Margin="{StaticResource SpaceLS}">
                                <!-- The same status-at-a-glance badges as the flat strip's own header (M.ORCH-T630/757/1173/1261/1270),
                                     copied rather than shared: that template is inline in LoginTabStrip's ItemTemplate above, not a
                                     keyed resource, and must stay exactly as it is for the flat layout. -->
                                <Grid x:Name="TreeTabStatusIcon" DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource SpaceRS}">
                                    <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="zzz" Background="{DynamicResource MaMuted}"
                                                Foreground="{DynamicResource MaOnAccent}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                                Visibility="{Binding ShowsIdleBadge, Converter={StaticResource Visible}}" />
                                    <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                                Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding TabActivityWord}"
                                                Visibility="{Binding ShowsBusyBadge, Converter={StaticResource Visible}}">
                                        <Grid>
                                            <mc:MaSpinner Kind="Ring" Width="14" Height="14" StrokeThickness="1.327" Stroke="{DynamicResource MaOnAccent}" />
                                            <TextBlock Text="{Binding TabThinkingCountText}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource MaOnAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabThinkingWord}"
                                                       Visibility="{Binding ShowsTabThinkingCount, Converter={StaticResource Visible}}" />
                                        </Grid>
                                    </mc:MaBadge>
                                    <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="?" Background="{DynamicResource MaWarn}"
