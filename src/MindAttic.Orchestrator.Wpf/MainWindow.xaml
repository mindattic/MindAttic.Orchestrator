<Window x:Class="MindAttic.Orchestrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
        xmlns:local="clr-namespace:MindAttic.Orchestrator.Wpf"
        mc:MaWindow.ThemedTitleBar="True"
        Title="MindAttic Orchestrator" Width="1480" Height="920" MinWidth="320" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/logo.ico"
        Background="{DynamicResource MaChrome}" Foreground="{DynamicResource MaText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Escape" Command="{x:Static vm:WindowCommands.Escape}" />
        <!-- The next and the previous login's tab (M.ORCH-T613). -->
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <!-- The next and the previous CLI (Terminal) tab of the shown login's (M.ORCH-T824): works even while a terminal
             holds keyboard focus, since plain Left/Right there move the CLI's own cursor instead of the tab strip's selection. -->
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding Terminals.PreviousCommand}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding Terminals.NextCommand}" />
        <!-- Ctrl+Plus / Ctrl+Minus / Ctrl+0 (main row and number pad) are the library's ZoomLevel's, added in MainWindow.xaml.cs.
             While a terminal holds focus only F5, Ctrl+Tab, Ctrl+Shift+Tab, Ctrl+Left/Right (and the paste keys) act
             (M.ORCH-T846): every other binding here (Esc, the zoom keys) is gated so its key reaches the CLI. -->

    </Window.InputBindings>

    <Window.Resources>
        <!-- A ticket id: a link that opens the ticket in Tickets Desktop to view, approve, prioritize or close it (M.ORCH-T500).
             Its CommandParameter is the id. The library's MaHyperlink (MaLink, SemiBold, underlined on hover and keyboard focus,
             so it reads as a link without colour), plus the command and tooltip. -->
        <Style x:Key="TicketLink" TargetType="Hyperlink" BasedOn="{StaticResource MaHyperlink}">
            <Setter Property="Command" Value="{Binding DataContext.OpenInTicketsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ToolTip" Value="{DynamicResource TicketLinkCallout}" />
        </Style>
        <!-- The TicketLink's tooltip as the library's callout (M.ORCH-T1552). A Hyperlink isn't a FrameworkElement, so
             mc:MaCallout.ToolTip can't reach it: the callout itself is its ToolTip, a fresh one per link (x:Shared). -->
        <mc:MaCalloutToolTip x:Key="TicketLinkCallout" x:Shared="False" Content="Open it in Tickets Desktop to view, approve, prioritize, assign, block or close it" />


        <!-- The login tab strip's own sigma/lambda bars (M.ORCH-T1536), the same pair as the pinned Usage tab's own header,
             but in MaTabItem.TrailingContent rather than the Header (M.COMP-T172): Trailing/TrailingContent dock to the
             strip's trailing edge in TabStripPlacement="Left" the way the header never does, so this is what actually gets
             the bars right-aligned, where embedding them in the Header DataTemplate (M.ORCH-T1532's first cut) could not.
             Hidden per row by its own root Visibility (ShowsTabUsageBars) exactly as before; TrailingContent itself is
             always set ({Binding}, the login's own MainViewModel), so the trigger that collapses PART_TrailingContent on a
             null TrailingContent never fires here - this is what hides it instead. The lambda pair collapses on its own
             (ShowsFiveHourChart, M.ORCH-T1540) for a solo Ultra login, which has no 5-hour window to show. -->
        <!-- A person's hover tooltip (M.ORCH-T1814, M.COMP-T193's MaCallout.ToolTipTemplate): the text the tooltip always
             had (figures, resets, cutoffs, active CLIs). Its 5-hour chart thumbnail is gone (M.ORCH-T1887): nobody ever saw
             it, so the chart lives under each CLI's terminal instead (TerminalUsageChart). The tooltip isn't in the row's
             visual tree, so this binds to the tooltip's own value: the login's MainViewModel. -->
        <DataTemplate x:Key="LoginHoverTipTemplate" DataType="{x:Type vm:MainViewModel}">
            <TextBlock Text="{Binding TabHoverTip}" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="LoginUsageBarsTemplate" DataType="{x:Type vm:MainViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowsTabUsageBars, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding UsageSigmaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" />
                <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                             Margin="{StaticResource SpaceLXS}" Value="{Binding WeeklyLimitPercent, Mode=OneWay}"
                             Foreground="{Binding WeeklyLimitBrush}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowsFiveHourChart, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding UsageLambdaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                    <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                                 Margin="{StaticResource SpaceLXS}" Value="{Binding FiveHourLimitPercent, Mode=OneWay}"
                                 Foreground="{Binding FiveHourLimitBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The menu bar (row 0, M.ORCH-T1499) is the window's own fixed top strip. The login tabs (row 1) and the CLI tab bar
             (row 2, TerminalsPanel) are the other fixed rows (M.ORCH-T1302): you always see who's selected and which CLI is
             shown. Everything else - the chosen terminal, the 5-hour chart right after it, the stats, the 5-hour chart and
             Tickets - lives in AgentsBody (row 3), one scrolling panel, so scrolling down past the terminal reaches the rest.
             The status bar (row 5) stays its own fixed footer, as it always was, with this host's held-work notices at its
             right end (its drive and RAM bars are the sidebar's This PC panel, M.ORCH-T2177). Row 4 is empty since the icon strip that sat there (M.ORCH-T1872) went (M.ORCH-T2101). -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The login tabs are a sidebar on the left (M.ORCH-T1431): column 0 holds who, column 1 their CLIs and body. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- One dashboard tab per Claude login (M.ORCH-T613): the global ~/.claude login first, then each per-CLI login under
             ~/.claude-accounts, by its name (M.ORCH-T614, its email in the tooltip) and its terminal tabs' color (M.ORCH-T616),
             with how many of its repos need you. Everything below is the chosen login's: the window shows that tab's view model
             (MainWindow.xaml.cs sets its DataContext), and this strip keeps the global login's tab's, which holds every tab.
             Shown once there's a second login; Ctrl+Tab and Ctrl+Shift+Tab step through them. Its own row above the header,
             so the header, chart and view pills can fold away on a tab while the strip stays. -->
        <!-- Dark (the default) or light, every view following at once (ThemeChoice, M.ORCH-T678): no switch of its own in this
             window any more (M.ORCH-T1512, it wasn't used often enough to earn a permanent icon), set instead from
             MindAttic.Vault.Desktop's Orchestrator settings page. This window only applies the saved choice at start
             (App.xaml.cs) and follows a change made there live (ThemeChoice.Follow, MainWindow.xaml.cs). -->
        <!-- No emergency billing toggle any more (M.ORCH-T906, which replaced M.ORCH-T770's): the Vault's API key is a person
             with its own tab in the strip below, its own Launcher and CLIs billing API credits; orchestrator billing stays the
             command-line tool. -->
        <!-- The window's menu bar (M.ORCH-T2100): the top line, full width, a normal menu of labeled dropdowns, the only home
             of the window's tools since the icon strip went (M.ORCH-T2101). Each top-level label opens its dropdown
             (MainMenu_Click builds it from the library's MaDropdownMenu/MaDropdownMenuItem, MainWindow.MainMenu.cs). The
             phone layout keeps it, with the drawer button first (MainWindow.Compact.cs shows PhonePickers). -->
        <StackPanel x:Name="MainMenuBar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4,2,4,2"
                    AutomationProperties.Name="Menu bar">
            <!-- The phone layout's menu button (M.ORCH-T1568, M.ORCH-T1571): it opens the sidebar itself as a drawer (M.ORCH-T1570:
                 orgs, every person with their badges and right-click menu, their ticket cards), which is why the person picker
                 that used to sit beside it is gone (M.ORCH-T1815). Collapsed on the desktop. -->
            <Grid x:Name="PhonePickers" Visibility="Collapsed" VerticalAlignment="Center" Margin="{StaticResource SpaceRS}">
                <Button x:Name="DrawerButton" Style="{StaticResource MaToolButton}" Content="&#xE700;" Click="DrawerButton_Click"
                        mc:MaCallout.ToolTip="People, organizations and their tickets" AutomationProperties.Name="Show people and tickets" />
            </Grid>
            <Button Style="{StaticResource MaTextButton}" Content="Dashboard" Tag="Dashboard" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Dashboard menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Projects" Tag="Projects" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Projects menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Git" Tag="Git" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Git menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Settings" Tag="Settings" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Settings menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Launcher" Tag="Launcher" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Launcher menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Backup &amp; Restore" Tag="Backup" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Backup and Restore menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Azure" Tag="Azure" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Azure menu" />
            <Button Style="{StaticResource MaTextButton}" Content="Shells" Tag="Shells" Click="MainMenu_Click" Background="Transparent" Padding="10,4" Margin="0" AutomationProperties.Name="Shells menu" />
        </StackPanel>
        <!-- Top-aligned with a star middle row (M.ORCH-T1431): the tools sit right under the last login, and a list too long for
             the window scrolls on its own rather than pushing the tools off the bottom. Its top matches the CLI tab bar's. -->
        <Border x:Name="Sidebar" Style="{StaticResource MaSidePane}" Grid.Row="1" Grid.RowSpan="4" Grid.Column="0" MinWidth="170"
                BorderBrush="{DynamicResource MaChromeBorder}" BorderThickness="0,0,1,0" Padding="12,0,12,8"
                AutomationProperties.Name="People and window tools">
        <!-- The sidebar's sections are titled MaPanels in an MaPanelGroup (M.ORCH-T2176): Organizations, Users, This PC
             (M.ORCH-T2177), then Tickets,
             each collapsible and drag-reorderable by its header's grip, each with a stable PanelKey for the saved order and
             collapse state. Users takes its desired height; Tickets fills whatever height is left and scrolls on its own
             (M.ORCH-T1439), and only while expanded, so a collapsed Tickets shrinks to its header. The window tools' own row
             (M.ORCH-T1431) moved up into the window's menu bar (M.ORCH-T1499). One left edge (M.ORCH-T2178): MaPanelInset is
             re-keyed here with no left step, so every panel's header row, rule and content (org pills, login rows, This PC
             bars, the nested ticket panels' headers and cards, which take MaPanelNestedInset's 0) start at the same x; the
             first header's own top margin is the sidebar's top gap. -->
        <Border.Resources>
            <Thickness x:Key="MaPanelInset">0,6,0,10</Thickness>
        </Border.Resources>
        <mc:MaPanelGroup x:Name="TopRow">
        <!-- Roadmap (M.ORCH-T2384): one row for every repo's open work, its overall percent and how many milestones are active;
             clicking it shows the Roadmap page in the main area in place of the terminal. -->
        <mc:MaPanel x:Name="RoadmapPanel" Title="Roadmap" IsCollapsible="True" mc:MaPanelGroup.PanelKey="roadmap" mc:MaPanelGroup.IsDraggable="True">
            <Button Style="{StaticResource MaTextButton}" Command="{Binding ShowRoadmapCommand}" HorizontalContentAlignment="Stretch"
                    Padding="{StaticResource SpaceHSVXS}" Margin="0" mc:MaCallout.ToolTip="Show every repo's milestone, epics, features and tasks"
                    AutomationProperties.Name="{Binding Roadmap.SummaryText, StringFormat='Roadmap, all repos: {0}'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="All repos" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource MaProgressBar}" Height="5" VerticalAlignment="Center"
                                 Margin="{StaticResource SpaceLS}" Value="{Binding Roadmap.OverallPercent, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Roadmap.SummaryText}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center"
                               Margin="{StaticResource SpaceLS}" />
                </Grid>
            </Button>
        </mc:MaPanel>
        <!-- Organizations above people (M.ORCH-T655): one pill per org (orchestrator orgs add), shown once there's a second,
             with how many of its people's repos need you; the person tabs below are the chosen org's. Kept on the global login's
             tab (MainWindow.xaml.cs), which holds every org, like the person strip under it; the panel shows and hides with it. -->
        <mc:MaPanel Title="Organizations" IsCollapsible="True" mc:MaPanelGroup.PanelKey="orgs" mc:MaPanelGroup.IsDraggable="True"
                    Visibility="{Binding Visibility, ElementName=OrgStrip}">
        <ListBox x:Name="OrgStrip" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}"
                 Padding="0" AutomationProperties.Name="Organizations, each with its own people"
                 Visibility="{Binding HasOrgs, Converter={StaticResource Visible}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OrgViewModel}">
                    <StackPanel x:Name="OrgItem" Orientation="Horizontal" mc:MaCallout.ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                        <TextBlock VerticalAlignment="Center" Margin="{StaticResource SpaceLS}"
                                   Visibility="{Binding Badge, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <Run Text="&#x2022; " /><Run Text="{Binding Badge, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" need you" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </mc:MaPanel>
        <!-- The org-wide login actions (Add login, Sign in all, Report) moved from here into Settings' Logins tab (M.ORCH-T804). -->
        <!-- Users: the flat login strip or the login tree, whichever TreeMenuLayout shows, each capped at half the sidebar. -->
        <mc:MaPanel Title="Users" IsCollapsible="True" mc:MaPanelGroup.PanelKey="users" mc:MaPanelGroup.IsDraggable="True">
        <Grid>
        <!-- A vertical sidebar (M.ORCH-T1431, in place of M.ORCH-T822's horizontal scroller and its < > arrows): one row per
             login, each as wide as the column (the strip's own TabPanel stretches them, so no code-behind sizing any more). -->
        <ScrollViewer x:Name="LoginTabScroller" Style="{StaticResource MaBodyScroll}" mc:MaScrollArea.Gutter="0"
                      MaxHeight="{Binding ActualHeight, ElementName=TopRow, Converter={x:Static vm:Converters.Share}, ConverterParameter=0.5}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowsFlatLoginStrip, Converter={StaticResource Visible}}">
        <mc:MaTabControl x:Name="LoginTabStrip" ShowContent="False" TabStripPlacement="Left" ItemsSource="{Binding OrgTabs}" SelectedItem="{Binding StripSelection}"
                         AutomationProperties.Name="Claude logins, one dashboard tab each"
                         ContextMenuOpening="OnLoginTabContextMenu">
            <!-- Status at a glance (M.ORCH-T630), all the library's MaTabItem (M.ORCH-T667): a status badge before the name
                 (M.ORCH-T757, boxed M.ORCH-T1173, in place of the status light): a gray box with a tiny "zzz" while the login has
                 no CLI open or every one of its open CLIs (hosted inside the Orchestrator's Terminals panel or outside it) has
                 stopped (M.ORCH-T890); a green box with its open CLI count while any of them is working (M.ORCH-T1261); an orange
                 box flashing between that count and "?" when one of them is genuinely blocked on the person (what used to be a
                 separate trailing flag, M.ORCH-T790, then a static "?", M.ORCH-T1261), which wins over idle or busy when both are
                 true; a gray 'disabled' icon (its own glyph, unboxed), a small lock
                 past its 5-hour or weekly cutoff while still signed in (the tab stays put and clickable, only held back from
                 new work), or the old blocked glyph while it's actually unusable (signed out, M.ORCH-T1254). Every badge's word
                 is in the tooltip and the accessible name, so neither
                 colour nor the picture is the only cue; the person's terminal colour is the tab's accent, and its trailing text
                 their live weekly and 5-hour use against their own cutoffs, "Σ: 15% | λ: 29%" (M.ORCH-T793/T968/T1251, cutoffs in
                 the tooltip; no 'N need you' count, no '% left'). -->
            <!-- The API key is a person here like any other (M.ORCH-T906): its tab comes after everyone's, its trailing text its
                 money ("$37.66 left") rather than 5-hour and weekly use. -->
            <mc:MaTabControl.ItemContainerStyle>
                <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                    <Setter Property="Accent" Value="{Binding TabBrush}" />
                    <!-- The plain percent figures ("Σ: 15% | λ: 29%") move to the tooltip (M.ORCH-T1532): the bars at the
                         strip's trailing edge below show them instead, so Trailing only still carries text for the cases a
                         bar can't say (unsigned, the API key's money, "sign in again", "stale · read Xh ago" -
                         TabTrailingFace). -->
                    <Setter Property="Trailing" Value="{Binding TabTrailingFace}" />
                    <!-- Right-aligned (M.ORCH-T1536, M.COMP-T172): TrailingContent docks exactly where Trailing does, which
                         in TabStripPlacement="Left" (the control's own template) is the strip's trailing edge - the Header
                         DataTemplate below never gets that treatment, so the bars couldn't live there. Always set; the
                         template's own root hides itself per row (ShowsTabUsageBars). -->
                    <Setter Property="TrailingContent" Value="{Binding}" />
                    <Setter Property="TrailingContentTemplate" Value="{StaticResource LoginUsageBarsTemplate}" />
                    <!-- A callout pointing at the sidebar (M.ORCH-T1441): its arrow touches the tab's right edge, and it flips, or slides
                         up or down, to stay on the tab's monitor (the library's MaCallout, M.COMP-T167). Its figures show up
                         with no more than CliTooltipDelayMs's wait (M.ORCH-T1532, M.ORCH-T1823: a Vault setting in place of the
                         old hardcoded 0 - ToolTipService's own delay on the owning tab, since MaCalloutToolTip is still a plain
                         ToolTip underneath, so that delay still governs it) to read a login's usage. -->
                    <Setter Property="ToolTipService.InitialShowDelay" Value="{Binding CliTooltipDelayMs}" />
                    <Setter Property="mc:MaCallout.ToolTip" Value="{Binding}" />
                    <Setter Property="mc:MaCallout.ToolTipTemplate" Value="{StaticResource LoginHoverTipTemplate}" />
                    <Setter Property="mc:MaCallout.Placement" Value="Right" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding TabTip}" />
                </Style>
            </mc:MaTabControl.ItemContainerStyle>
            <mc:MaTabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <StackPanel x:Name="LoginTabItem" Orientation="Horizontal">
                        <Grid x:Name="TabStatusIcon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource SpaceRS}">
                            <!-- Idle, or every open CLI has stopped (M.ORCH-T890): a gray box, "zzz" (M.ORCH-T1173). A fixed Grid
                                 size (M.ORCH-T1206, 20x20 M.ORCH-T1272) reserves one consistent footprint across tabs: each badge
                                 still renders at its own natural size (FontSize tuned per symbol), centered, so the tab strip
                                 doesn't jitter width or height depending on which one a tab happens to be showing. -->
                            <mc:MaBadge x:Name="TabIdleBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="zzz" Background="{DynamicResource MaMuted}"
                                        Foreground="{DynamicResource MaOnAccent}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                        Visibility="{Binding ShowsIdleBadge, Converter={StaticResource Visible}}" />
                            <!-- Busy: a green box with the library's own spinner (M.ORCH-T1270, in place of the open CLI count
                                 badge from M.ORCH-T890/M.ORCH-T1261); the count stays in the tooltip/accessible name (TabActivityWord).
                                 The original ring, sized to three arcs (M.ORCH-T1414): its dash is 6 on, 4 off in stroke widths, so a
                                 14px ring needs a 1.327px stroke for its circumference, pi x (14 - 1.327), to hold exactly three. -->

                            <mc:MaBadge x:Name="TabBusyBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                        Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding TabActivityWord}"
                                        Visibility="{Binding ShowsBusyBadge, Converter={StaticResource Visible}}">
                                <!-- Inside the ring, how many of this person's CLIs are thinking plus their running subagents
                                     (M.ORCH-T1447), so handing them more work is an informed choice; hidden while nothing thinks.
                                     The count comes from the agent board the refresh already reads, in words for screen readers. -->
                                <Grid>
                                    <mc:MaSpinner Kind="Ring" Width="14" Height="14" StrokeThickness="1.327" Stroke="{DynamicResource MaOnAccent}" />
                                    <TextBlock x:Name="TabThinkingCount" Text="{Binding TabThinkingCountText}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource MaOnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabThinkingWord}"
                                               Visibility="{Binding ShowsTabThinkingCount, Converter={StaticResource Visible}}" />
                                </Grid>
                            </mc:MaBadge>
                            <!-- One of this person's CLIs is genuinely blocked on them (a permission prompt, a question, or a
                                 /crossrepo or /allocate only they may type, M.ORCH-T790): an orange box, over the idle or busy box
                                 above while it's true, a plain "?" (M.ORCH-T1270, in place of the M.ORCH-T1261 count/? flash). -->
                            <mc:MaBadge x:Name="TabAskingBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="?" Background="{DynamicResource MaWarn}"
                                        Foreground="{DynamicResource MaOnAccent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        mc:MaCallout.ToolTip="{Binding TabNeedsYouTip}" AutomationProperties.Name="Blocked waiting on you"
                                        Visibility="{Binding TabNeedsYou, Converter={StaticResource Visible}}" />
                            <!-- Locked (M.ORCH-T2119): a red box, over the idle or busy box above the same way the asking box is, a
                                 padlock emoji so it never reads as the same glyph as the small past-cutoff lock the disabled icon
                                 below already shows (TabDisabledGlyph, M.ORCH-T1254) - that one means merely past a cutoff; this
                                 one means the login can't open a CLI or take work at all until it's unlocked again. -->
                            <mc:MaBadge x:Name="TabLockedBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="&#x1F512;" Background="{DynamicResource MaBad}"
                                        Foreground="{DynamicResource MaOnAccent}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                        Visibility="{Binding ShowsLockedBadge, Converter={StaticResource Visible}}" />
                            <TextBlock x:Name="TabDisabledIcon" Text="{Binding TabDisabledGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource MaMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                       Visibility="{Binding ShowsDisabledIcon, Converter={StaticResource Visible}}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TabFaceTitle}" FontWeight="SemiBold" />
                            <!-- Signed in as another account (M.ORCH-T1954): the same warning as the tree node's. -->
                            <TextBlock Text="{Binding WrongAccountLine}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}"
                                       Visibility="{Binding WrongAccountLine, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                        </StackPanel>
                        <!-- This login's own menu, reachable with a tap or a left click (M.ORCH-T1793): the exact same menu the
                             tab's own right-click opens (OnLoginTabContextMenu), the flat strip's twin of the tree header's own
                             LoginTreeMoreButton above. -->
                        <Button x:Name="LoginTabMoreButton" Style="{StaticResource MaToolButton}" Content="&#xE712;" Margin="{StaticResource SpaceLS}"
                                Click="LoginTabMoreButton_Click"
                                mc:MaCallout.ToolTip="Open Project, Run Launcher, User Settings, Change Color"
                                AutomationProperties.Name="{Binding TabTitle, StringFormat='More actions for {0}'}"
                                Visibility="{Binding IsPersonTab, Converter={StaticResource Visible}}" />
                        <!-- "+ Add" (M.ORCH-T1964), at the end of every login row: opens the Open Project window (General
                             Prompt, Run Launcher, or a project from the tree), in place of hovering Open Project's own
                             cascading submenu in the "⋯" menu above. Disabled, not hidden, while signed out - same gate
                             as the old menu's root item - so it's still there to explain why. -->
                        <Button x:Name="LoginTabAddButton" Style="{StaticResource MaToolButton}" Content="+ Add" FontFamily="Segoe UI" FontSize="12"
                                Width="56" Margin="{StaticResource SpaceLS}" Click="AddTabButton_Click"
                                IsEnabled="{Binding CanAddCli}" ToolTipService.ShowOnDisabled="True"
                                mc:MaCallout.ToolTip="{Binding AddCliLockedTip, TargetNullValue='Open a CLI: General Prompt, Run Launcher, or a project from the tree'}"
                                AutomationProperties.Name="{Binding TabTitle, StringFormat='Open a new CLI for {0}'}"
                                Visibility="{Binding IsPersonTab, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DataTemplate>
            </mc:MaTabControl.ItemTemplate>
        </mc:MaTabControl>
        </ScrollViewer>
        <!-- The collapsible tree sidebar (M.ORCH-T1759, TreeMenuLayout, default on, in place of LoginTabScroller above): each
             login a node with a chevron that expands to its own open CLI/Launcher panes, so the CLI tab bar
             (TerminalsPanel) stays hidden and AgentsBody spans the whole right side (its Grid.Row/RowSpan, bound to
             TreeMenuLayout via Converters.BodyRow/BodyRowSpan, further down). Only the selected login starts expanded
             (MainViewModel.IsExpanded, forced true by Select); the header row's own click toggles it too now
             (M.ORCH-T1877/T2238: on release, never after a drag), the exact same thing the chevron does - there's no
             per-login home page left to select into, so a click here is never anything but expand/collapse. The children
             bind straight to Terminals.Panes (M.ORCH-T1768). v1 scope (not asked for, and the flat strip above keeps
             them): no drag-reorder, no rename-in-place, no per-pane close button here; switch the setting off for those. -->
        <ScrollViewer x:Name="LoginTreeScroller" Style="{StaticResource MaBodyScroll}" mc:MaScrollArea.Gutter="0"
                      MaxHeight="{Binding ActualHeight, ElementName=TopRow, Converter={x:Static vm:Converters.Share}, ConverterParameter=0.5}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowsLoginTree, Converter={StaticResource Visible}}">
        <ItemsControl x:Name="LoginTree" Style="{StaticResource MaList}" ItemsSource="{Binding OrgTabs}"
                      DragOver="LoginTree_DragOver" Drop="LoginTree_Drop"
                      AutomationProperties.Name="Claude logins, each expanding to its open CLI panes">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <!-- The login's colour stripe runs the whole height of its tree, header and open panes alike
                         (M.ORCH-T1812, the owner's mockup), so it sits beside both rather than in the header alone.
                         Its bottom margin is the Vault's LoginTreeGutterPx (M.ORCH-T1824, the owner's mockup, default
                         10px), not a hardcoded 2px: a real gutter between one person's whole section and the next's,
                         rather than the same small gap every sibling row inside a section already has. -->
                    <Grid x:Name="LoginTreeNode" Margin="{Binding LoginTreeGutter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource MaAccentBar}" Width="3" CornerRadius="0" SnapsToDevicePixels="False"
                                Background="{Binding TabBrush}" Margin="0,2,6,2" />
                    <StackPanel Grid.Column="1">
                        <Grid x:Name="LoginTreeHeader" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="LoginTreeHeader_MouseLeftButtonDown"
                              MouseLeftButtonUp="LoginTreeHeader_MouseLeftButtonUp"
                              ContextMenuOpening="LoginTreeHeader_ContextMenuOpening"
                              ToolTipService.InitialShowDelay="{Binding CliTooltipDelayMs}" mc:MaCallout.ToolTip="{Binding}" mc:MaCallout.ToolTipTemplate="{StaticResource LoginHoverTipTemplate}" AutomationProperties.Name="{Binding TabTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The hover highlight (M.ORCH-T1891, Ryan: "not sure whats highlighted when I mouse over"): the
                                 library's own MaShapeBorder (M.ORCH-T1893: a plain Border isn't library-styled) with its MaHover
                                 fill, behind the row's content, shown only while the mouse is over this header (LoginTreeHeader,
                                 the Grid this template names above). Drawn first so the selected login's own highlight just below
                                 still wins where the two overlap. -->
                            <mc:MaShapeBorder Grid.ColumnSpan="5" Fill="{DynamicResource MaHover}" Margin="0" SnapsToDevicePixels="False"
                                    Visibility="{Binding IsMouseOver, ElementName=LoginTreeHeader, Converter={StaticResource Visible}}" />
                            <!-- The selected login's highlight: the library's MaChromeBorder fill (MaDivider, sized to the whole
                                 row) behind the row's content, shown only for the selected login. -->
                            <Border Grid.ColumnSpan="5" Style="{StaticResource MaDivider}" Height="Auto" Margin="0" SnapsToDevicePixels="False"
                                    Visibility="{Binding IsTabSelected, Converter={StaticResource Visible}}" />
                            <!-- The expand/collapse chevron alone (M.ORCH-T1759): its own click is marked handled so it never
                                 also selects this login via the header's handler above it in the visual tree. Collapsed, not
                                 merely hidden, on a login with nothing to expand into (M.ORCH-T1824): every person's node
                                 always has at least its "+ Add" leaf (LoginTreeAddLeaf, M.ORCH-T2104), so IsPersonTab; otherwise
                                 its Auto column drops to 0 width, letting the name column shift left rather than leaving a hole. -->
                            <TextBlock Grid.Column="1" Text="{Binding IsExpanded, Converter={x:Static vm:Converters.Chevron}}" Width="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                       Visibility="{Binding IsPersonTab, Converter={StaticResource Visible}}"
                                       MouseLeftButtonDown="LoginTreeChevron_MouseLeftButtonDown" />
                            <!-- The name has its own column and trims with an ellipsis (M.ORCH-T1812): it used to share
                                 one with the usage bars, so in a narrow sidebar the two drew over each other. -->
                            <DockPanel Grid.Column="2" Margin="{StaticResource SpaceLS}">
                                <!-- A plain person icon (M.ORCH-T1973, owner: "users shouldn't be a spinner with the accumulated
                                     CLIs, just a person icon"), in the slot the flat strip's status badges use: what's active
                                     already shows on each CLI row's own badge below. The same Segoe Fluent "Contact" glyph as the
                                     title bar's Logins button. A disabled login still shows its disabled glyph instead. The flat
                                     strip's own header (LoginTabStrip's ItemTemplate above) keeps its badges unchanged. -->
                                <Grid x:Name="TreeTabStatusIcon" DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource SpaceRS}">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabFaceTitle}"
                                               Visibility="{Binding IsTabDisabled, Converter={x:Static vm:Converters.FalseToVisible}}" />
                                    <TextBlock Text="{Binding TabDisabledGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource MaMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                               Visibility="{Binding ShowsDisabledIcon, Converter={StaticResource Visible}}" />
                                    <!-- Locked (M.ORCH-T2119): the same boxed red lock as the flat strip's TabLockedBadge, over this
                                         login's own person/disabled glyph above, distinct from the small past-cutoff lock glyph
                                         (TabDisabledGlyph, M.ORCH-T1254). -->
                                    <mc:MaBadge x:Name="TreeTabLockedBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="&#x1F512;" Background="{DynamicResource MaBad}"
                                                Foreground="{DynamicResource MaOnAccent}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                                Visibility="{Binding ShowsLockedBadge, Converter={StaticResource Visible}}" />
                                </Grid>
                                <!-- A folder OAuth-signed in as another account says so on its own node (M.ORCH-T1954), in the
                                     theme's warning colour; collapsed while it's signed in as itself. -->
                                <StackPanel VerticalAlignment="Center">
                                    <!-- Margin-top -1 (M.ORCH-T2264): WPF centers a TextBlock's layout box, which has more empty
                                         space below the font's baseline than above it, against the icon's own tight bounding box
                                         (a glyph centered in its 20x20 cell) - so without this nudge the title reads as sitting
                                         low next to it. Only the title gets the nudge; WrongAccountLine below it keeps its own
                                         position relative to the title unchanged. -->
                                    <TextBlock Text="{Binding TabFaceTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" />
                                    <TextBlock Text="{Binding WrongAccountLine}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" TextWrapping="Wrap"
                                               Visibility="{Binding WrongAccountLine, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- The same sigma/lambda bars as LoginUsageBarsTemplate (the flat strip's TrailingContentTemplate),
                                 written out here: the library has no bare content host to put that template in. -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}"
                                        Visibility="{Binding ShowsTabUsageBars, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding UsageSigmaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" />
                                <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                                             Margin="{StaticResource SpaceLXS}" Value="{Binding WeeklyLimitPercent, Mode=OneWay}"
                                             Foreground="{Binding WeeklyLimitBrush}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowsFiveHourChart, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding UsageLambdaLabel}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                                    <ProgressBar Style="{StaticResource MaProgressBar}" Width="28" Height="5" VerticalAlignment="Center"
                                                 Margin="{StaticResource SpaceLXS}" Value="{Binding FiveHourLimitPercent, Mode=OneWay}"
                                                 Foreground="{Binding FiveHourLimitBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- This login's own menu (Open Project, Run Launcher, User Settings, Change Color), reachable
                                 with a tap or a left click (M.ORCH-T1793): the exact same menu the row's own right-click opens
                                 (LoginTreeHeader_ContextMenuOpening), which doesn't work well on touch or in the phone layout to begin
                                 with. Shown for every login (same as the row's own context menu); ShowLoginMenu itself still refuses a
                                 non-person tab. -->
                            <!-- The API key's row (M.ORCH-T1816): today's spend and its share of the starting credit, where a
                                 Claude login's row has its bars. Empty, so collapsed, on every other row. -->
                            <TextBlock Grid.Column="3" Text="{Binding ApiSpendFace}" Style="{StaticResource MaMutedText}" FontSize="11" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="{StaticResource SpaceLS}"
                                       Visibility="{Binding ApiSpendFace, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                            <!-- The same size as a row's own ellipsis and Close X below, and in the X's column (M.ORCH-T1812).
                                 "+ Add" is no longer on this row: it is the node's own last child (LoginTreeAddLeaf, M.ORCH-T2104). -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsPersonTab, Converter={StaticResource Visible}}">
                                <Button x:Name="LoginTreeMoreButton" Style="{StaticResource MaToolButton}" Content="&#xE712;"
                                        Width="22" Height="18" FontSize="10" VerticalAlignment="Center"
                                        Margin="{StaticResource SpaceLS}" Click="LoginTreeMoreButton_Click"
                                        mc:MaCallout.ToolTip="Open Project, Run Launcher, User Settings, Change Color"
                                        AutomationProperties.Name="{Binding TabTitle, StringFormat='More actions for {0}'}" />
                            </StackPanel>
                        </Grid>
                        <!-- A signed-out login's Launcher stand-in (M.ORCH-T1950): every org member's node stays in the
                             tree for good, and keeps its Launcher child (M.ORCH-T1886), but a Launcher can't run on a login
                             that isn't signed in, so this disabled row takes its place, first like the Launcher itself
                             (SyncTo sorts it first). Always a tee: the "+ Add" leaf (M.ORCH-T2104) is the node's last child. -->
                        <Grid x:Name="LoginTreeLauncherPlaceholder" Margin="0,2,0,-2" Opacity="0.65"
                              Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                            <Grid Visibility="{Binding ShowsLauncherPlaceholder, Converter={StaticResource Visible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" IsHitTestVisible="False" Margin="0,0,-6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                          Fill="{DynamicResource MaMuted}" />
                                    <Path Grid.Row="1" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                          Fill="{DynamicResource MaMuted}" />
                                    <Path Grid.RowSpan="2" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0"
                                          Fill="{DynamicResource MaMuted}" />
                                </Grid>
                                <DockPanel Grid.Column="1" Margin="0,2,0,2" mc:MaCallout.ToolTip="Signed out: sign this login in from its menu to run its Launcher"
                                           AutomationProperties.Name="Launcher, unavailable while signed out">
                                    <Grid Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,7,0">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M9.19 6.35c-2.04 2.29-3.44 5.58-3.57 5.89L2 10.69l4.05-4.05c.47-.47 1.15-.68 1.81-.55l1.33.26zM11.17 17s3.74-1.55 5.89-3.7c5.4-5.4 4.5-9.62 4.21-10.57-.95-.3-5.17-1.19-10.57 4.21C8.55 9.09 7 12.83 7 12.83L11.17 17zm6.48-2.19c-2.29 2.04-5.58 3.44-5.89 3.57L13.31 22l4.05-4.05c.47-.47.68-1.15.55-1.81l-.26-1.33zM9 18c0 .83-.34 1.58-.88 2.12C6.94 21.3 2 22 2 22s.7-4.94 1.88-6.12C4.42 15.34 5.17 15 6 15c1.66 0 3 1.34 3 3zm4-9c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"
                                                  Stretch="Uniform" Fill="{DynamicResource MaMuted}" />
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Text="Launcher (signed out)" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                        <!-- A login not signed in as itself (signed out, or its folder borrowed by another account) keeps no
                             General Prompt (M.ORCH-T1957), so this disabled row stands in for it under the Launcher's. Its
                             spine always runs on below, into the panes and the "+ Add" leaf (M.ORCH-T2104). -->
                        <Grid x:Name="LoginTreeGeneralPromptPlaceholder" Margin="0,2,0,-2" Opacity="0.65"
                              Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                            <Grid Visibility="{Binding ShowsGeneralPromptPlaceholder, Converter={StaticResource Visible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" IsHitTestVisible="False" Margin="0,0,-6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                          Fill="{DynamicResource MaMuted}" />
                                    <Path Grid.Row="1" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                          Fill="{DynamicResource MaMuted}" />
                                    <Path Grid.RowSpan="2" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0"
                                          Fill="{DynamicResource MaMuted}" />
                                </Grid>
                                <DockPanel Grid.Column="1" Margin="0,2,0,2" mc:MaCallout.ToolTip="Disabled, or its folder is signed in as another account: fix that from this login's menu to get its General Prompt"
                                           AutomationProperties.Name="General Prompt, unavailable">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="20" Margin="6,0,7,0" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource MaMuted}" />
                                    <TextBlock Text="General Prompt (unavailable)" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                        <ItemsControl x:Name="LoginTreeChildren" Style="{StaticResource MaList}" ItemsSource="{Binding Terminals.Panes}"
                                      Margin="0,2,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Plain (no Ctrl) drag reorders this pane among its login's own CLI tabs (M.ORCH-T1768 note 6:
                                         the flat CLI tab strip's own AllowReorder/Reordered had no counterpart here at all); Ctrl held
                                         instead hands the press to LoginDragDrop's own quick-switch-login drag (MainWindow.xaml.cs,
                                         its own doc comment explains the handoff). -->
                                    <!-- Faded while this CLI is "moving" (M.ORCH-T1883/M.ORCH-T1884, MovingOpacity, the same 0.65
                                         LoginDragDrop/LoginTree_DragOver's own drag-hover dim already uses): a plain bound attribute,
                                         not a Style trigger (Opacity isn't a Grid-style setter LibraryOnlyXamlTests allows: a layout
                                         panel's own style may only set Visibility). -->
                                    <Grid x:Name="LoginTreeChildRow" Cursor="Hand" Background="Transparent" AllowDrop="True" Opacity="{Binding MovingOpacity}"
                                          MouseLeftButtonDown="LoginTreeChild_MouseLeftButtonDown"
                                          ContextMenuOpening="LoginTreeChild_ContextMenuOpening"
                                          PreviewMouseLeftButtonDown="LoginTreeChildRow_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="LoginTreeChildRow_PreviewMouseMove"
                                          DragOver="LoginTreeChildRow_DragOver" DragLeave="LoginTreeChildRow_DragLeave" Drop="LoginTreeChildRow_Drop">
                                        <!-- The pane actually shown in the body right now (M.ORCH-T1801): its own IsSelected (the
                                             same flag that drives its HwndHost's Visibility) alone isn't enough, since a login
                                             keeps its last-active pane's IsSelected true even while another login is shown - so
                                             this also requires the owning login's own IsTabSelected, reached via LoginTreeChildren
                                             (the nearest ItemsControl up from this row), the same AncestorType=ItemsControl climb
                                             TreePaneRow's own CloseCommand binding below already uses to reach the login. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The hover highlight (M.ORCH-T1891, same as the login header's own above): MaShapeBorder
                                             with MaHover (M.ORCH-T1893: a plain Border isn't library-styled), shown only while the
                                             mouse is over this row (LoginTreeChildRow, this template's own Grid), drawn first so the
                                             selected-pane highlight just below still wins over it. -->
                                        <mc:MaShapeBorder Grid.ColumnSpan="2" Fill="{DynamicResource MaHover}" Margin="0" SnapsToDevicePixels="False"
                                                Visibility="{Binding IsMouseOver, ElementName=LoginTreeChildRow, Converter={StaticResource Visible}}" />
                                        <!-- The highlight itself: the library's MaChromeBorder fill (MaDivider, sized to the whole
                                             row) behind the row's content, its style only showing or hiding it. -->
                                        <Border Grid.ColumnSpan="2" Height="Auto" Margin="0" SnapsToDevicePixels="False">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource MaDivider}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsTabSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- The M.ORCH-T1883/M.ORCH-T1884 moving placeholder's own dashed outline: same size/shape as
                                             the row itself (Grid.ColumnSpan="2", the whole row like the highlight Border above), never
                                             a solid line (that's DropLineAdorner's own insertion marker, a different thing). No raw
                                             Rectangle (M.ORCH-T667's library-only rule, LibraryOnlyXamlTests, bans one, same as the
                                             spine's own Path lines just below explain): four Path lines instead, each a straight unit
                                             segment stretched along its own axis only, so the dash pattern along each edge isn't
                                             skewed the way stretching a whole rectangle geometry would skew it on a non-square row. -->
                                        <Grid Grid.ColumnSpan="2" Margin="1" IsHitTestVisible="False"
                                              Visibility="{Binding IsMoving, Converter={StaticResource Visible}}">
                                            <Path Data="M0,0 L1,0" Stretch="Fill" Height="1" VerticalAlignment="Top"
                                                  StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                            <Path Data="M0,0 L1,0" Stretch="Fill" Height="1" VerticalAlignment="Bottom"
                                                  StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                            <Path Data="M0,0 L0,1" Stretch="Fill" Width="1" HorizontalAlignment="Left"
                                                  StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                            <Path Data="M0,0 L0,1" Stretch="Fill" Width="1" HorizontalAlignment="Right"
                                                  StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                        </Grid>
                                        <!-- The branch's own connector lines (M.ORCH-T1768): a vertical line down this column, the
                                             same one every sibling row draws, so together they read as one continuous spine down
                                             the login's open panes, each with a short horizontal tee into its own icon - so it's
                                             visually clear these rows are branches of the login above them, not just another
                                             indented list. The library has no tree-line control or style to base one on (and
                                             none should exist for a one-off shape like this), so like every other one-off vector
                                             in this window these are Path, not a raw Line/Rectangle/Border (M.ORCH-T667's
                                             library-only rule's own exception for exactly that): a unit square stretched to fill
                                             its box, which for a 1px-thin box reads as a line. Filled with MaMuted (M.ORCH-T1822),
                                             the same muted gray the "zzz" idle badge's own Background already uses a few lines
                                             down - not MaChromeBorder, which is also the selected row's own highlight fill
                                             (MaDivider, above) and so washed the spine out to invisible on a selected login.
                                             MaMuted isn't itself selection-dependent (it's the same brush on IsTabDisabled's icon
                                             and every muted label in this window, selected row or not), so the spine stays
                                             visible either way. LoginTreeChildRow carries no vertical Margin of its own any more
                                             (M.ORCH-T1822): that margin used to gap each row from the next, breaking this spine
                                             at every sibling boundary, so the breathing room moved onto TreePaneRow below
                                             instead - only the row's actual content insets now, while this connector column and
                                             the selection highlight both run edge-to-edge, sibling rows' spines touching to read
                                             as one continuous line. Every pane row is a tee: the node's last child, and so its one "L", is always the "+ Add" leaf below (LoginTreeAddLeaf, M.ORCH-T2104). -->
                                        <!-- Where they sit (M.ORCH-T1812, the owner's mockup): the list starts where the header's
                                             chevron starts (right after the login's stripe), this column is as wide as the header's chevron (14) and
                                             the spine runs down its middle, so it drops straight from the chevron; the tee
                                             reaches 6 past the column, towards the icon. -->
                                        <Grid Grid.Column="0" IsHitTestVisible="False" Margin="0,0,-6,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- The spine's own two halves (M.ORCH-T1768 follow-up): split into two equal segments
                                                 rather than one, so the bottom half alone can be dropped on the login's last open
                                                 pane - an elbow into that final branch (the line stopping at its own tee) instead
                                                 of a tee that reads as though a further sibling followed below it. The top half
                                                 always shows: it is this row's own link up to the one above it (or the login
                                                 header, for the first row). -->
                                            <!-- Margin-left 4, not the chevron column's own math-center 7 (M.ORCH-T1894, Ryan's
                                                 screenshots): the chevron glyph's ink sits a few px left of its 14-wide cell's true
                                                 center, so a spine mathematically centered in that cell reads as sitting right of
                                                 the arrow. Nudged 3px left to match what Ryan's eye (and screenshots) measured. -->
                                            <Path Grid.Row="0" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                                  Fill="{DynamicResource MaMuted}" />
                                            <Path Grid.Row="1" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                                  Fill="{DynamicResource MaMuted}" />
                                            <Path Grid.RowSpan="2" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0"
                                                  Fill="{DynamicResource MaMuted}" />
                                        </Grid>
                                        <!-- A real CLI/Launcher pane: the same per-pane badges as the flat CLI tab bar's own header,
                                             plus its own Close X (M.ORCH-T1768 note 6: the flat CLI tab list's close button had no
                                             equivalent here at all, so a CLI opened only in tree mode couldn't be closed from the
                                             tree, same CloseCommand/CommandParameter wiring and DockPanel.Dock="Right" placement as
                                             the flat strip's own TerminalCloseButton, just reached via AncestorType=ItemsControl
                                             (this row's nearest ItemsControl, LoginTreeChildren above, inherits the owning login's
                                             MainViewModel as its DataContext). LoginTreeChildren above binds straight to
                                             Terminals.Panes (M.ORCH-T1768), the same collection the flat strip binds too
                                             (M.ORCH-T2238: there's no separate pinned marker item any more in either one). -->
                                        <!-- The branch spine above needs zero vertical margin to run edge-to-edge and touch the
                                             next sibling's own spine (M.ORCH-T1822), so the row's old breathing room (dropped from
                                             LoginTreeChildRow itself) lives here instead - only the actual content (icon, name,
                                             buttons) insets from the row's top/bottom, not the connector column beside it. -->
                                        <DockPanel x:Name="TreePaneRow" Grid.Column="1" Margin="0,2,0,2" mc:MaCallout.ToolTip="{Binding TabHoverTip}" AutomationProperties.Name="{Binding Title}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#xE711;" Margin="8,-2,0,-2"
                                                    Width="22" Height="18" FontSize="10" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.Terminals.CloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Close {0}'}"
                                                    mc:MaCallout.ToolTip="Close this terminal, ending its CLI"
                                                    Visibility="{Binding ShowsCloseButton, Converter={StaticResource Visible}}" />
                                            <!-- M.ORCH-T1883/M.ORCH-T1884's own moving placeholder: in the ellipsis/close buttons' own
                                                 slot (both hidden, ShowsCloseButton/ShowsMoreButton, while this is shown). -->
                                            <mc:MaSpinner DockPanel.Dock="Right" Kind="Ring" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                                          StrokeThickness="1.327" Stroke="{DynamicResource MaMuted}"
                                                          Visibility="{Binding IsMoving, Converter={StaticResource Visible}}"
                                                          mc:MaCallout.ToolTip="{Binding MovingText}"
                                                          AutomationProperties.Name="{Binding MovingText, FallbackValue=Moving}" />
                                            <!-- This CLI's own menu (Move to, Copy PID, Rename, Change Color, Undock/Dock, Pop out,
                                                 broadcast), reachable with a tap or a left click (M.ORCH-T1793): the exact same menu
                                                 the row's own right-click opens (LoginTreeChild_ContextMenuOpening), which doesn't
                                                 work well on touch or in the phone layout to begin with. -->
                                            <Button x:Name="TreePaneMoreButton" DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#xE712;" Margin="4,-2,0,-2"
                                                    Width="22" Height="18" FontSize="10" VerticalAlignment="Center"
                                                    Click="TreePaneMoreButton_Click"
                                                    Visibility="{Binding ShowsMoreButton, Converter={StaticResource Visible}}"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='More actions for {0}'}"
                                                    mc:MaCallout.ToolTip="Move, rename, change color, undock/dock, pop out, broadcast, or copy its PID" />
                                            <!-- 8 in from the chevron column's end puts this 20-wide cell's centre exactly under the
                                                 header's own 20-wide icon cell (M.ORCH-T1812), both now the same size (M.ORCH-T1838,
                                                 the owner's report): this cell and its badges used to be drawn 2px smaller all round
                                                 than the header's own (18/16/12 here vs. the header's and the flat strip's own
                                                 TerminalTabStatusIcon's 20/18/14), so the same zzz/busy/asking badge read larger on a
                                                 user's row than on their own CLI's, one column over. -->
                                            <!-- Margin-left 6, not 8 (M.ORCH-T1894, M.ORCH-T1895): shifted 3px left alongside the spine
                                                 above for the chevron-center reason below, then nudged 1px back right (Ryan's report) -
                                                 right margin trimmed to match so the cell's total span, and the name column after it,
                                                 don't shift. -->
                                            <Grid Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,7,0">
                                                <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="zzz" Background="{DynamicResource MaMuted}"
                                                            Foreground="{DynamicResource MaOnAccent}" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowsPaneIdleBadge, Converter={StaticResource Visible}}" />
                                                <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                                            Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowsPaneBusyBadge, Converter={StaticResource Visible}}">
                                                    <!-- Inside the ring, this CLI plus its running subagents (M.ORCH-T1859), its share of the login's count above. -->
                                                    <Grid>
                                                        <mc:MaSpinner Kind="Ring" Width="14" Height="14" StrokeThickness="1.327" Stroke="{DynamicResource MaOnAccent}" />
                                                        <TextBlock Text="{Binding PaneWorkCountText}" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource MaOnAccent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding PaneWorkWord}" />
                                                    </Grid>
                                                </mc:MaBadge>
                                                <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                                            Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            mc:MaCallout.ToolTip="{Binding PaneGoalTip}"
                                                            Visibility="{Binding ShowsPaneGoalBadge, Converter={StaticResource Visible}}">
                                                    <mc:MaSpinner Kind="Infinity" Width="14" Height="14" StrokeThickness="1.4" Stroke="{DynamicResource MaOnAccent}" />
                                                </mc:MaBadge>
                                                <mc:MaBadge Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="?" Background="{DynamicResource MaWarn}"
                                                            Foreground="{DynamicResource MaOnAccent}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowsPaneAskingBadge, Converter={StaticResource Visible}}" />
                                                <!-- The Launcher pane's own rocket icon (M.ORCH-T1768), so a Launcher node reads as one at
                                                     a glance among its login's CLI panes: the exact same Viewbox/Path as the flat CLI tab
                                                     strip's own TerminalTabLauncherIcon (M.LNCH-T77/M.ORCH-T805's Material rocket_launch
                                                     glyph, since no rocket is confirmed in the Segoe icon font this window otherwise draws
                                                     glyphs from). Overlaid in this same badge cell (M.ORCH-T1798), not a sibling after it:
                                                     a sibling left the empty badge cell's own width reserved in front of it, shifting the
                                                     rocket a column right of where every other row's icon sits. -->
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Visibility="{Binding Request.IsMenu, Converter={StaticResource Visible}}"
                                                         mc:MaCallout.ToolTip="The Launcher's own menu" AutomationProperties.Name="Launcher">
                                                    <Path Data="M9.19 6.35c-2.04 2.29-3.44 5.58-3.57 5.89L2 10.69l4.05-4.05c.47-.47 1.15-.68 1.81-.55l1.33.26zM11.17 17s3.74-1.55 5.89-3.7c5.4-5.4 4.5-9.62 4.21-10.57-.95-.3-5.17-1.19-10.57 4.21C8.55 9.09 7 12.83 7 12.83L11.17 17zm6.48-2.19c-2.29 2.04-5.58 3.44-5.89 3.57L13.31 22l4.05-4.05c.47-.47.68-1.15.55-1.81l-.26-1.33zM9 18c0 .83-.34 1.58-.88 2.12C6.94 21.3 2 22 2 22s.7-4.94 1.88-6.12C4.42 15.34 5.17 15 6 15c1.66 0 3 1.34 3 3zm4-9c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"
                                                          Stretch="Uniform" Fill="{DynamicResource MaMuted}" />
                                                </Viewbox>
                                                <!-- A workspace-root tab ("General", or the workspace folder's own name "MindAttic": opened at the
                                                     workspace root, not on a repo, M.ORCH-T1819) has no AgentBoardRow of its own (AgentBoard.Build
                                                     only walks registered repos' own sessions), so none of the three status badges above it ever
                                                     light, leaving this cell blank (M.ORCH-T1829): the home glyph that used to stand in for them
                                                     read as a stray/wrong icon (the owner's report), so it's gone, not merely hidden. -->
                                            </Grid>
                                            <!-- Name, not Title (M.ORCH-T1768): Title still carries the login's initials
                                                 ("RD: Prose"), redundant here since this row already sits nested under
                                                 that very login's own header, the same reason the flat CLI tab bar's own
                                                 TerminalTabName already binds Name instead. Margin-top -1 (M.ORCH-T2264):
                                                 the same optical-centering nudge as the root row's title, against this
                                                 row's own 20x20 icon/badge cell. -->
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- "+ Add" (M.ORCH-T2104, owner: "a child node off the user, that way you always have a expandable
                             collapsible User root"): always this node's last child, so its elbow is the "L" (spine's top half
                             and tee only) and every pane row above it keeps its tee. Its -2 top margin closes
                             LoginTreeChildren's bottom gap so the spine stays unbroken. Disabled, not hidden, while signed out.
                             The whole row is the hit target (M.ORCH-T2242), the same full-row Grid/hover-highlight pattern as
                             LoginTreeChildRow above, not a small MaToolButton: a button only hit-tests its own label's width,
                             so most of the row did nothing when clicked, unlike every sibling pane row. The "+" is drawn as an
                             icon glyph (Segoe Fluent Icons' Add, &#xE710;, the same icon font the row's own More/Close/chevron
                             buttons already use), not the literal '+' character the old label's FontFamily="Segoe UI"
                             override used to render as plain text. -->
                        <Grid x:Name="LoginTreeAddLeaf" Cursor="Hand" Background="Transparent"
                              MouseLeftButtonDown="LoginTreeAddLeaf_MouseLeftButtonDown"
                              IsEnabled="{Binding CanAddCli}" Opacity="{Binding AddCliOpacity}" ToolTipService.ShowOnDisabled="True"
                              mc:MaCallout.ToolTip="{Binding AddCliLockedTip, TargetNullValue='Open a CLI: a repo from the list, or a Launcher'}"
                              AutomationProperties.Name="{Binding TabTitle, StringFormat='Open a new CLI for {0}'}"
                              Margin="0,-2,0,2"
                              Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                            <Grid Visibility="{Binding IsPersonTab, Converter={StaticResource Visible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The hover highlight (same as every sibling row's own above): shown only while the mouse is
                                     over this row (LoginTreeAddLeaf, this row's own outer Grid). -->
                                <mc:MaShapeBorder Grid.ColumnSpan="2" Fill="{DynamicResource MaHover}" Margin="0" SnapsToDevicePixels="False"
                                        Visibility="{Binding IsMouseOver, ElementName=LoginTreeAddLeaf, Converter={StaticResource Visible}}" />
                                <Grid Grid.Column="0" IsHitTestVisible="False" Margin="0,0,-6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Stretch"
                                          Fill="{DynamicResource MaMuted}" />
                                    <Path Grid.RowSpan="2" Data="M0,0 L1,0 L1,1 L0,1 Z" Stretch="Fill" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0"
                                          Fill="{DynamicResource MaMuted}" />
                                </Grid>
                                <!-- Icon cell the same size/position as every sibling pane row's own (TreePaneRow above, Width=20
                                     Height=20 Margin 6,0,7,0), so "Add" lines up under the same column as "Unity"'s icon. -->
                                <DockPanel Grid.Column="1" Margin="0,2,0,2">
                                    <Grid Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,7,0">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Add" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                        <!-- This login's Agents panel (M.ORCH-T1747, roadmap Phase 1): each agent the agents table has on it
                             (AgentBook, M.ORCH-T1744; retired ones left out), its role, then its state, the unit it's on and
                             its last heartbeat. Read with the refresh and a pushed snapshot's figures, never polled. Below the
                             "+ Add" leaf and off their spine, so that leaf's elbow stays an "L". Shown only while expanded and
                             the login has an agent. -->
                        <Grid x:Name="LoginTreeAgents" Margin="14,2,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                            <StackPanel Visibility="{Binding HasAgents, Converter={StaticResource Visible}}"
                                        AutomationProperties.Name="{Binding AgentsTitle}">
                                <TextBlock Text="{Binding AgentsTitle}" Style="{StaticResource MaMutedText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                                <ItemsControl Style="{StaticResource MaList}" ItemsSource="{Binding Agents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="6,1,0,1" mc:MaCallout.ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                                                <TextBlock Text="&#xE99A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Width="20" Margin="0,0,7,0"
                                                           TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MaMuted}" />
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Line}" Style="{StaticResource MaMutedText}" FontSize="11" VerticalAlignment="Center"
                                                           Margin="{StaticResource SpaceLS}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
        </Grid>
        </mc:MaPanel>
        <!-- This PC (M.ORCH-T2177, out of the status bar where M.ORCH-T1499/M.ORCH-T1875/M.ORCH-T2101 had them): one row per
             fixed drive (M.ORCH-T2169), then RAM, each a label, a bar stretching to the panel's width, then the free space or
             the memory guard's level. The labels share one column and the texts another (HostStatsBars is their shared size
             scope), so every bar starts and ends at the same x. The global login's tab's in code-behind
             (HostStatsBars.DataContext = model), so it is this machine's reading whichever login is shown. -->
        <mc:MaPanel Title="This PC" IsCollapsible="True" mc:MaPanelGroup.PanelKey="host" mc:MaPanelGroup.IsDraggable="True">
        <StackPanel x:Name="HostStatsBars" Grid.IsSharedSizeScope="True" AutomationProperties.Name="This machine's disk and RAM use">
            <ItemsControl Style="{StaticResource MaList}" ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveStatusViewModel}">
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="HostLabel" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="HostText" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Style="{StaticResource MaProgressBar}" Height="5" VerticalAlignment="Center"
                                         Margin="{StaticResource SpaceLS}" Value="{Binding UsedPercent, Mode=OneWay}"
                                         Foreground="{Binding UsedBrush}" mc:MaCallout.ToolTip="{Binding ToolTip}" />
                            <TextBlock Grid.Column="2" Text="{Binding FreeText}" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceLS}"
                                       mc:MaCallout.ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding SpokenText}"
                                       Visibility="{Binding FreeText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HostLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="HostText" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RAM" Style="{StaticResource MaMutedText}" FontSize="10" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Style="{StaticResource MaProgressBar}" Height="5" VerticalAlignment="Center"
                             Margin="{StaticResource SpaceLS}" Value="{Binding RamUsedPercent, Mode=OneWay}"
                             Foreground="{Binding RamUsedBrush}" mc:MaCallout.ToolTip="{Binding RamToolTip}" />
                <!-- The memory guard's level (M.ORCH-T1498): muted while ok, MaWarn while it holds new work, MaBad once it sheds
                     subagents or refuses tool calls; one of the three shows, the tooltip says what's held. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="RamUtilizationText" Text="{Binding RamCalmText}" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceLS}"
                               mc:MaCallout.ToolTip="{Binding RamToolTip}" AutomationProperties.Name="{Binding RamCalmText}"
                               Visibility="{Binding RamCalmText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <TextBlock x:Name="RamWarnText" Text="{Binding RamWarnText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceLS}"
                               mc:MaCallout.ToolTip="{Binding RamToolTip}" AutomationProperties.Name="{Binding RamToolTip}"
                               Visibility="{Binding RamWarnText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <TextBlock x:Name="RamBadText" Text="{Binding RamBadText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceLS}"
                               mc:MaCallout.ToolTip="{Binding RamToolTip}" AutomationProperties.Name="{Binding RamToolTip}"
                               Visibility="{Binding RamBadText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        </mc:MaPanel>
        </mc:MaPanelGroup>
        </Border>

        <!-- A person's CLI tab bar (M.ORCH-T810), fixed under their person tab (M.ORCH-T1302, which pulled the chosen terminal
             itself back into the scrolling body below): the person tabs above, then that person's terminal tabs right beneath
             them, is all that stays fixed, so who's selected and which CLI is shown are always visible; the terminal, the
             stats, the 5-hour chart and Tickets all scroll together in the body (AgentsBody). One tab per CLI of theirs running
             inside the dashboard (sent by the Launcher when it runs inside the Orchestrator, M.LNCH-T77), each a live ConPTY
             terminal with the Windows Terminal renderer, underlined in its login's colour and led by its badge (an MaTag in that
             colour). The terminals are native windows (HwndHosts); they live in the one host grid below (MainWindow.xaml.cs adds
             and removes them, since a template would start a new CLI each time it was shown) and only the shown person's chosen
             one is visible; TerminalClip.cs keeps it clipped to AgentsBody's viewport as it scrolls, and the window hides them
             under a dialog or the loader. -->
        <StackPanel x:Name="TerminalsPanel" Grid.Row="2" Grid.Column="1" Margin="{StaticResource SpaceLXLTSRXL}" Visibility="{Binding ShowsFlatTerminalsPanel, Converter={StaticResource Visible}}">
            <TextBlock x:Name="TerminalsEmptyHint" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}"
                       Text="No terminals open on this login. When the Launcher runs inside the Orchestrator, each CLI it opens arrives here as a tab of its own: a live terminal you can type in."
                       Visibility="{Binding Terminals.HasPanes, Converter={x:Static vm:Converters.FalseToVisible}}" />
            <!-- No wrap, ever (M.ORCH-T1171, mirroring the login tabs' M.ORCH-T822): each tab is already only as wide as its own
                 content, so once there are enough CLIs open the strip is wider than the window. A plain horizontal ScrollViewer
                 around it, paged by the < and > buttons (TerminalTabScroller_ScrollChanged/TerminalTabScrollLeft_Click/Right_Click
                 in MainWindow.xaml.cs), hidden while everything fits and disabled at each end rather than wrapping to a second row. -->
            <Grid x:Name="TerminalTabStripRow" Margin="{StaticResource SpaceBS}" Visibility="{Binding Terminals.HasPanes, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TerminalTabScrollLeft" Grid.Column="0" Style="{StaticResource MaToolButton}" Content="&#xE76B;"
                        Click="TerminalTabScrollLeft_Click" Margin="{StaticResource SpaceRXS}" Visibility="Collapsed"
                        mc:MaCallout.ToolTip="Scroll the CLI tabs left" AutomationProperties.Name="Scroll the CLI tabs left" />
                <ScrollViewer x:Name="TerminalTabScroller" Grid.Column="1" Style="{StaticResource MaBodyScroll}" mc:MaScrollArea.Gutter="0"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              ScrollChanged="TerminalTabScroller_ScrollChanged">
                    <!-- The Launcher's own tab and every CLI tab share this one mc:MaTabControl (M.ORCH-T1555), bound straight
                         to Terminals.Panes/SelectedPane (M.ORCH-T2238: the pinned "Usage" item that used to sit ahead of them
                         is gone - there's no per-login home page left to select into, so the strip is nothing but panes now).
                         Drag-and-drop reordering (M.ORCH-T1526, M.COMP-T168): the Launcher's own tab is an ordinary pane here
                         like any other CLI session, so every real tab in this strip is freely draggable. TerminalTabs_Reordered
                         applies and persists the move via PersonTerminalsViewModel.Reorder. -->
                    <mc:MaTabControl x:Name="TerminalTabs" ShowContent="False" ContextMenuOpening="OnTerminalTabContextMenu"
                                     ItemsSource="{Binding Terminals.Panes}" SelectedItem="{Binding Terminals.SelectedPane}"
                                     AllowReorder="True" Reordered="TerminalTabs_Reordered"
                                     AutomationProperties.Name="Terminals" AutomationProperties.HelpText="{Binding Terminals.Summary}">
                        <mc:MaTabControl.ItemContainerStyle>
                            <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                                <Setter Property="Accent" Value="{Binding TabBrush}" />
                                <!-- The library's callout under the tab (M.ORCH-T1553, M.ORCH-T1552): its name, title, directory and
                                     login, then the CLI's live figures (state, subagents, tokens this session, uptime, PIDs). -->
                                <Setter Property="mc:MaCallout.ToolTip" Value="{Binding TabHoverTip}" />
                                <Setter Property="mc:MaCallout.Placement" Value="Bottom" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Style.Triggers>
                                    <!-- The Launcher stays first, never dragged, nothing dropped before it (M.ORCH-T1848). -->
                                    <DataTrigger Binding="{Binding Request.IsMenu, FallbackValue=False}" Value="True">
                                        <Setter Property="IsLocked" Value="True" />
                                    </DataTrigger>
                                    <!-- The M.ORCH-T1883/M.ORCH-T1884 moving placeholder (TerminalPaneViewModel.IsMoving): locked so it
                                         can't be dragged again mid-move. Its own fade is MovingOpacity, a plain bound attribute on
                                         the header Grid below, not a style setter here (Opacity isn't one of MaTabItem's own declared
                                         properties, so LibraryOnlyXamlTests doesn't allow a style to set it). -->
                                    <DataTrigger Binding="{Binding IsMoving, FallbackValue=False}" Value="True">
                                        <Setter Property="IsLocked" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </mc:MaTabControl.ItemContainerStyle>
                        <mc:MaTabControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding MovingOpacity}">
                                    <!-- The M.ORCH-T1883/M.ORCH-T1884 moving placeholder's own dashed outline (TreePaneRow's own twin
                                         above, including why this is four Path lines, not a raw Rectangle): this header Grid fills
                                         the whole tab's clickable face, so outlining it this way reads as the tab itself being
                                         outlined, same size/shape as any other tab. -->
                                    <Grid IsHitTestVisible="False" Visibility="{Binding IsMoving, Converter={StaticResource Visible}}">
                                        <Path Data="M0,0 L1,0" Stretch="Fill" Height="1" VerticalAlignment="Top"
                                              StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                        <Path Data="M0,0 L1,0" Stretch="Fill" Height="1" VerticalAlignment="Bottom"
                                              StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                        <Path Data="M0,0 L0,1" Stretch="Fill" Width="1" HorizontalAlignment="Left"
                                              StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                        <Path Data="M0,0 L0,1" Stretch="Fill" Width="1" HorizontalAlignment="Right"
                                              StrokeDashArray="3,2" StrokeThickness="1" Stroke="{DynamicResource MaMuted}" />
                                    </Grid>
                                    <!-- The close X docked at the tab's right edge (M.ORCH-T1437): SizeTerminalTabs stretches this header to the tab. -->
                                    <DockPanel x:Name="RealTabHeader" Loaded="TerminalTabItem_Loaded">
                                        <!-- 10px off the tab's right edge (M.ORCH-T1271); asks before closing (M.ORCH-T1437). -->
                                        <Button x:Name="TerminalCloseButton" DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#xE711;" Margin="8,-4,-2,-4"
                                                Width="22" Height="18" FontSize="10" VerticalAlignment="Center"
                                                Command="{Binding DataContext.Terminals.CloseCommand, RelativeSource={RelativeSource AncestorType=mc:MaTabControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Close {0}'}"
                                                mc:MaCallout.ToolTip="Close this terminal, ending its CLI"
                                                Visibility="{Binding ShowsCloseButton, Converter={StaticResource Visible}}" />
                                        <!-- M.ORCH-T1883/M.ORCH-T1884's own moving placeholder: in the ellipsis/close buttons' own
                                             slot (both hidden, ShowsCloseButton/ShowsMoreButton, while this is shown), the tree
                                             row's own twin above. -->
                                        <mc:MaSpinner x:Name="TerminalMovingSpinner" DockPanel.Dock="Right" Kind="Ring" Width="14" Height="14" Margin="8,0,-2,0" VerticalAlignment="Center"
                                                      StrokeThickness="1.327" Stroke="{DynamicResource MaMuted}"
                                                      Visibility="{Binding IsMoving, Converter={StaticResource Visible}}"
                                                      mc:MaCallout.ToolTip="{Binding MovingText}"
                                                      AutomationProperties.Name="{Binding MovingText, FallbackValue=Moving}" />
                                        <!-- This CLI's own menu, reachable with a tap or a left click (M.ORCH-T1793): the exact same
                                             menu the tab's own right-click opens (OnTerminalTabContextMenu), the flat strip's twin
                                             of the tree pane row's own TreePaneMoreButton. Collapsed for the pinned Usage tab along
                                             with the rest of RealTabHeader (the DataTrigger below), and for the same M.ORCH-T1883/
                                             M.ORCH-T1884 moving placeholder as the close button above (ShowsMoreButton). -->
                                        <Button x:Name="TerminalMoreButton" DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="&#xE712;" Margin="4,-4,0,-4"
                                                Width="22" Height="18" FontSize="10" VerticalAlignment="Center"
                                                Click="TerminalMoreButton_Click"
                                                Visibility="{Binding ShowsTabMoreButton, Converter={StaticResource Visible}, FallbackValue=Visible}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='More actions for {0}'}"
                                                mc:MaCallout.ToolTip="Move, rename, change color, undock/dock, pop out, broadcast, or copy its PID" />
                                    <StackPanel x:Name="TerminalTabParts" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <!-- This one CLI's own status (M.ORCH-T1272): the same language as the login tab's aggregate
                                             badge (M.ORCH-T1270) but scoped to this pane alone, from its matched AgentBoardRow
                                             (TerminalsViewModel.Update, matched by SessionId) rather than the whole login's CLIs. -->
                                        <Grid x:Name="TerminalTabStatusIcon" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{StaticResource SpaceRS}">
                                            <mc:MaBadge x:Name="TerminalTabIdleBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="zzz" Background="{DynamicResource MaMuted}"
                                                        Foreground="{DynamicResource MaOnAccent}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding PaneActivityWord}"
                                                        Visibility="{Binding ShowsPaneIdleBadge, Converter={StaticResource Visible}}" />
                                            <mc:MaBadge x:Name="TerminalTabBusyBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                                        Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding PaneActivityWord}"
                                                        Visibility="{Binding ShowsPaneBusyBadge, Converter={StaticResource Visible}}">
                                                <mc:MaSpinner Kind="Ring" Width="14" Height="14" StrokeThickness="1.327" Stroke="{DynamicResource MaOnAccent}" />
                                            </mc:MaBadge>
                                            <!-- Busy under a /goal (M.ORCH-T1856): the infinity sign in place of the ring above. -->
                                            <mc:MaBadge x:Name="TerminalTabGoalBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Background="{DynamicResource MaGood}"
                                                        Foreground="{DynamicResource MaOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding PaneActivityWord}" mc:MaCallout.ToolTip="{Binding PaneGoalTip}"
                                                        Visibility="{Binding ShowsPaneGoalBadge, Converter={StaticResource Visible}}">
                                                <mc:MaSpinner Kind="Infinity" Width="14" Height="14" StrokeThickness="1.4" Stroke="{DynamicResource MaOnAccent}" />
                                            </mc:MaBadge>
                                            <mc:MaBadge x:Name="TerminalTabAskingBadge" Style="{StaticResource MaTag}" Width="18" Height="18" Padding="0" BorderThickness="0" Content="?" Background="{DynamicResource MaWarn}"
                                                        Foreground="{DynamicResource MaOnAccent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{Binding PaneActivityWord}"
                                                        Visibility="{Binding ShowsPaneAskingBadge, Converter={StaticResource Visible}}" />
                                            <!-- The Launcher's own tab (M.LNCH-T77's first-embedded pane): a little rocket, not a status badge, since
                                                 this pane has no CLI/AgentBoardRow of its own to light one for (ShowsPane*Badge all stay false).
                                                 Same Path as the removed standalone "Open Launcher" rocket button (M.ORCH-T805, Material's
                                                 rocket_launch, since no rocket glyph is confirmed in the icon font), muted so it reads as an
                                                 identity mark, not an alert. -->
                                            <Viewbox x:Name="TerminalTabLauncherIcon" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding Request.IsMenu, Converter={StaticResource Visible}}"
                                                     mc:MaCallout.ToolTip="The Launcher's own menu" AutomationProperties.Name="Launcher">
                                                <Path Data="M9.19 6.35c-2.04 2.29-3.44 5.58-3.57 5.89L2 10.69l4.05-4.05c.47-.47 1.15-.68 1.81-.55l1.33.26zM11.17 17s3.74-1.55 5.89-3.7c5.4-5.4 4.5-9.62 4.21-10.57-.95-.3-5.17-1.19-10.57 4.21C8.55 9.09 7 12.83 7 12.83L11.17 17zm6.48-2.19c-2.29 2.04-5.58 3.44-5.89 3.57L13.31 22l4.05-4.05c.47-.47.68-1.15.55-1.81l-.26-1.33zM9 18c0 .83-.34 1.58-.88 2.12C6.94 21.3 2 22 2 22s.7-4.94 1.88-6.12C4.42 15.34 5.17 15 6 15c1.66 0 3 1.34 3 3zm4-9c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"
                                                      Stretch="Uniform" Fill="{DynamicResource MaMuted}" />
                                            </Viewbox>
                                            <!-- A workspace-root tab ("General", or the workspace folder's own name "MindAttic": opened at the
                                                 workspace root, not on a repo, M.ORCH-T1819) has no AgentBoardRow of its own (AgentBoard.Build
                                                 only walks registered repos' own sessions), so none of the three status badges above it ever
                                                 light, leaving this cell blank (M.ORCH-T1829): the home glyph that used to stand in for them
                                                 read as a stray/wrong icon (the owner's report), so it's gone, not merely hidden. -->
                                        </Grid>
                                        <!-- Double-click the name to rename it in place (M.ORCH-T1432): the TextBox swaps in for the TextBlock in
                                             the same cell; Enter keeps it, Esc or leaving it cancels (TerminalTabName_* in MainWindow.xaml.cs). -->
                                        <Grid VerticalAlignment="Center">
                                            <!-- A name too long for the tab scrolls across it, blinks 3 times, then starts over
                                                 (M.ORCH-T1509): a plain Canvas (library-only rule's own layout panel), scrolled
                                                 and clipped by the MarqueeBox attached behaviour, not a custom element. -->
                                            <Canvas x:Name="TerminalTabNameMarquee" MaxWidth="180" VerticalAlignment="Center" local:MarqueeBox.Enabled="True">
                                                <TextBlock x:Name="TerminalTabName" Text="{Binding Name}" VerticalAlignment="Center"
                                                           MouseLeftButtonDown="TerminalTabName_MouseLeftButtonDown" />
                                            </Canvas>
                                            <TextBox x:Name="TerminalTabNameEdit" Style="{StaticResource MaTextBox}" Visibility="Collapsed" VerticalAlignment="Center" Padding="0" Margin="-2,-2,-2,-2"
                                                     AutomationProperties.Name="{Binding Title, StringFormat='Rename {0}'}"
                                                     KeyDown="TerminalTabNameEdit_KeyDown" LostKeyboardFocus="TerminalTabNameEdit_LostKeyboardFocus" />
                                        </Grid>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" />
                                        <!-- Shared with remote viewers (M.ORCH-T935), and an eye while someone watches it remotely. -->
                                        <TextBlock x:Name="TerminalSharedGlyph" Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource MaMutedText}"
                                                   Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" mc:MaCallout.ToolTip="Shared with remote viewers (right-click to change)" AutomationProperties.Name="Shared with remote viewers"
                                                   Visibility="{Binding IsShared, Converter={StaticResource Visible}}" />
                                        <TextBlock x:Name="TerminalWatchedGlyph" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MaWarn}"
                                                   Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" mc:MaCallout.ToolTip="{Binding BroadcastText}"
                                                   AutomationProperties.Name="Being watched remotely"
                                                   Visibility="{Binding IsWatched, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </mc:MaTabControl.ItemTemplate>
                    </mc:MaTabControl>
                </ScrollViewer>
                <Button x:Name="TerminalTabScrollRight" Grid.Column="2" Style="{StaticResource MaToolButton}" Content="&#xE76C;"
                        Click="TerminalTabScrollRight_Click" Margin="{StaticResource SpaceLXS}" Visibility="Collapsed"
                        mc:MaCallout.ToolTip="Scroll the CLI tabs right" AutomationProperties.Name="Scroll the CLI tabs right" />
            </Grid>
            <!-- "Being watched" (M.ORCH-T935): while a remote viewer is attached to the shown CLI through the team gateway, or its
                 broadcast is paused, who is watching and how, with Pause broadcast (Ctrl+Shift+B, even while the terminal holds
                 focus) and Pause all. Pausing never touches this dashboard's own view. Sharing, masking and "share my sessions"
                 are on the CLI tab's right-click menu. -->
            <Border x:Name="BroadcastBanner" Style="{StaticResource MaCard}" DataContext="{Binding Terminals.SelectedPane}" Margin="{StaticResource SpaceBS}" Padding="{StaticResource SpaceHSVXS}"
                    Background="Transparent" BorderBrush="{DynamicResource MaWarn}" CornerRadius="4"
                    Visibility="{Binding ShowBroadcastBanner, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
                    AutomationProperties.Name="Remote viewers" AutomationProperties.LiveSetting="Assertive">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BroadcastPauseButton" Style="{StaticResource MaButton}" Content="{Binding PauseButtonText}"
                                Command="{Binding DataContext.AllTerminals.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" mc:MaCallout.ToolTip="Pause or resume what remote viewers see of this CLI (Ctrl+Shift+B)" />
                        <Button x:Name="BroadcastPauseAllButton" Style="{StaticResource MaButton}" Margin="{StaticResource SpaceLS}"
                                Content="{Binding DataContext.AllTerminals.PauseAllText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.AllTerminals.PauseAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                mc:MaCallout.ToolTip="Pause or resume what remote viewers see of every CLI" />
                    </StackPanel>
                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MaWarn}" VerticalAlignment="Center" Margin="{StaticResource SpaceRS}" />
                    <TextBlock x:Name="BroadcastText" Text="{Binding BroadcastText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MaWarn}" />
                </DockPanel>
            </Border>
        </StackPanel>
        <!-- A roster account not signed in on this machine yet (M.ORCH-T615): its tab shows only its Sign in, then, once signed
             in, the whole page and Open Launcher at the next refresh. -->
        <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="{StaticResource SpaceXL}"
                    Visibility="{Binding ShowsSignIn, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding SignInPrompt}" TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource SpaceBL}" />
            <Button Style="{StaticResource MaPrimaryButton}" Command="{Binding SignInTabCommand}" Content="Sign in" Padding="{StaticResource SpaceHLVS}"
                    HorizontalAlignment="Center" AutomationProperties.Name="{Binding TabTitle, StringFormat='Sign {0} in'}" />
            <TextBlock Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource SpaceTM}"
                       Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- The person's scrolling body, under their fixed login tabs and CLI tab bar (M.ORCH-T1302): the chosen terminal
             alone (M.ORCH-T2238: there is no "home page" for a login with no CLI chosen - the tree sidebar's login nodes
             only expand/collapse to their CLI children now, they never select one, so the body shows nothing until a real
             CLI tab is picked). SizeTerminalRow (MainWindow.xaml.cs) sizes the terminal to AgentsBody's own viewport (less
             its gutter), so it fills the page exactly and the body never scrolls under a CLI. -->
        <ScrollViewer x:Name="AgentsBody" Grid.Column="1"
                      Grid.Row="{Binding TreeMenuLayout, Converter={x:Static vm:Converters.BodyRow}}"
                      Grid.RowSpan="{Binding TreeMenuLayout, Converter={x:Static vm:Converters.BodyRowSpan}}"
                      Style="{StaticResource MaBodyScroll}"
                      Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">
            <StackPanel>
                <!-- Under the terminal, a share of its height (M.ORCH-T1887, TerminalChartHeight: 12%, floored at 48px; collapsed for
                     the API key, so its terminal keeps the whole frame): the
                     login's own usage chart, drawn compact (lines plus the predicted end percent), so pacing can be
                     watched while the CLI works. The 5-hour window for every plan but a solo
                     Ultra login, which has none and gets its weekly chart instead; the API key's person shows neither. -->
                <Grid x:Name="TerminalFrame" MinHeight="160" Margin="{StaticResource SpaceTS}"
                      Visibility="{Binding Terminals.ShowsTerminal, Converter={StaticResource Visible}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="TerminalUsageChart" Grid.Row="1" Margin="{StaticResource SpaceTS}"
                          Height="{Binding ActualHeight, ElementName=TerminalFrame, Converter={x:Static local:TerminalChartHeight.Converter}}"
                          Visibility="{Binding ShowsClaudeMeters, Converter={StaticResource Visible}}">
                        <mc:MaLineChart Compact="True" HorizontalAlignment="Stretch"
                                        Data="{Binding Utilization, Converter={x:Static local:UtilizationChartData.CompactConverter}}"
                                        AutomationProperties.Name="{Binding UtilizationText, StringFormat='5-hour utilization: {0}'}"
                                        Visibility="{Binding ShowsFiveHourChart, Converter={StaticResource Visible}}" />
                        <mc:MaLineChart Compact="True" HorizontalAlignment="Stretch"
                                        Data="{Binding WeeklyUtilization, Converter={x:Static local:WeeklyUtilizationChartData.CompactConverter}}"
                                        AutomationProperties.Name="{Binding WeeklyUtilizationText, StringFormat='Weekly utilization: {0}'}"
                                        Visibility="{Binding ShowsWeeklyChart, Converter={StaticResource Visible}}" />
                    </Grid>
                    <!-- WPF claims arrow keys (and Tab) for its own directional/tab focus navigation even when a hosted
                         native window (the terminal, an HwndHost) has Win32 keyboard focus, so a CLI's arrow-key menu never
                         sees them (M.ORCH-T833): switched off here so they pass straight through to the terminal. -->
                    <Grid x:Name="TerminalPanesHost" Grid.Row="0" KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- The Roadmap page (M.ORCH-T2384) over the body while it's shown, the terminal hidden under it (UpdateTerminalsCover);
             the page itself is added in MainWindow.xaml.cs, bound to the global login's tab. -->
        <Grid x:Name="RoadmapHost" Grid.Column="1"
              Grid.Row="{Binding TreeMenuLayout, Converter={x:Static vm:Converters.BodyRow}}"
              Grid.RowSpan="{Binding TreeMenuLayout, Converter={x:Static vm:Converters.BodyRowSpan}}"
              Visibility="{Binding IsRoadmapShown, Converter={StaticResource Visible}}" />

        <!-- An org with no Claude login yet (M.ORCH-T655): said over the body rather than showing another org's person. On the
             global login's tab (MainWindow.xaml.cs), which knows the orgs. -->
        <Border x:Name="OrgEmptyPanel" Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource MaCover}"
                Visibility="{Binding IsOrgEmpty, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding OrgEmptyText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="{StaticResource SpaceXL}" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Status bar: its own fixed footer (M.ORCH-T1302, restored from T1301's hide), not part of AgentsBody's scroll. -->
        <Border x:Name="StatusBar" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource MaStatusBar}">
            <DockPanel>
                <!-- This host's own status at the app's lower right (M.ORCH-T2101, the owner's request; in the icon strip before it
                     went): the held-work notices; the drive and RAM bars moved to the sidebar's This PC panel (M.ORCH-T2177).
                     The global login's tab's in code-behind (HostStatus.DataContext = model). The phone layout hides the status
                     bar and says the same in its touch bar's wrapped line (PhoneStatus, M.ORCH-T1570). -->
                <StackPanel x:Name="HostStatus" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="This machine's held-work notices">
                    <!-- On the host, the org members connected from their own PCs with their member keys (hub phase 1, M.ORCH-T1640):
                         a people glyph and a count, the tooltip naming them; collapsed when none is, and on every other machine. -->
                    <StackPanel x:Name="ConnectedMembersChip" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SpaceRL}"
                                mc:MaCallout.ToolTip="{Binding ConnectedMembersToolTip}" AutomationProperties.Name="{Binding ConnectedMembersText}"
                                Visibility="{Binding ConnectedMembersText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRS}" />
                        <TextBlock x:Name="ConnectedMembersText" Text="{Binding ConnectedMembersText}" VerticalAlignment="Center" Style="{StaticResource MaMutedText}" />
                    </StackPanel>
                    <!-- Allocation paused globally (the orchestrator settings allocate switch off, M.ORCH-T1491): in MaWarn like the memory
                         guard's held readout, shown only while the master switch is off, so a CLI's /allocate handing out nothing
                         is never silent. -->
                    <TextBlock x:Name="AllocatePausedText" Text="{Binding AllocatePausedText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRL}"
                               mc:MaCallout.ToolTip="{Binding AllocatePausedToolTip}" AutomationProperties.Name="{Binding AllocatePausedText}"
                               Visibility="{Binding AllocatePausedText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <!-- The first load lifted its loader before the ticket database answered (M.ORCH-T1936): in MaWarn, shown only
                         until that read lands and fills the dashboard in. -->
                    <TextBlock x:Name="TicketsLoadingText" Text="{Binding TicketsLoadingText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRL}"
                               mc:MaCallout.ToolTip="The ticket database is slow to answer; the dashboard fills in once it does" AutomationProperties.Name="{Binding TicketsLoadingText}"
                               AutomationProperties.LiveSetting="Polite" Visibility="{Binding TicketsLoadingText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <!-- The disk floor's hold (M.ORCH-T1679/T1692): in MaBad, shown only while the drive is under the floor even after a
                         self-cleanup, so nothing new starting is never silent; the tooltip says how much space lifts it. -->
                    <TextBlock x:Name="DiskHoldText" Text="{Binding DiskHoldText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceRL}"
                               mc:MaCallout.ToolTip="{Binding DiskHoldToolTip}" AutomationProperties.Name="{Binding DiskHoldToolTip}"
                               Visibility="{Binding DiskHoldText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRL}"
                           Text="Ctrl+Tab next login" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRL}">
                    <Run Text="{Binding RepoCount, Mode=OneWay}" /><Run Text=" repos under " /><Run Text="{Binding WorkspaceRoot, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="Announcer" DockPanel.Dock="Left" Width="0" Height="0" Opacity="0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Foreground="{DynamicResource MaBad}" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}">
                    <TextBlock.ToolTip>
                        <mc:MaCalloutToolTip><ItemsControl ItemsSource="{Binding Warnings}" Style="{StaticResource MaList}" /></mc:MaCalloutToolTip>
                    </TextBlock.ToolTip>
                    <Run Text="{Binding WarningsText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- The phone layout's touch bar (M.ORCH-T1543, MainWindow.Compact.cs), in the status bar's place: the keys a phone
             keyboard over Remote Desktop lacks, sent to the CLI on screen. Not focusable, so the terminal keeps the keyboard. -->
        <Border x:Name="TouchBar" Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource MaStatusBar}" Visibility="Collapsed"
                AutomationProperties.Name="Touch keys for the CLI">
          <DockPanel>
            <!-- The phone layout's status line (M.ORCH-T1570), in its footer since M.ORCH-T1571: what the menu bar's readouts and
                 the hidden status bar say, wrapped. The global login's tab's (PhoneStatus.DataContext = model), like the readouts. -->
            <WrapPanel x:Name="PhoneStatus" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="3,3,3,0">
                <TextBlock Text="{Binding AllocatePausedText}" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRM}"
                           mc:MaCallout.ToolTip="{Binding AllocatePausedToolTip}" Visibility="{Binding AllocatePausedText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="{Binding TicketsLoadingText}" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRM}"
                           Visibility="{Binding TicketsLoadingText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="{Binding DiskHoldText}" FontWeight="SemiBold" Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceRM}"
                           mc:MaCallout.ToolTip="{Binding DiskHoldToolTip}" Visibility="{Binding DiskHoldText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="{Binding RamBadText}" FontWeight="SemiBold" Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceRM}"
                           mc:MaCallout.ToolTip="{Binding RamToolTip}" Visibility="{Binding RamBadText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="{Binding RamWarnText}" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" Margin="{StaticResource SpaceRM}"
                           mc:MaCallout.ToolTip="{Binding RamToolTip}" Visibility="{Binding RamWarnText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="{Binding RamCalmText}" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRM}"
                           mc:MaCallout.ToolTip="{Binding RamToolTip}" Visibility="{Binding RamCalmText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Text="{Binding DiskFreeText}" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRM}"
                           Visibility="{Binding DiskFreeText, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                <TextBlock Foreground="{DynamicResource MaBad}" Margin="{StaticResource SpaceRM}" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}">
                    <TextBlock.ToolTip>
                        <mc:MaCalloutToolTip><ItemsControl ItemsSource="{Binding Warnings}" Style="{StaticResource MaList}" /></mc:MaCalloutToolTip>
                    </TextBlock.ToolTip>
                    <Run Text="{Binding WarningsText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource MaMutedText}">
                    <Run Text="{Binding RepoCount, Mode=OneWay}" /><Run Text=" repos" />
                </TextBlock>
            </WrapPanel>
            <!-- Talk to the CLI (M.ORCH-T1544): the mic opens Windows voice typing (Win+H) into the say box, which a phone
                 keyboard types into too; Send (or Enter) pastes it into the CLI on screen and submits it. -->
            <Grid x:Name="SayRow" DockPanel.Dock="Top" Margin="3,0,3,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MicButton" Grid.Column="0" Style="{StaticResource MaPrimaryButton}" Content="&#xE720;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" MinWidth="48" MinHeight="44" Margin="0,0,6,0"
                        Click="MicButton_Click" mc:MaCallout.ToolTip="Talk: Windows voice typing into the box (Win+H)" AutomationProperties.Name="Talk to the CLI" />
                <TextBox x:Name="SayBox" Grid.Column="1" Style="{StaticResource MaTextBox}" MinHeight="44" FontSize="15"
                         VerticalContentAlignment="Center" KeyDown="SayBox_KeyDown" AutomationProperties.Name="Say to the CLI" />
                <Button x:Name="SayButton" Grid.Column="2" Style="{StaticResource MaButton}" Content="Send" MinWidth="64" MinHeight="44" Margin="6,0,0,0"
                        Click="SayButton_Click" AutomationProperties.Name="Send to the CLI" />
            </Grid>
            <WrapPanel x:Name="TouchKeysPanel" HorizontalAlignment="Center">
                <!-- Each the library's MaButton (M.ORCH-T1549, M.ORCH-T1550: no style or EventSetter of the dashboard's own), not
                     focusable so the terminal keeps the keyboard, at a finger's size. -->
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="Esc" Tag="esc" AutomationProperties.Name="Escape" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="Tab" Tag="tab" AutomationProperties.Name="Tab" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="⇧Tab" Tag="shift-tab" mc:MaCallout.ToolTip="Shift+Tab: Claude Code's mode switch" AutomationProperties.Name="Shift Tab" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="↑" Tag="up" AutomationProperties.Name="Up arrow" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="↓" Tag="down" AutomationProperties.Name="Down arrow" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="←" Tag="left" AutomationProperties.Name="Left arrow" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="→" Tag="right" AutomationProperties.Name="Right arrow" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="^C" Tag="ctrl-c" mc:MaCallout.ToolTip="Ctrl+C: interrupt" AutomationProperties.Name="Control C" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="Enter" Tag="enter" AutomationProperties.Name="Enter" />
                <Button Style="{StaticResource MaButton}" Focusable="False" MinWidth="48" MinHeight="44" Margin="3" Click="TouchKey_Click" Content="/voice" Tag="voice" mc:MaCallout.ToolTip="Claude Code's own voice mode" AutomationProperties.Name="Claude voice mode" />
            </WrapPanel>
          </DockPanel>
        </Border>

        <!-- Covers every row until the first refresh lands (M.ORCH-T184). -->
        <Border x:Name="Loader" Grid.RowSpan="6" Grid.ColumnSpan="2" Style="{StaticResource MaCover}"
                Visibility="{Binding IsLoading, Converter={StaticResource Visible}}"
                AutomationProperties.Name="Loading the dashboard" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The library's MaSpinner turns on its own thread, so it keeps turning while this window's thread applies the
                     first snapshot and lays the dashboard out (M.ORCH-T200); MaAccent from its implicit style. -->
                <mc:MaSpinner x:Name="LoaderSpinner" Width="44" Height="44" StrokeThickness="4" HorizontalAlignment="Center"
                              AutomationProperties.Name="Loading the dashboard" />
                <TextBlock Margin="{StaticResource SpaceTL}" FontSize="15" HorizontalAlignment="Center" Text="Loading the workspace…" />
                <TextBlock Style="{StaticResource MaMutedText}" Margin="{StaticResource RowGutter}" HorizontalAlignment="Center"
                           Text="Reading every repo's sessions, tickets and usage" />
            </StackPanel>
        </Border>

        <!-- Logins (M.ORCH-T1308): the shared MaModal, centred over a dimmed window, holding the org-wide login actions (M.ORCH-T763):
             Add login (a per-CLI login of its own for an email), Sign in all (every roster account with no login of its own yet,
             M.ORCH-T604) and Report (the usage report, M.ORCH-T685), with what they did on the lines under them. They sat on the
             Settings dialog's Logins tab (M.ORCH-T804) until LAMP moved every setting to MindAttic Vault (the cog opens it), and
             are the global login's tab's (MainWindow.xaml.cs sets OrgToolbar's DataContext). Esc, its close button and the backdrop
             close it through ToggleLoginsCommand. Last in the root grid, spanning every row, over the loader too. -->
        <mc:MaModal x:Name="LoginsModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="User Management" AutomationProperties.Name="User Management" DialogWidth="720"
                    IsOpen="{Binding IsLoginsOpen}" CloseCommand="{Binding ToggleLoginsCommand}">
            <ScrollViewer x:Name="LoginsBody" Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,4,16,12" MaxHeight="560">
                <StackPanel x:Name="OrgToolbar" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="ORGANIZATION LOGINS" Style="{StaticResource MaSectionLabel}" />
                    <TextBlock Text="Sign in a per-CLI login for an email, sign in every roster account that has none yet, or write the usage report."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NewAccountBox" Style="{StaticResource MaTextBox}" Width="260" Height="32" VerticalAlignment="Center"
                                 Text="{Binding NewAccountEmail, UpdateSourceTrigger=PropertyChanged}"
                                 mc:MaTextBox.Placeholder="name@company.com"
                                 AutomationProperties.Name="Email of the login to add" />
                        <Button x:Name="AddLoginButton" Style="{StaticResource MaButton}" Content="Add login" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceLS}"
                                Command="{Binding AddAccountCommand}" VerticalAlignment="Center"
                                mc:MaCallout.ToolTip="Sign in a per-CLI login of its own for this email (orchestrator login --account), opening its login in the browser. The global login is left as it is." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SpaceTS}">
                        <Button x:Name="SignInAllButton" Style="{StaticResource MaButton}" Content="Sign in all" Padding="{StaticResource SpaceHMVXS}"
                                Command="{Binding SignInAllCommand}" VerticalAlignment="Center"
                                mc:MaCallout.ToolTip="Give every account in the roster with no per-CLI login yet its own (~/.claude-accounts), opening each one's login in the browser in turn, so every Claude Team seat stays signed in side by side. The global login stays the default." />
                        <Button x:Name="UsageReportButton" Style="{StaticResource MaButton}" Content="Report" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceLS}"
                                Command="{Binding UsageReportCommand}" VerticalAlignment="Center"
                                mc:MaCallout.ToolTip="Write the usage report (every member's 5-hour and weekly use, resets, points left to the weekly target, how fresh each reading is, the CLIs' spend and the API key's) as an HTML page and a Markdown file to share, and open the page (orchestrator report)." />
                    </StackPanel>
                    <TextBlock x:Name="OrgActionsMessage" Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTM}"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <!-- The billing detail line (M.ORCH-T628): what the last Sign in all or default switch did, a problem, and the open
                         CLIs still billing the other thing. -->
                    <TextBlock x:Name="BillingDetailLine" Text="{Binding BillingDetail}" Style="{StaticResource MaTileSubtitle}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding BillingDetail, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <!-- User credentials (M.ORCH-T1898, Ryan's ask): each roster member's own email-account password, kept in
                         MindAttic Vault's keyring (RosterCredentialStore), never in the git-synced settings/db - view, add, edit
                         or delete it right on its row, no masking (Ryan wants to review it plainly, not behind a reveal toggle). -->
                    <TextBlock Text="USER CREDENTIALS" Style="{StaticResource MaSectionLabel}" Margin="{StaticResource SpaceTL}" />
                    <TextBlock Text="Each roster member's own email account password, kept in MindAttic Vault: view, add, edit or delete it here."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}" />
                    <ItemsControl x:Name="UserCredentialsList" Style="{StaticResource MaList}" ItemsSource="{Binding UserCredentials}"
                                  AutomationProperties.Name="User credentials">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:UserCredentialRowViewModel}">
                                <Grid Margin="{StaticResource RowGutter}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource MaMutedText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource MaTextBox}" Height="32" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}"
                                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                             mc:MaTextBox.Placeholder="Password"
                                             AutomationProperties.Name="{Binding Name, StringFormat='Password for {0}'}" />
                                    <Button Grid.Column="2" Style="{StaticResource MaButton}" Content="Save" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceLS}"
                                            Command="{Binding SaveCommand}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Save the credential for {0}'}" />
                                    <Button Grid.Column="3" Style="{StaticResource MaButton}" Content="Delete" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceLS}"
                                            Command="{Binding DeleteCommand}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Delete the credential for {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </mc:MaModal>

        <!-- User Settings (M.ORCH-T1098, was Org limit and Rename), a person's login action (M.ORCH-T763) from their tab's
             right-click menu: the account's email (its ID, never edited); its Name (its tab's title; the member's name too) and
             Prefix (the badge its terminal titles start with, M.ORCH-T633); and its own 5-hour and weekly cutoffs (M.ORCH-T707), as
             orchestrator org limit sets them. Defaults fills in the default cutoffs; one Save keeps everything. -->
        <mc:MaModal x:Name="UserSettingsModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="User Settings" AutomationProperties.Name="User Settings" DialogWidth="460"
                    IsOpen="{Binding IsUserSettingsOpen}" CloseCommand="{Binding CancelUserSettingsCommand}">
            <StackPanel>
                <TextBlock Text="Email" Margin="{StaticResource SpaceBXS}" />
                <TextBox x:Name="UserSettingsEmailBox" Style="{StaticResource MaTextBox}" Height="32" IsReadOnly="True" Text="{Binding RenameEmail, Mode=OneWay}"
                         AutomationProperties.Name="Email" mc:MaCallout.ToolTip="The account's ID: it can't be changed" />
                <StackPanel x:Name="RenameSection" Visibility="{Binding HasRenameSection, Converter={StaticResource Visible}}">
                    <TextBlock Text="Name" Margin="{StaticResource SpaceTSBXS}" />
                    <TextBox x:Name="RenameNameBox" Style="{StaticResource MaTextBox}" Height="32" Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Name" />
                    <TextBlock Text="What the Orchestrator calls this login, on its tab. Blank goes back to the email's part before the @."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                    <TextBlock Text="Prefix" Margin="{StaticResource SpaceTSBXS}" />
                    <TextBox x:Name="RenamePrefixBox" Style="{StaticResource MaTextBox}" Height="32" Width="100" HorizontalAlignment="Left"
                             Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prefix" />
                    <TextBlock Text="The badge its terminal titles start with, e.g. JR in [JR] Repo [Claude]: up to 3 letters or digits. Blank takes it from the name."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                </StackPanel>
                <StackPanel x:Name="LimitSection" Visibility="{Binding HasLimitSection, Converter={StaticResource Visible}}">
                <TextBlock Text="5-hour cutoff (% of the 5-hour window)" Margin="{StaticResource SpaceTSBXS}" />
                <TextBox x:Name="LimitFiveHourBox" Style="{StaticResource MaTextBox}" Height="32" Width="100" HorizontalAlignment="Left"
                         Text="{Binding LimitFiveHour, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="5-hour cutoff percent" />
                <TextBlock Text="Weekly cutoff (% of the week)" Margin="{StaticResource SpaceTSBXS}" />
                <TextBox x:Name="LimitWeeklyBox" Style="{StaticResource MaTextBox}" Height="32" Width="100" HorizontalAlignment="Left"
                         Text="{Binding LimitWeekly, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly cutoff percent" />
                <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" />
                </StackPanel>
                <TextBlock Text="{Binding LimitError}" Foreground="{DynamicResource MaBad}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding LimitError, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </StackPanel>
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaButton}" Content="Defaults" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Command="{Binding ResetLimitCommand}"
                            Visibility="{Binding HasLimitSection, Converter={StaticResource Visible}}"
                            mc:MaCallout.ToolTip="Fill in the default cutoffs, 98% of the 5-hour window and 90% of the week; Save keeps them" />
                    <Button Style="{StaticResource MaButton}" Content="Cancel" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Command="{Binding CancelUserSettingsCommand}" />
                    <Button Style="{StaticResource MaPrimaryButton}" Content="Save" Padding="{StaticResource SpaceHLVS}" Command="{Binding SaveUserSettingsCommand}" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>

        <!-- Rename a CLI tab (M.ORCH-T1509), from its right-click menu: the name the person gives it, kept by the tab's identity
             (its TermHost tab file and the session-restore file, M.ORCH-T1432), so a reattach, undock and dock, a pop-out or a
             restarted dashboard keep it. Blank goes back to the name built from its repo. Driven from MainWindow.xaml.cs
             (OpenRenameTab/RenameTab*). -->
        <mc:MaModal x:Name="RenameTabModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="Rename tab" AutomationProperties.Name="Rename tab" DialogWidth="400">
            <StackPanel>
                <TextBlock Text="Name" Margin="{StaticResource SpaceBXS}" />
                <TextBox x:Name="RenameTabBox" Style="{StaticResource MaTextBox}" Height="32" AutomationProperties.Name="Tab name"
                         KeyDown="RenameTabBox_KeyDown" />
                <TextBlock x:Name="RenameTabHint" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
            </StackPanel>
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaButton}" Content="Reset" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Click="RenameTabReset_Click"
                            mc:MaCallout.ToolTip="Go back to the name built from its repo" />
                    <Button Style="{StaticResource MaButton}" Content="Cancel" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Click="RenameTabCancel_Click" />
                    <Button Style="{StaticResource MaPrimaryButton}" Content="Save" Padding="{StaticResource SpaceHLVS}" Click="RenameTabSave_Click" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>

        <!-- Close CLI? (M.ORCH-T1442, was a separate message box, M.ORCH-T1437): a CLI tab's X on a CLI still running asks here
             first; Cancel (focused), Esc, its own X and the backdrop keep the tab. The ConfirmCliClose setting turns it off.
             Driven from MainWindow.xaml.cs (ConfirmCloseTerminal/CloseCli*). -->
        <mc:MaModal x:Name="CloseCliModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="Close CLI?" AutomationProperties.Name="Close CLI" DialogWidth="400">
            <TextBlock x:Name="CloseCliQuestion" TextWrapping="Wrap" />
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseCliCancel" Style="{StaticResource MaButton}" Content="Cancel" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Click="CloseCliCancel_Click" />
                    <Button Style="{StaticResource MaPrimaryButton}" Content="_Close" AutomationProperties.Name="Close" Padding="{StaticResource SpaceHLVS}" Click="CloseCliConfirm_Click" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>

        <!-- The owner inbox (M.ORCH-T1689): everything waiting on the owner, one card each: its kind, the item (a ticket's id
             still links into Tickets Desktop, for prioritizing, blocking or closing it), its repo and how long it has waited,
             what it is, its own Approve/Clear/Release/Work it now/Delegate buttons (M.ORCH-T1732), and the command that answers
             it with a Copy button for whoever would rather paste it into a terminal. Every line wraps, so the cards read in the
             phone layout too. Esc, its close button and the backdrop close it. -->
        <mc:MaModal x:Name="InboxModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="{Binding InboxTitle}" AutomationProperties.Name="Inbox" DialogWidth="560"
                    IsOpen="{Binding IsInboxOpen}" CloseCommand="{Binding CloseInboxCommand}">
            <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,0,12,0" MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="InboxEmpty" Text="Nothing is waiting on you." Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                               Visibility="{Binding HasInbox, Converter={x:Static vm:Converters.FalseToVisible}}" />
                    <ItemsControl x:Name="InboxList" Style="{StaticResource MaRowList}" ItemsSource="{Binding InboxItems}" Focusable="False" AutomationProperties.Name="Waiting on you">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InboxRowViewModel}">
                                <Border Style="{StaticResource MaRowCard}" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Visibility="{Binding IsTicket, Converter={StaticResource Visible}}">
                                            <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" /><Run Text="  " />
                                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding TicketId}"
                                                       AutomationProperties.Name="{Binding Id, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Id, Mode=OneWay}" /></Hyperlink>
                                            <Run Text="  " /><Run Text="{Binding Where, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Visibility="{Binding IsTicket, Converter={x:Static vm:Converters.FalseToVisible}}">
                                            <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" /><Run Text="  " />
                                            <Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="  " /><Run Text="{Binding Where, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                        <!-- Acts on the row directly (M.ORCH-T1732), no terminal needed: Approve/Clear/Release run at
                                             once, Work it now also starts it, and Delegate assigns it to the picker's choice (or back
                                             to nobody). Each is the same change Tickets Desktop's own buttons make. -->
                                        <WrapPanel Margin="{StaticResource RowGutter}" Visibility="{Binding IsTicket, Converter={StaticResource Visible}}">
                                            <Button Style="{StaticResource MaPrimaryButton}" Content="Approve" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanApprove, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.ApproveInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Approve it for work" AutomationProperties.Name="{Binding Id, StringFormat='Approve {0}'}" />
                                            <Button Style="{StaticResource MaPrimaryButton}" Content="Clear" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanClearWaiting, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.ClearWaitingInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Take the waiting-on-owner label off it" AutomationProperties.Name="{Binding Id, StringFormat='Clear {0}'}" />
                                            <Button Style="{StaticResource MaButton}" Content="Release" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanRelease, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.ReleaseInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Put it back in the queue" AutomationProperties.Name="{Binding Id, StringFormat='Release {0}'}" />
                                            <Button Style="{StaticResource MaButton}" Content="Work it now" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanWorkNow, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.WorkInboxNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Approve (or clear) it, then start it at once if it's workable" AutomationProperties.Name="{Binding Id, StringFormat='Work {0} now'}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanDelegate, Converter={StaticResource Visible}}">
                                                <mc:MaPicker Width="150" Margin="0,0,6,6" VerticalAlignment="Center"
                                                             ItemsSource="{Binding DataContext.InboxAssignees, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             DisplayMemberPath="Name" SelectedItem="{Binding Assignee}"
                                                             AutomationProperties.Name="{Binding Id, StringFormat='Delegate {0} to'}" />
                                                <Button Style="{StaticResource MaButton}" Content="Delegate" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                        Command="{Binding DataContext.DelegateInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                        mc:MaCallout.ToolTip="Assign it to the picker's choice (Unassigned hands it out again)" AutomationProperties.Name="{Binding Id, StringFormat='Delegate {0}'}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <!-- An addition waiting on an active milestone (M.ORCH-T1685): the owner approves or declines it here;
                                             a decline with a reason is the CLI's (the command below). -->
                                        <WrapPanel Margin="{StaticResource RowGutter}" Visibility="{Binding CanAnswerAddition, Converter={StaticResource Visible}}">
                                            <Button Style="{StaticResource MaPrimaryButton}" Content="Approve" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ApproveAdditionInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Let it join the milestone" AutomationProperties.Name="{Binding Title, StringFormat='Approve: {0}'}" />
                                            <Button Style="{StaticResource MaButton}" Content="Decline" Padding="{StaticResource SpaceHLVS}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.DeclineAdditionInboxCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Keep it off the milestone; it stays a ticket of its own" AutomationProperties.Name="{Binding Title, StringFormat='Decline: {0}'}" />
                                        </WrapPanel>
                                        <DockPanel Margin="{StaticResource RowGutter}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Copy" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceLS}" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.CopyInboxActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="Copy the command" AutomationProperties.Name="{Binding Action, StringFormat='Copy the command: {0}'}" />
                                            <TextBlock Text="{Binding Action}" FontFamily="Consolas" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaPrimaryButton}" Content="Close" Padding="{StaticResource SpaceHLVS}" Command="{Binding CloseInboxCommand}" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>

        <!-- The saved plans (M.ORCH-T1826): one card per markdown file under docs\plans in the workspace or a repo, newest
             first: its title (a link that opens the file), a Show in folder button, its repo and when it was last
             written, its status when the file has a "Status:" line, and its summary. Every line wraps, so the cards read
             in the phone layout too. Esc, its close button and the backdrop close it. -->
        <mc:MaModal x:Name="PlansModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="{Binding PlansTitle}" AutomationProperties.Name="Plans" DialogWidth="560"
                    IsOpen="{Binding IsPlansOpen}" CloseCommand="{Binding ClosePlansCommand}">
            <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,0,12,0" MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="PlansEmpty" Text="{Binding PlansEmptyText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                               Visibility="{Binding HasPlans, Converter={x:Static vm:Converters.FalseToVisible}}" />
                    <ItemsControl x:Name="PlansList" Style="{StaticResource MaRowList}" ItemsSource="{Binding PlansItems}" Focusable="False" AutomationProperties.Name="Saved plans">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlanRowViewModel}">
                                <Border Style="{StaticResource MaRowCard}" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Content="Show in folder" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceLS}" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.RevealPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    mc:MaCallout.ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Title, StringFormat='Show in folder: {0}'}" />
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Hyperlink Style="{StaticResource MaHyperlink}" CommandParameter="{Binding}"
                                                           Command="{Binding DataContext.OpenPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           AutomationProperties.Name="{Binding Title, StringFormat='Open the plan: {0}'}"><Run Text="{Binding Title, Mode=OneWay}" /></Hyperlink>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                        <TextBlock TextWrapping="Wrap" Margin="{StaticResource RowGutter}" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
                                            <Run Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" /><Run Text="  " /><Run Text="{Binding Status, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}"
                                                   Visibility="{Binding HasSummary, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaPrimaryButton}" Content="Close" Padding="{StaticResource SpaceHLVS}" Command="{Binding ClosePlansCommand}" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>

        <!-- The toolbar's Notifications button (M.ORCH-T2241): the toast dots' replacement since the per-login home page
             that drew them was deleted entirely (M.ORCH-T2238) - a toast is still raised from ~20 call sites (sign-in
             failures, a stuck session, reminders, quickload results, "this repo needs you"...), merged across every tab,
             newest first (M.ORCH-T1574, AllToasts). Clicking a row goes to its CLI's tab or ticket and removes it
             everywhere (OpenToastCommand); the X alone just dismisses it (DismissToastCommand). Esc, its close button and
             the backdrop close the list. -->
        <mc:MaModal x:Name="NotificationsModal" Grid.RowSpan="6" Grid.ColumnSpan="2" Title="{Binding NotificationsTitle}" AutomationProperties.Name="Notifications" DialogWidth="420"
                    IsOpen="{Binding IsNotificationsOpen}" CloseCommand="{Binding CloseNotificationsCommand}">
            <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,0,12,0" MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="NotificationsEmpty" Text="No notifications." Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                               Visibility="{Binding HasNotifications, Converter={x:Static vm:Converters.FalseToVisible}}" />
                    <ItemsControl x:Name="NotificationsList" Style="{StaticResource MaRowList}" ItemsSource="{Binding AllToasts}" Focusable="False" AutomationProperties.Name="Notifications">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                                <Border Style="{StaticResource MaRowCard}" AutomationProperties.Name="{Binding Title}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource MaToolButton}" Content="✕" Padding="{StaticResource SpaceHLVS}" VerticalAlignment="Top"
                                                Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                mc:MaCallout.ToolTip="Dismiss" AutomationProperties.Name="{Binding Title, StringFormat='Dismiss {0}'}" />
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap">
                                                <mc:MaStatusLight Width="10" Height="10" Foreground="{Binding Accent}" />
                                                <Hyperlink Style="{StaticResource MaHyperlink}" CommandParameter="{Binding}"
                                                           Command="{Binding DataContext.OpenToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           AutomationProperties.Name="{Binding Title, StringFormat='Open: {0}'}"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /></Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaPrimaryButton}" Content="Close" Padding="{StaticResource SpaceHLVS}" Command="{Binding CloseNotificationsCommand}" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>
    </Grid>
</Window>
