<Window x:Class="MindAttic.Orchestrator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        xmlns:vm="clr-namespace:MindAttic.Orchestrator.Wpf.ViewModels"
        xmlns:local="clr-namespace:MindAttic.Orchestrator.Wpf"
        mc:MaWindow.ThemedTitleBar="True"
        Title="MindAttic Orchestrator" Width="1480" Height="920" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/logo.ico"
        Background="{DynamicResource MaChrome}" Foreground="{DynamicResource MaText}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Escape" Command="{x:Static vm:WindowCommands.Escape}" />
        <!-- The next and the previous login's tab (M.ORCH-T613). -->
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <!-- The next and the previous CLI (Terminal) tab of the shown login's (M.ORCH-T824): works even while a terminal
             holds keyboard focus, since plain Left/Right there move the CLI's own cursor instead of the tab strip's selection. -->
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding Terminals.PreviousCommand}" />
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding Terminals.NextCommand}" />
        <!-- Ctrl+Plus / Ctrl+Minus / Ctrl+0 (main row and number pad) are the library's ZoomLevel's, added in MainWindow.xaml.cs.
             While a terminal holds focus only F5, Ctrl+Tab, Ctrl+Shift+Tab, Ctrl+Left/Right (and the paste keys) act
             (M.ORCH-T846): every other binding here (Esc, the zoom keys) is gated so its key reaches the CLI. -->

    </Window.InputBindings>

    <Window.Resources>
        <!-- A ticket id: a link that opens the ticket in Tickets Desktop to view, approve, prioritize or close it (M.ORCH-T500).
             Its CommandParameter is the id. The library's MaHyperlink (MaLink, SemiBold, underlined on hover and keyboard focus,
             so it reads as a link without colour), plus the command and tooltip. -->
        <Style x:Key="TicketLink" TargetType="Hyperlink" BasedOn="{StaticResource MaHyperlink}">
            <Setter Property="Command" Value="{Binding DataContext.OpenInTicketsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ToolTip" Value="Open it in Tickets Desktop to view, approve, prioritize, assign, block or close it" />
        </Style>

        <!-- A ticket on a person's Tickets view (M.ORCH-T668): who it's assigned to, with their status light; while its user is out
             of room it says why it waits. Assigning, reassigning and "Redelegate now" are Tickets Desktop's (M.ORCH-T762): the
             Assign in Tickets link, like the id and title, opens the ticket there. -->
        <DataTemplate x:Key="UserTicketTemplate" DataType="{x:Type vm:UserTicketRowViewModel}">
            <Border x:Name="UserTicketCard" Style="{StaticResource MaRowCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource SpaceLM}">
                        <mc:MaStatusLight x:Name="AssigneeLight" Status="{Binding Assignee.Status, TargetNullValue={x:Static mc:MaStatus.Other}}" Label="{Binding Assignee.StatusLabel}" Margin="{StaticResource SpaceRS}"
                                          VerticalAlignment="Center" Visibility="{Binding IsPinned, Converter={StaticResource Visible}}" />
                        <TextBlock x:Name="AssigneeText" Text="{Binding AssigneeText}" VerticalAlignment="Center" Margin="{StaticResource SpaceRM}"
                                   ToolTip="Who it's assigned to: it's dispatched only on their login, and waits for them while they're out of room" />
                        <TextBlock VerticalAlignment="Center">
                            <Hyperlink x:Name="AssignInTickets" Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                       ToolTip="Assign, reassign or redelegate it in Tickets Desktop"
                                       AutomationProperties.Name="{Binding Id, StringFormat='Assign {0} in Tickets Desktop'}"><Run Text="Assign in Tickets" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock>
                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                       AutomationProperties.Name="{Binding Id, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Id, Mode=OneWay}" /></Hyperlink>
                            <Run Text="  " /><Run Text="{Binding Repo, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource MaMuted}" />
                            <Run Text="{Binding Priority, Mode=OneWay}" Foreground="{DynamicResource MaWarn}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" Margin="{StaticResource RowGutter}">
                            <!-- The title opens it too (M.ORCH-T762: every ticket id or title the dashboard shows links there). -->
                            <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding Id}"
                                       AutomationProperties.Name="{Binding Summary, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding Summary, Mode=OneWay}" /></Hyperlink>
                        </TextBlock>
                        <!-- Its status, muted; while it waits for its user, in MaWarn and SemiBold (M.ORCH-T667: one line each,
                             the other collapsed, so no style of the dashboard's own). The ids it names link into Tickets Desktop. -->
                        <Grid x:Name="UserTicketStatus" Margin="{StaticResource RowGutter}" Visibility="{Binding Status, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <TextBlock local:TicketText.Text="{Binding Status}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                                       Visibility="{Binding IsWaiting, Converter={x:Static vm:Converters.FalseToVisible}}" />
                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaWarn}" TextWrapping="Wrap"
                                       Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One dashboard tab per Claude login (M.ORCH-T613): the global ~/.claude login first, then each per-CLI login under
             ~/.claude-accounts, by its name (M.ORCH-T614, its email in the tooltip) and its terminal tabs' color (M.ORCH-T616),
             with how many of its repos need you. Everything below is the chosen login's: the window shows that tab's view model
             (MainWindow.xaml.cs sets its DataContext), and this strip keeps the global login's tab's, which holds every tab.
             Shown once there's a second login; Ctrl+Tab and Ctrl+Shift+Tab step through them. Its own row above the header,
             so the header, chart and view pills can fold away on a tab while the strip stays. -->
        <!-- The window's upper-right corner (M.ORCH-T678): the library's sun/moon MaThemeToggle switches the whole dashboard
             between dark (the default) and light at once, every view following, and the choice is saved in the orchestrator's
             settings (ThemeChoice, wired in MainWindow.xaml.cs) so it holds across restarts. It shares the login strip's row and
             stays when the strip is hidden. -->
        <!-- No emergency billing toggle any more (M.ORCH-T906, which replaced M.ORCH-T770's): the Vault's API key is a person
             with its own tab in the strip below, its own Launcher and CLIs billing API credits; orchestrator billing stays the
             command-line tool. -->
        <DockPanel x:Name="TopRow" Grid.Row="0" Margin="{StaticResource SpaceLXLTLRXL}">
        <mc:MaThemeToggle x:Name="ThemeToggle" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,0,0,0" />
        <!-- Settings (M.ORCH-T804): a single cog between the emergency key and the sun/moon toggle, the only way to open
             Settings (the toolbar's Settings button and the 5-hour and week cards no longer do). The library's MaToolButton
             with Segoe's well-known 'Settings' glyph (E713, in both Segoe Fluent Icons and Segoe MDL2 Assets, the same font
             stack the theme toggle draws from). Bound to the shown tab's ToggleSettingsCommand, like the modal it opens. -->
        <Button x:Name="SettingsButton" Style="{StaticResource MaToolButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                Content="&#xE713;" Command="{Binding ToggleSettingsCommand}" ToolTip="Settings"
                AutomationProperties.Name="Settings" />
        <!-- Tickets (M.ORCH-T878): beside the cog, Segoe's Tag glyph (E8EC) opens Tickets Desktop, or brings its window
             forward when it's already running (TicketsApp.cs); a toast says so when it isn't installed. -->
        <Button x:Name="TicketsButton" Style="{StaticResource MaToolButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                Content="&#xE8EC;" Command="{Binding OpenTicketsAppCommand}" ToolTip="Open Tickets"
                AutomationProperties.Name="Open Tickets" />
        <!-- Team wall (M.ORCH-T936): Segoe's People glyph (E716) opens a grid of every live CLI, this machine's and every
             teammate's gateway's (orchestrator gateway remote add), each a small read-only terminal (TeamWallWindow.cs). -->
        <Button x:Name="TeamWallButton" Style="{StaticResource MaToolButton}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                Content="&#xE716;" Click="TeamWallButton_Click" ToolTip="Team wall: everyone's live CLIs"
                AutomationProperties.Name="Team wall" />
        <!-- Organizations above people (M.ORCH-T655): one pill per org (orchestrator orgs add), shown once there's a second,
             with how many of its people's repos need you; the person tabs below are the chosen org's. Kept on the global login's
             tab (MainWindow.xaml.cs), which holds every org, like the person strip under it. -->
        <StackPanel>
        <ListBox x:Name="OrgStrip" Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}"
                 Padding="0" Margin="{StaticResource SpaceBS}" AutomationProperties.Name="Organizations, each with its own people"
                 Visibility="{Binding HasOrgs, Converter={StaticResource Visible}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OrgViewModel}">
                    <StackPanel x:Name="OrgItem" Orientation="Horizontal" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}" />
                        <TextBlock VerticalAlignment="Center" Margin="{StaticResource SpaceLS}"
                                   Visibility="{Binding Badge, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                            <Run Text="&#x2022; " /><Run Text="{Binding Badge, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" need you" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- The org-wide login actions (Add login, Sign in all, Report) moved from here into Settings' Logins tab (M.ORCH-T804). -->
        <!-- No wrap, ever (M.ORCH-T822): every tab is a fixed width (PersonTabWidth below), so once there are enough logins the
             strip is wider than the window. A plain horizontal ScrollViewer around it, paged by the < and > buttons
             (LoginTabScroller_ScrollChanged/LoginTabScrollLeft_Click/Right_Click in MainWindow.xaml.cs), hidden while
             everything fits and disabled at each end rather than wrapping around. -->
        <Grid x:Name="LoginTabStripRow" Visibility="{Binding HasLoginTabs, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LoginTabScrollLeft" Grid.Column="0" Style="{StaticResource MaToolButton}" Content="&#xE76B;"
                    Click="LoginTabScrollLeft_Click" Margin="{StaticResource SpaceRXS}" Visibility="Collapsed"
                    ToolTip="Scroll the login tabs left" AutomationProperties.Name="Scroll the login tabs left" />
            <ScrollViewer x:Name="LoginTabScroller" Grid.Column="1" Style="{StaticResource MaBodyScroll}" mc:MaScrollArea.Gutter="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          ScrollChanged="LoginTabScroller_ScrollChanged">
        <mc:MaTabControl x:Name="LoginTabStrip" ShowContent="False" ItemsSource="{Binding OrgTabs}" SelectedItem="{Binding StripSelection}"
                         AutomationProperties.Name="Claude logins, one dashboard tab each"
                         ContextMenuOpening="OnLoginTabContextMenu">
            <!-- Status at a glance (M.ORCH-T630), all the library's MaTabItem (M.ORCH-T667): a status icon before the name
                 (M.ORCH-T757, in place of the status light): a pause icon while the login has no CLI open; a steady green play
                 arrow while any of its CLIs (hosted inside the Orchestrator's Terminals panel or outside it) is working; a
                 steady pause icon once every one of its open CLIs has stopped (M.ORCH-T890, never flashing since M.ORCH-T1116); a gray 'disabled' icon
                 past its 5-hour or weekly cutoff or signed out. The icons are the
                 library's icon font (Segoe Fluent Icons / MDL2, as MaIconButton draws) in theme tokens. The icon's word and the
                 status word are in the tooltip and the accessible name, so neither colour nor the picture is the only cue; the
                 person's terminal colour is the tab's accent, and its trailing text their live 5-hour and weekly use against
                 their own cutoffs, "5hr: 29% | wk: 15%" (M.ORCH-T793/T968, cutoffs in the tooltip; no 'N need you' count, no '% left'). -->
            <!-- The API key is a person here like any other (M.ORCH-T906): its tab comes after everyone's, its trailing text its
                 money ("$37.66 left") rather than 5-hour and weekly use. -->
            <mc:MaTabControl.ItemContainerStyle>
                <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                    <Setter Property="Accent" Value="{Binding TabBrush}" />
                    <Setter Property="Trailing" Value="{Binding TabTrailing}" />
                    <Setter Property="ToolTip" Value="{Binding TabHoverTip}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding TabTip}" />
                </Style>
            </mc:MaTabControl.ItemContainerStyle>
            <mc:MaTabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <!-- Every person's tab the same width (M.ORCH-T803): WPF sizes a TabItem to its header's content by default,
                         so Amy/Erin/Honey/Jordan/Ryan's differing name lengths made the strip uneven. Width is plain
                         FrameworkElement's, not the library's MaTabItem's own (M.ORCH-T667's ItemContainerStyle may only set
                         MaTabItem's own properties), so it's set directly on the generated container once this header loads
                         (MainWindow.xaml.cs's LoginTabItem_Loaded), the same code-behind workaround as the busy icon's glow
                         below. The 'API key' and 'Miscellaneous' tabs are left to their own content. -->
                    <StackPanel x:Name="LoginTabItem" Orientation="Horizontal" Loaded="LoginTabItem_Loaded">
                        <Grid x:Name="TabStatusIcon" VerticalAlignment="Center" Margin="{StaticResource SpaceRS}">
                            <TextBlock x:Name="TabIdleIcon" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource MaText}" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                       Visibility="{Binding IsTabIdle, Converter={StaticResource Visible}}" />
                            <!-- A steady green play arrow while any of this login's CLIs is working (M.ORCH-T890: no flash). -->
                            <TextBlock x:Name="TabBusyIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource MaGood}" VerticalAlignment="Center"
                                       AutomationProperties.Name="{Binding TabActivityWord}"
                                       Visibility="{Binding IsTabBusy, Converter={StaticResource Visible}}" />
                            <!-- Every open CLI of this person has stopped (M.ORCH-T890: no turn, no subagent, no claim, no prompt,
                                 as `orchestrator busy` judges it): the play arrow becomes a steady pause icon (M.ORCH-T1116: it
                                 never flashes). Its words are in the tooltip and accessible name. -->
                            <TextBlock x:Name="TabStoppedIcon" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource MaText}" VerticalAlignment="Center"
                                       AutomationProperties.Name="{Binding TabActivityWord}"
                                       Visibility="{Binding IsTabAllStopped, Converter={StaticResource Visible}}" />
                            <TextBlock x:Name="TabDisabledIcon" Text="&#xE733;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource MaMuted}" VerticalAlignment="Center" AutomationProperties.Name="{Binding TabActivityWord}"
                                       Visibility="{Binding IsTabDisabled, Converter={StaticResource Visible}}" />
                        </Grid>
                        <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- The needs-you flag (M.ORCH-T790): a small red flag at the end of the tab line, only while one of the
                             person's CLIs is genuinely blocked on you (a permission prompt, a question, or a /crossrepo or /allocate
                             only you may type), gone once they're running again. Not a count: how many is in the tab's tooltip and
                             accessible name, so the picture is never the only cue. -->
                        <TextBlock x:Name="TabNeedsYouFlag" Text="&#xE7C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource MaBad}" VerticalAlignment="Center" Margin="{StaticResource SpaceLS}"
                                   AutomationProperties.Name="Blocked waiting on you"
                                   Visibility="{Binding TabNeedsYou, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DataTemplate>
            </mc:MaTabControl.ItemTemplate>
        </mc:MaTabControl>
            </ScrollViewer>
            <Button x:Name="LoginTabScrollRight" Grid.Column="2" Style="{StaticResource MaToolButton}" Content="&#xE76C;"
                    Click="LoginTabScrollRight_Click" Margin="{StaticResource SpaceLXS}" Visibility="Collapsed"
                    ToolTip="Scroll the login tabs right" AutomationProperties.Name="Scroll the login tabs right" />
        </Grid>
        </StackPanel>
        </DockPanel>

        <!-- A person's CLIs (M.ORCH-T810), fixed under their person tab (M.ORCH-T861): the person tabs above, then that person's
             terminal tabs right beneath them, then the chosen terminal, none of which scroll; everything under them (the stats, the
             toolbar, the 5-hour chart and Tickets) scrolls in the body (AgentsBody). One tab per CLI of theirs running
             inside the dashboard (sent by the Launcher when it runs inside the Orchestrator, M.LNCH-T77), each a live ConPTY
             terminal with the Windows Terminal renderer, underlined in its login's colour and led by its badge (an MaTag in that
             colour). The terminals are native windows (HwndHosts), which WPF never clips to a scroll view, so the frame sits outside
             the body rather than in it: it can never scroll up over the tabs, nor be virtualized out of the body's list. They all
             live in the one host grid below (MainWindow.xaml.cs adds and removes them, since a template would start a new CLI each
             time it was shown) and only the shown person's chosen one is visible; the window hides them under a dialog or the loader. -->
        <StackPanel x:Name="TerminalsPanel" Grid.Row="1" Margin="{StaticResource SpaceLXLTSRXL}" Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">
            <TextBlock x:Name="TerminalsEmptyHint" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}"
                       Text="No terminals open on this login. When the Launcher runs inside the Orchestrator, each CLI it opens arrives here as a tab of its own: a live terminal you can type in."
                       Visibility="{Binding Terminals.HasPanes, Converter={x:Static vm:Converters.FalseToVisible}}" />
            <mc:MaTabControl x:Name="TerminalTabs" ShowContent="False" ContextMenuOpening="OnTerminalTabContextMenu" ItemsSource="{Binding Terminals.Panes}" SelectedItem="{Binding Terminals.SelectedPane}"
                             Margin="{StaticResource SpaceBS}" AutomationProperties.Name="Terminals" AutomationProperties.HelpText="{Binding Terminals.Summary}"
                             Visibility="{Binding Terminals.HasPanes, Converter={StaticResource Visible}}">
                <mc:MaTabControl.ItemContainerStyle>
                    <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                        <Setter Property="Accent" Value="{Binding TabBrush}" />
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </mc:MaTabControl.ItemContainerStyle>
                <mc:MaTabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TerminalPaneViewModel}">
                        <StackPanel x:Name="TerminalTab" Orientation="Horizontal">
                            <mc:MaBadge x:Name="TerminalBadge" Style="{StaticResource MaTag}" Content="{Binding Badge}" Background="{Binding TabBrush}"
                                        Foreground="{Binding BadgeForeground}" Margin="{StaticResource SpaceRS}" VerticalAlignment="Center"
                                        Visibility="{Binding Badge, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" />
                            <!-- Shared with remote viewers (M.ORCH-T935), and an eye while someone watches it remotely. -->
                            <TextBlock x:Name="TerminalSharedGlyph" Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource MaMutedText}"
                                       Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" ToolTip="Shared with remote viewers (right-click to change)" AutomationProperties.Name="Shared with remote viewers"
                                       Visibility="{Binding IsShared, Converter={StaticResource Visible}}" />
                            <TextBlock x:Name="TerminalWatchedGlyph" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MaWarn}"
                                       Margin="{StaticResource SpaceLS}" VerticalAlignment="Center" ToolTip="{Binding BroadcastText}"
                                       AutomationProperties.Name="Being watched remotely"
                                       Visibility="{Binding IsWatched, Converter={StaticResource Visible}}" />
                            <Button x:Name="TerminalCloseButton" Style="{StaticResource MaToolButton}" Content="&#xE711;" Margin="8,-4,0,-4"
                                    Width="22" Height="18" FontSize="10" VerticalAlignment="Center"
                                    Command="{Binding DataContext.Terminals.CloseCommand, RelativeSource={RelativeSource AncestorType=mc:MaTabControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Close {0}'}"
                                    ToolTip="Close this terminal, ending its CLI" />
                        </StackPanel>
                    </DataTemplate>
                </mc:MaTabControl.ItemTemplate>
            </mc:MaTabControl>
            <!-- "Being watched" (M.ORCH-T935): while a remote viewer is attached to the shown CLI through the team gateway, or its
                 broadcast is paused, who is watching and how, with Pause broadcast (Ctrl+Shift+B, even while the terminal holds
                 focus) and Pause all. Pausing never touches this dashboard's own view. Sharing, masking and "share my sessions"
                 are on the CLI tab's right-click menu. -->
            <Border x:Name="BroadcastBanner" Style="{StaticResource MaCard}" DataContext="{Binding Terminals.SelectedPane}" Margin="{StaticResource SpaceBS}" Padding="{StaticResource SpaceHSVXS}"
                    Background="Transparent" BorderBrush="{DynamicResource MaWarn}" CornerRadius="4"
                    Visibility="{Binding ShowBroadcastBanner, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
                    AutomationProperties.Name="Remote viewers" AutomationProperties.LiveSetting="Assertive">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BroadcastPauseButton" Style="{StaticResource MaButton}" Content="{Binding PauseButtonText}"
                                Command="{Binding DataContext.AllTerminals.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" ToolTip="Pause or resume what remote viewers see of this CLI (Ctrl+Shift+B)" />
                        <Button x:Name="BroadcastPauseAllButton" Style="{StaticResource MaButton}" Margin="{StaticResource SpaceLS}"
                                Content="{Binding DataContext.AllTerminals.PauseAllText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding DataContext.AllTerminals.PauseAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Pause or resume what remote viewers see of every CLI" />
                    </StackPanel>
                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MaWarn}" VerticalAlignment="Center" Margin="{StaticResource SpaceRS}" />
                    <TextBlock x:Name="BroadcastText" Text="{Binding BroadcastText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MaWarn}" />
                </DockPanel>
            </Border>
        </StackPanel>
        <!-- The chosen terminal, in its own fixed row right under the terminal tabs (M.ORCH-T861), outside the scrolling body:
             shown on a signed-in person's page that has a terminal, like the tabs above. Shares whatever's left of the window
             below the tab strip and the terminal tabs with the body below it (M.ORCH-T1072, MainWindow.xaml.cs
             SizeTerminalRow): the body (the stats, the 5-hour/weekly chart and the tickets) used to be pinned to a fixed peek
             while the terminal took every leftover pixel, which left a dead stretch of unwritten terminal background under a
             short transcript (M.ORCH-T1166); now the terminal's capped at a comfortable height and the body picks up whatever
             it doesn't use, its own ScrollViewer reaching the rest. -->
        <Grid x:Name="TerminalFrameRow" Grid.Row="2" Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">
            <!-- No card and no border (M.ORCH-T1095): a plain Grid, the tab page's own width. -->
            <Grid x:Name="TerminalFrame" MinHeight="160" Margin="{StaticResource SpaceLXLRXLBS}"
                  Visibility="{Binding Terminals.HasPanes, Converter={StaticResource Visible}}">
                <!-- WPF claims arrow keys (and Tab) for its own directional/tab focus navigation even when a hosted
                     native window (the terminal, an HwndHost) has Win32 keyboard focus, so a CLI's arrow-key menu never
                     sees them (M.ORCH-T833): switched off here so they pass straight through to the terminal. -->
                <Grid x:Name="TerminalPanesHost" KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None" />
            </Grid>
        </Grid>

        <!-- Toasts: what just happened (a session finished its turn, the pace changed). Their own row, so they push the page
             down instead of covering whatever has keyboard focus (WCAG 2.4.11). The library's MaToastHost: each ToastViewModel's
             Title, Body and Accent on an MaToast, clicking it opens what it's about, its x dismisses it, and each new one is read
             out politely. -->
        <mc:MaToastHost x:Name="ToastRow" Grid.Row="3" ItemsSource="{Binding Toasts}" Margin="{StaticResource SpaceLXLRXLBS}"
                        OpenCommand="{Binding OpenToastCommand}" DismissCommand="{Binding DismissToastCommand}"
                        AutomationProperties.Name="Notifications" />

        <!-- A roster account not signed in on this machine yet (M.ORCH-T615): its tab shows only its Sign in, then, once signed
             in, the whole page and Open Launcher at the next refresh. -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="{StaticResource SpaceXL}"
                    Visibility="{Binding ShowsSignIn, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding SignInPrompt}" TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource SpaceBL}" />
            <Button Style="{StaticResource MaPrimaryButton}" Command="{Binding SignInTabCommand}" Content="Sign in" Padding="{StaticResource SpaceHLVS}"
                    HorizontalAlignment="Center" AutomationProperties.Name="{Binding TabTitle, StringFormat='Sign {0} in'}" />
            <TextBlock Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="{StaticResource SpaceTM}"
                       Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
                <!-- Same row (M.ORCH-T958): swapped in for the 5-hour card, so Tickets stays right after it. -->

        <!-- The old 'API key' billing tab's own body (M.ORCH-T630) is gone (M.ORCH-T906): the API key is a person, whose page is
             the same as everyone's below, its money in place of Claude's 5-hour and weekly meters. -->

        <!-- The person's scrolling body, under their fixed terminal: their stats, the toolbar, the 5-hour chart and the tickets
             assigned to them (the Current work agent card board is gone, M.ORCH-T837). One virtualized list (M.ORCH-T754,
             MainWindow.xaml.cs): only what's on screen is built. -->
        <ScrollViewer x:Name="AgentsBody" Grid.Row="4" Style="{StaticResource MaBodyScroll}"
                      Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">
            <StackPanel>
                <!-- A person's page (M.ORCH-T763, reordered by M.ORCH-T826), read top to bottom under their fixed person tab,
                     terminal tabs and terminal (M.ORCH-T861): their stats (the 5-hour window, the week, their cutoffs and when
                     Claude's meter was last read), then the toolbar, the 5-hour chart and Tickets, all in this
                     one scrolling body. The body's MaBodyScroll owns the window's left/right gutter; nothing inside it adds its own,
                     so the tiles share both edges (M.ORCH-T192). The tiles are equal cells that together span the row at any width. -->
                <StackPanel x:Name="Header" Margin="{StaticResource SpaceTS}" Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">

                <mc:MaTileGrid x:Name="StatTiles" MinItemWidth="200" Spacing="10" RowSpacing="10" Balanced="True" UniformRows="True"
                                   AutomationProperties.Name="Summary">
                    <!-- The API key's person (M.ORCH-T906) has no 5-hour or weekly window: money instead. What's left of its
                         starting credit, what it has spent (today and lately), and when it runs out at the recent rate. -->
                    <Button x:Name="ApiLeftTile" Style="{StaticResource MaSmallStat}" Command="{Binding RefreshCommand}" Height="74" Visibility="{Binding IsApiKeyTab, Converter={StaticResource Visible}}"
                            ToolTip="What's left of the API key's starting credit (orchestrator billing credit &lt;usd&gt; sets it): an estimate from the transcripts' tokens at Anthropic's list prices."
                            AutomationProperties.Name="{Binding ApiLeftHeadline, StringFormat='API credit left: {0}'}">
                        <StackPanel>
                            <TextBlock Text="Credit Left" Style="{StaticResource MaSectionLabel}" Margin="{StaticResource SpaceBXS}" />
                            <TextBlock Text="{Binding ApiLeftHeadline}" Style="{StaticResource MaStatValue}" />
                            <TextBlock Text="{Binding ApiLeftCaption}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ApiSpentTile" Style="{StaticResource MaSmallStat}" Command="{Binding RefreshCommand}" Height="74" Visibility="{Binding IsApiKeyTab, Converter={StaticResource Visible}}"
                            ToolTip="What the API key's CLIs have spent since its starting credit was set, today, and the rate over the last 24 hours."
                            AutomationProperties.Name="{Binding ApiSpentHeadline, StringFormat='API spend: {0}'}">
                        <StackPanel>
                            <TextBlock Text="Spent" Style="{StaticResource MaSectionLabel}" Margin="{StaticResource SpaceBXS}" />
                            <TextBlock Text="{Binding ApiSpentHeadline}" Style="{StaticResource MaStatValue}" />
                            <TextBlock Text="{Binding ApiSpentCaption}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ApiRunsOutTile" Style="{StaticResource MaSmallStat}" Command="{Binding RefreshCommand}" Height="74" Visibility="{Binding IsApiKeyTab, Converter={StaticResource Visible}}"
                            ToolTip="When the starting credit runs out at the last 24 hours' rate."
                            AutomationProperties.Name="{Binding ApiRunsOutHeadline, StringFormat='API credit runs out: {0}'}">
                        <StackPanel>
                            <TextBlock Text="Runs Out" Style="{StaticResource MaSectionLabel}" Margin="{StaticResource SpaceBXS}" />
                            <TextBlock Text="{Binding ApiRunsOutHeadline}" Style="{StaticResource MaStatValue}" />
                            <TextBlock Text="{Binding ApiRunsOutCaption}" Style="{StaticResource MaTileSubtitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </mc:MaTileGrid>
                <!-- No login-action buttons on a person's page any more: User Settings (M.ORCH-T1098) is the person's tab's
                     right-click menu (M.ORCH-T797, MainWindow.xaml.cs's OnLoginTabContextMenu); the login-wide Move CLIs is gone, each
                     CLI moving by its own agent card's Move to; and there's no Sign in (M.ORCH-T796): a login that gets disconnected
                     opens its own sign-in by itself. What the last of those did still shows here. -->
                <TextBlock x:Name="PersonMessage" Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTM}"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                </StackPanel>

                <!-- Toolbar: what the person's last action did on the left, the zoom on the right (M.ORCH-T667, M.ORCH-T493). The
                     clock, refresh info, Refresh and Open Launcher are gone (M.ORCH-T855), and so are the Current work heading and
                     its agent card board (M.ORCH-T837): each CLI is its own terminal tab, fixed above. There are no view pills any
                     more (M.ORCH-T763): the Orchestrator shows only what's running, and Tickets Desktop the Repos, the Queue and
                     the audit. -->
                <Grid x:Name="Toolbar" Margin="{StaticResource SpaceH0VS}" Visibility="{Binding IsTabSignedIn, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MaFocus}"
                               Visibility="{Binding StatusMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="{StaticResource SpaceTS}">
                        <TextBlock Text="{Binding Zoom.Text}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="{StaticResource SpaceLM}"
                                   ToolTip="Ctrl+0 resets the zoom" />
                    </StackPanel>
                </Grid>

                <!-- This 5-hour window's utilization (M.ORCH-T191), moved below Terminals (M.ORCH-T826):
                     its own full-width row, tall enough that the pace line straight to the target at the reset, the window's
                     own line (red while over that pace, green under) and where the recent rate ends up are easy to read. The
                     caption says it in words. -->
                <StackPanel x:Name="UtilizationSection" Margin="{StaticResource SectionGap}">
                <StackPanel x:Name="ClaudeMetersSection" Visibility="{Binding ShowsClaudeMeters, Converter={StaticResource Visible}}">
                    <Border x:Name="UtilizationCard" Style="{StaticResource MaCard}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding UtilizationText, StringFormat='5-hour utilization: {0}'}"
                            Visibility="{Binding UtilizationText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="5-hour utilization" Style="{StaticResource MaSectionLabel}" />
                            <mc:MaLineChart x:Name="UtilizationChart" Data="{Binding Utilization, Converter={x:Static local:UtilizationChartData.Converter}}"
                                            Height="130" Margin="{StaticResource SpaceH0VS}" />
                            <TextBlock Text="{Binding UtilizationText}" Style="{StaticResource MaTileSubtitle}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- The API key's person (M.ORCH-T906): its money burning down, in place of the 5-hour chart. From its starting credit
                     (100%) down to what's left now, then, dotted, where the last 24 hours' rate takes it: to $0 where it runs out,
                     else what's left at the chart's end. The caption says it in words. -->
                <StackPanel x:Name="ApiBurnSection" Visibility="{Binding IsApiKeyTab, Converter={StaticResource Visible}}">
                    <Border x:Name="ApiBurnCard" Style="{StaticResource MaCard}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding ApiBurnText, StringFormat='API credit burndown: {0}'}"
                            Visibility="{Binding ApiBurnText, Converter={x:Static vm:Converters.EmptyToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="API credit burndown" Style="{StaticResource MaSectionLabel}" />
                            <mc:MaLineChart x:Name="ApiBurnChart" Data="{Binding Spend, Converter={x:Static local:ApiBurnChartData.Converter}}"
                                            Height="130" Margin="{StaticResource SpaceH0VS}" />
                            <TextBlock Text="{Binding ApiBurnText}" Style="{StaticResource MaTileSubtitle}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>

                <!-- Tickets per user (M.ORCH-T668), below the person's open CLIs: the tickets assigned to them, each with who
                     it's assigned to. A person's page shows only their own queue; the unassigned queue shows on the global
                     login's tab only (M.ORCH-T842), the dashboard's one place to see an unassigned ticket. An assigned ticket is dispatched only on its user's login. Each part sits
                     straight in the view, the lists too, so the view's one virtualized list builds only the tickets on screen
                     (M.ORCH-T754). -->
                <StackPanel x:Name="UserTickets" Margin="{StaticResource SectionGap}" Visibility="{Binding ShowsUserTickets, Converter={StaticResource Visible}}">
                    <TextBlock Text="Tickets" Style="{StaticResource MaHeading}" />
                    <TextBlock Text="A ticket assigned to a person is dispatched only on their login (next --claim, allocate and Start); while they're out of room it waits for them. Assign, reassign or redelegate it in Tickets Desktop: every ticket here opens there."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                    <TextBlock Text="{Binding AssignedHeader}" Style="{StaticResource MaSectionLabel}" />
                </StackPanel>
                <!-- The person's Queue by status (M.ORCH-T849): Active (open and claimed or being worked), Pending (open and
                     waiting: unapproved, on a prerequisite, or queued), Closed and Won't do (the last 7 days), each with its
                     count; Active first. A bare strip: the one list below shows the selected tab's tickets, so the body's
                     virtualized list still builds only the rows on screen (M.ORCH-T754). -->
                <mc:MaTabControl x:Name="QueueStatusTabs" ShowContent="False" ItemsSource="{Binding QueueTabs}" SelectedItem="{Binding SelectedQueueTab}"
                                 DisplayMemberPath="Name" Margin="{StaticResource SpaceBS}" AutomationProperties.Name="Queue by status"
                                 Visibility="{Binding ShowsUserTickets, Converter={StaticResource Visible}}">
                    <mc:MaTabControl.ItemContainerStyle>
                        <Style TargetType="mc:MaTabItem" BasedOn="{StaticResource {x:Type mc:MaTabItem}}">
                            <Setter Property="Trailing" Value="{Binding CountText}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </mc:MaTabControl.ItemContainerStyle>
                </mc:MaTabControl>
                <TextBlock x:Name="NoQueueTickets" Text="{Binding NoQueueTicketsText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap"
                           Visibility="{Binding HasNoQueueTickets, Converter={StaticResource Visible}}" />
                <ItemsControl x:Name="AssignedTicketList" Style="{StaticResource MaRowList}" ItemsSource="{Binding QueueTickets}"
                              ItemTemplate="{StaticResource UserTicketTemplate}" AutomationProperties.Name="{Binding SelectedQueueTab.AccessibleName}"
                              Visibility="{Binding ShowsUserTickets, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding UnassignedHeader}" Style="{StaticResource MaSectionLabel}"
                           Visibility="{Binding ShowsUnassignedTickets, Converter={StaticResource Visible}}" />
                <ItemsControl x:Name="UnassignedTicketList" Style="{StaticResource MaRowList}" ItemsSource="{Binding UnassignedTickets}"
                              ItemTemplate="{StaticResource UserTicketTemplate}" AutomationProperties.Name="{Binding UnassignedHeader}"
                              Visibility="{Binding ShowsUnassignedTickets, Converter={StaticResource Visible}}" />

                <!-- What fits on no person's page (M.ORCH-T763), on the global login's tab instead of its own 'Miscellaneous'
                     tab (M.ORCH-T825): allocate and the pace's slots, a pacing hold, the reminders the daemon texts through
                     Psst (orchestrator remind, M.ORCH-T477), the last queue line, finished work (closed tickets whose
                     assignment or worktree is still around) and the workspace's problems. Each part sits straight in the
                     view, the lists too, so the one virtualized list (MainWindow.xaml.cs) builds only what's on screen. -->
                <StackPanel x:Name="WorkspaceExtras" Margin="{StaticResource SectionGap}" Visibility="{Binding ShowsWorkspaceExtras, Converter={StaticResource Visible}}">
                    <TextBlock Text="Workspace" Style="{StaticResource MaHeading}" />
                    <DockPanel Margin="{StaticResource SpaceTS}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SlotsText}" Style="{StaticResource MaMutedText}" VerticalAlignment="Center" Margin="{StaticResource SpaceLM}" />
                        <TextBlock Text="{Binding AllocateText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" />
                    </DockPanel>
                    <!-- Its ticket ids link into Tickets Desktop (M.ORCH-T762), as everywhere else. -->
                    <TextBlock local:TicketText.Text="{Binding QueueMessage}" Foreground="{DynamicResource MaFocus}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}"
                               Visibility="{Binding QueueMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                    <TextBlock Text="{Binding RemindersTitle}" Style="{StaticResource MaSectionLabel}"
                               Visibility="{Binding ShowsReminders, Converter={StaticResource Visible}}" />
                </StackPanel>
                <Border x:Name="HoldCard" Style="{StaticResource MaCard}" Margin="{StaticResource SpaceTM}" BorderBrush="{DynamicResource MaWarn}"
                        Visibility="{Binding ShowsHold, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Hold}" Foreground="{DynamicResource MaWarn}" TextWrapping="Wrap" />
                </Border>
                <ItemsControl x:Name="ReminderList" ItemsSource="{Binding Reminders}" Style="{StaticResource MaList}" AutomationProperties.Name="Reminders"
                              Visibility="{Binding ShowsReminders, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="orchestrator remind --cancel &lt;id&gt; drops one." Style="{StaticResource MaMutedText}" FontSize="11" Margin="{StaticResource RowGutter}"
                           Visibility="{Binding ShowsReminders, Converter={StaticResource Visible}}" />
                <TextBlock Text="FINISHED WORK" Style="{StaticResource MaSectionLabel}"
                           Visibility="{Binding ShowsWorkspaceExtras, Converter={StaticResource Visible}}" />
                <TextBlock Text="Closed tickets whose assignment (or old worktree) is still around." Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}"
                           Visibility="{Binding ShowsWorkspaceExtras, Converter={StaticResource Visible}}" />
                <ItemsControl x:Name="FinishedList" ItemsSource="{Binding Finished}" Style="{StaticResource MaRowList}" AutomationProperties.Name="Finished work"
                              Visibility="{Binding ShowsWorkspaceExtras, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FinishedViewModel}">
                            <Border Style="{StaticResource MaListCard}" BorderBrush="{DynamicResource MaGood}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Padding="{StaticResource SpaceHMVXS}"
                                            Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                            ToolTip="git keeps the worktree if it has uncommitted changes; the branch is never deleted" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaButton}" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceRS}"
                                            Content="Details" Command="{Binding DetailsCommand}"
                                            ToolTip="The sessions that worked on it (its commits and history: open it in Tickets Desktop)" />
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="{StaticResource SpaceRM}">
                                        <Hyperlink Style="{StaticResource TicketLink}" CommandParameter="{Binding TicketId}"
                                                   AutomationProperties.Name="{Binding TicketId, StringFormat='{}{0}: open it in Tickets Desktop'}"><Run Text="{Binding TicketId, Mode=OneWay}" /></Hyperlink><Run Text="{Binding TextAfterId, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding WarningsText}" Style="{StaticResource MaSectionLabel}"
                           Visibility="{Binding ShowsWarningsSection, Converter={StaticResource Visible}}" />
                <ItemsControl x:Name="WarningList" ItemsSource="{Binding Warnings}" Style="{StaticResource MaList}" AutomationProperties.Name="Problems reading the workspace"
                              Visibility="{Binding ShowsWarningsSection, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource MaBad}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- An org with no Claude login yet (M.ORCH-T655): said over the body rather than showing another org's person. On the
             global login's tab (MainWindow.xaml.cs), which knows the orgs. -->
        <Border x:Name="OrgEmptyPanel" Grid.Row="1" Grid.RowSpan="4" Style="{StaticResource MaCover}"
                Visibility="{Binding IsOrgEmpty, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding OrgEmptyText}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="{StaticResource SpaceXL}" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBar" Grid.Row="5" Style="{StaticResource MaStatusBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MaMutedText}"
                           Text="F5 refresh · Ctrl+Tab next login · Ctrl +/− zoom · Esc close" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource MaMutedText}" Margin="{StaticResource SpaceRL}">
                    <Run Text="{Binding RepoCount, Mode=OneWay}" /><Run Text=" repos under " /><Run Text="{Binding WorkspaceRoot, Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="Announcer" DockPanel.Dock="Left" Width="0" Height="0" Opacity="0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Foreground="{DynamicResource MaBad}" Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}">
                    <TextBlock.ToolTip>
                        <ItemsControl ItemsSource="{Binding Warnings}" Style="{StaticResource MaList}" />
                    </TextBlock.ToolTip>
                    <Run Text="{Binding WarningsText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Covers every row until the first refresh lands (M.ORCH-T184). -->
        <Border x:Name="Loader" Grid.RowSpan="6" Style="{StaticResource MaCover}"
                Visibility="{Binding IsLoading, Converter={StaticResource Visible}}"
                AutomationProperties.Name="Loading the dashboard" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The library's MaSpinner turns on its own thread, so it keeps turning while this window's thread applies the
                     first snapshot and lays the dashboard out (M.ORCH-T200); MaAccent from its implicit style. -->
                <mc:MaSpinner x:Name="LoaderSpinner" Width="44" Height="44" StrokeThickness="4" HorizontalAlignment="Center"
                              AutomationProperties.Name="Loading the dashboard" />
                <TextBlock Margin="{StaticResource SpaceTL}" FontSize="15" HorizontalAlignment="Center" Text="Loading the workspace…" />
                <TextBlock Style="{StaticResource MaMutedText}" Margin="{StaticResource RowGutter}" HorizontalAlignment="Center"
                           Text="Reading every repo's sessions, tickets and usage" />
            </StackPanel>
        </Border>

        <!-- Settings (M.ORCH-T498): the shared MaModal, centred over a dimmed window, instead of the old right-side flyout.
             Esc, its close button and the backdrop all close it through ToggleSettingsCommand (which reloads the saved
             settings, dropping unsaved edits, as the flyout's close did); focus is held inside while open and goes back to
             the top-right cog after (M.ORCH-T804: the only way in). Last in the root grid, spanning every row, over the loader too.
             Tabbed, not one long list (M.ORCH-T804): Budget, Pacing, Scheduler, Logins and Person tabs, each scrolling on its
             own, in a dialog sized to 80% of the window both ways (MainWindow.xaml.cs's SizeSettings sets DialogWidth and
             SettingsBody's Height as the window resizes). The error line stays under the tabs, whichever is showing. -->
        <mc:MaModal x:Name="SettingsModal" Grid.RowSpan="6" Title="Settings" AutomationProperties.Name="Settings"
                    IsOpen="{Binding IsSettingsOpen}" CloseCommand="{Binding ToggleSettingsCommand}">
            <Grid x:Name="SettingsBody" DataContext="{Binding Settings}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <mc:MaTabControl x:Name="SettingsTabs" AutomationProperties.Name="Settings sections">
                    <mc:MaTabItem x:Name="SettingsBudgetTab" Header="Budget">
                        <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,4,16,12">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="TOKEN BUDGET" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Uncached tokens (input + cache writes + output). Accepts 20M, 500k, 1.5B. Leave blank to use Claude's own reported limit, or else the limits learned from the times you actually hit the wall."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}" />
                                <TextBlock Text="Per 5-hour block" Margin="{StaticResource SpaceH0VXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="240" HorizontalAlignment="Left"
                                         Text="{Binding BlockBudget, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Budget per 5-hour block" />
                                <TextBlock Text="Per week" Margin="{StaticResource SpaceTSBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="240" HorizontalAlignment="Left"
                                         Text="{Binding WeeklyBudget, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Weekly budget" />
                                <TextBlock Text="Week resets (local time)" Margin="{StaticResource SpaceTSBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="160" HorizontalAlignment="Left"
                                         Text="{Binding WeeklyReset, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly reset day and time" />
                                <TextBlock Text="When Claude's weekly limit restarts, e.g. Mon 9:00 AM or Tue 5pm. Claude's own reported reset comes first; blank uses the reset your last weekly limit hit reported, or a rolling 7 days before you've had one."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                <TextBlock Text="Warn at (%)" Margin="{StaticResource SpaceTSBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding WarnPercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Warn percent" />
                                <!-- Weekly pacing (M.ORCH-T680): the toggle and its numbers together, each saved in the database. -->
                                <TextBlock Text="WEEKLY LIMIT" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Weekly target (% of each account's week)" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding WeeklyTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly target percent" />
                                <TextBlock Text="50 to 100 (95 by default). Every CLI on an account stops here. The rest is the weekly reserve, kept for your own questions in the Claude app and claude.ai: 95 keeps 5% of each week back."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                            </StackPanel>
                        </ScrollViewer>
                    </mc:MaTabItem>

                    <mc:MaTabItem x:Name="SettingsPacingTab" Header="Pacing">
                        <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,4,16,12">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="5-HOUR PACING" Style="{StaticResource MaSectionLabel}" />
                                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding Pacing}" HorizontalAlignment="Left"
                                              Content="Pace to the reset" />
                                <TextBlock Text="Caps new sessions so spend lands on the target as the 5-hour window resets, instead of hitting the wall and waiting. The week is shown, not paced. Off: new work holds at the warn line."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" />
                                <TextBlock Text="Pace target (% of the 5-hour limit by its reset)" Margin="{StaticResource SpaceTSBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding PaceTarget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pace target percent" />
                                <TextBlock Text="Exempt from pacing" Margin="{StaticResource SpaceTSBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Text="{Binding ExemptCommands, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Commands exempt from pacing" />
                                <TextBlock Text="Slash commands, comma-separated. A turn typed as one of them (and a Skill call naming one) skips every pace gate: no hold, no subagent wait, no stop. Its spend still counts. Blank exempts none."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                <!-- Last-resort cool-off (M.ORCH-T786, exposed as a setting by M.ORCH-T795): aborts a login's own ticket
                                     subagents once its trend stays past the pace line with new starts already slowed. -->
                                <TextBlock Text="COOL-OFF" Style="{StaticResource MaSectionLabel}" />
                                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding AgentAbort}" HorizontalAlignment="Left"
                                              Content="Cool off by aborting subagents" />
                                <TextBlock Text="Last resort (on by default): when a login's live 5-hour trend stays past its pace line with new subagents already slowed for the minutes below, the orchestrator aborts just enough of that login's ticket subagents to bend it back under, releasing their claims and putting their tickets first in the queue. Off leaves the cool-off to slow new starts only."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceH0VS}" />
                                <TextBlock Text="Abort after (minutes past the line)" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding AgentAbortAfter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cool-off abort after minutes" />
                                <TextBlock Text="0 to 60 (3 by default). How long the new-start cool-off gets to bend the trend back under before the abort above steps in. Also orchestrator settings --agent-abort / --agent-abort-after."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                <!-- Cutoff alerts (M.ORCH-T742): who gets texted when a login reaches its own cutoff. -->
                                <TextBlock Text="CUTOFF ALERTS" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Text through Psst when a login reaches its own cutoff" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="200" HorizontalAlignment="Left"
                                         Text="{Binding AlertTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cutoff alert text recipient" />
                                <TextBlock Text="A Psst contact (ryan) or a US number; blank texts nobody."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                            </StackPanel>
                        </ScrollViewer>
                    </mc:MaTabItem>

                    <mc:MaTabItem x:Name="SettingsSchedulerTab" Header="Scheduler">
                        <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,4,16,12">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="LOGIN PLACEMENT" Style="{StaticResource MaSectionLabel}" />
                                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding AutoLogin}" HorizontalAlignment="Left"
                                              Content="One CLI per account (Auto login)" />
                                <TextBlock Text="A new Claude tab (Start on Auto in the global login's tab, orchestrator start without --account, allocate's starts, the Launcher's accounts pick) goes on a signed-in per-CLI login no CLI runs on yet, most headroom first, else the global login. Off: the global login unless one is chosen."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceH0VS}" />
                                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding RebalanceLogins}" HorizontalAlignment="Left"
                                              Content="Rebalance when an account runs low" />
                                <TextBlock Text="A CLI whose login crosses its 5-hour pace target or its weekly stop line is moved by the daemon to a signed-in per-CLI login with no CLI and more headroom: it restarts with claude --resume at its next idle point, keeping its session, and you're toasted. Off: every CLI stays on its login."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" />
                                <TextBlock Text="ORPHANED TICKETS" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Redispatches" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding OrphanRedispatches, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Orphan redispatches" />
                                <TextBlock Text="0 to 20 (3 by default). How many times a ticket whose CLI or tab exited mid-task is started again in its repo's checkout before it's left for you. 0 only shows it as orphaned."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTXSBS}" />
                                <TextBlock Text="Quiet minutes" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding OrphanQuiet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Orphan quiet minutes" />
                                <TextBlock Text="1 to 1440 (10 by default). How long a dispatch's CLI or tab must be gone, with nothing working its ticket, before the ticket counts as orphaned."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                                <TextBlock Text="DISPATCH" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Max concurrent sessions (working + waiting)" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding MaxSessions, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Max concurrent sessions" />
                                <TextBlock Text="Provider for dispatched tickets" Margin="{StaticResource SpaceTSBXS}" />
                                <ListBox Style="{StaticResource MaPillChoice}" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                                         AutomationProperties.Name="Dispatch provider" />
                                <ToggleButton Style="{StaticResource MaPillToggle}" IsChecked="{Binding Allocate}" Margin="{StaticResource SpaceTS}" HorizontalAlignment="Left"
                                              Content="Allocate" />
                                <TextBlock Text="Type /allocate in a CLI and that CLI works its repo's tickets (or -repo=a,b, or all) through its own subagents, all in the repo's own checkout on main (each touching only its ticket's files), as many at once as the pace allows; no other CLI is affected. Off here pauses it in every CLI; /allocate off ends it in that one."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" />
                            </StackPanel>
                        </ScrollViewer>
                    </mc:MaTabItem>

                    <!-- The org-wide login actions (M.ORCH-T763, moved here from above the person tabs by M.ORCH-T804): Add login (a
                         per-CLI login of its own for an email), Sign in all (every roster account with no login of its own yet,
                         M.ORCH-T604) and Report (the usage report, M.ORCH-T685); what they did on the lines under them. The global
                         login's tab's (MainWindow.xaml.cs sets OrgToolbar's DataContext), not the Settings above. -->
                    <mc:MaTabItem x:Name="SettingsLoginsTab" Header="Logins">
                        <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,4,16,12">
                            <StackPanel x:Name="OrgToolbar" MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="ORGANIZATION LOGINS" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Sign in a per-CLI login for an email, sign in every roster account that has none yet, or write the usage report."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceBS}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="NewAccountBox" Style="{StaticResource MaTextBox}" Width="260" Height="32" VerticalAlignment="Center"
                                             Text="{Binding NewAccountEmail, UpdateSourceTrigger=PropertyChanged}"
                                             mc:MaTextBox.Placeholder="name@company.com"
                                             AutomationProperties.Name="Email of the login to add" />
                                    <Button x:Name="AddLoginButton" Style="{StaticResource MaButton}" Content="Add login" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceLS}"
                                            Command="{Binding AddAccountCommand}" VerticalAlignment="Center"
                                            ToolTip="Sign in a per-CLI login of its own for this email (orchestrator login --account), opening its login in the browser. The global login is left as it is." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource SpaceTS}">
                                    <Button x:Name="SignInAllButton" Style="{StaticResource MaButton}" Content="Sign in all" Padding="{StaticResource SpaceHMVXS}"
                                            Command="{Binding SignInAllCommand}" VerticalAlignment="Center"
                                            ToolTip="Give every account in the roster with no per-CLI login yet its own (~/.claude-accounts), opening each one's login in the browser in turn, so every Claude Team seat stays signed in side by side. The global login stays the default." />
                                    <Button x:Name="UsageReportButton" Style="{StaticResource MaButton}" Content="Report" Padding="{StaticResource SpaceHMVXS}" Margin="{StaticResource SpaceLS}"
                                            Command="{Binding UsageReportCommand}" VerticalAlignment="Center"
                                            ToolTip="Write the usage report (every member's 5-hour and weekly use, resets, points left to the weekly target, how fresh each reading is, the CLIs' spend and the API key's) as an HTML page and a Markdown file to share, and open the page (orchestrator report)." />
                                </StackPanel>
                                <TextBlock x:Name="OrgActionsMessage" Text="{Binding AccountsMessage}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTM}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding AccountsMessage, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                                <!-- The billing detail line (M.ORCH-T628): what the last Sign in all or default switch did, a problem, and the open
                                     CLIs still billing the other thing. -->
                                <TextBlock x:Name="BillingDetailLine" Text="{Binding BillingDetail}" Style="{StaticResource MaTileSubtitle}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding BillingDetail, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </mc:MaTabItem>

                    <mc:MaTabItem x:Name="SettingsPersonTabsTab" Header="Person tabs">
                        <ScrollViewer Style="{StaticResource MaPaneScroll}" mc:MaScrollArea.Gutter="0,4,16,12">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="PERSON TABS" Style="{StaticResource MaSectionLabel}" />
                                <TextBlock Text="Blink once per (tokens)" Margin="{StaticResource SpaceBXS}" />
                                <TextBox Style="{StaticResource MaTextBox}" Height="32" Width="120" HorizontalAlignment="Left"
                                         Text="{Binding TabBlinkTokens, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Blink once per this many tokens" />
                                <TextBlock Text="1 to 10,000,000 (1000 by default). A busy login's green play arrow blinks once for every this many tokens it spends (uncached), so busy tabs blink at their own rate and the busiest blink fastest. Also orchestrator settings --tab-blink-tokens."
                                           Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                            </StackPanel>
                        </ScrollViewer>
                    </mc:MaTabItem>
                </mc:MaTabControl>

                <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="{DynamicResource MaBad}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding Error, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </Grid>
            <mc:MaModal.Footer>
                <DockPanel DataContext="{Binding Settings}" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource MaPrimaryButton}" Content="Save" Padding="{StaticResource SpaceHLVS}"
                            Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource MaMutedText}" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="{StaticResource SpaceRM}" />
                </DockPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>

        <!-- User Settings (M.ORCH-T1098, was Org limit and Rename), a person's login action (M.ORCH-T763) from their tab's
             right-click menu: the account's email (its ID, never edited); its Name (its tab's title; the member's name too) and
             Prefix (the badge its terminal titles start with, M.ORCH-T633); and its own 5-hour and weekly cutoffs (M.ORCH-T707), as
             orchestrator org limit sets them. Defaults fills in the default cutoffs; one Save keeps everything. -->
        <mc:MaModal x:Name="UserSettingsModal" Grid.RowSpan="6" Title="User Settings" AutomationProperties.Name="User Settings" DialogWidth="460"
                    IsOpen="{Binding IsUserSettingsOpen}" CloseCommand="{Binding CancelUserSettingsCommand}">
            <StackPanel>
                <TextBlock Text="Email" Margin="{StaticResource SpaceBXS}" />
                <TextBox x:Name="UserSettingsEmailBox" Style="{StaticResource MaTextBox}" Height="32" IsReadOnly="True" Text="{Binding RenameEmail, Mode=OneWay}"
                         AutomationProperties.Name="Email" ToolTip="The account's ID: it can't be changed" />
                <StackPanel x:Name="RenameSection" Visibility="{Binding HasRenameSection, Converter={StaticResource Visible}}">
                    <TextBlock Text="Name" Margin="{StaticResource SpaceTSBXS}" />
                    <TextBox x:Name="RenameNameBox" Style="{StaticResource MaTextBox}" Height="32" Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Name" />
                    <TextBlock Text="What the Orchestrator calls this login, on its tab. Blank goes back to the email's part before the @."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                    <TextBlock Text="Prefix" Margin="{StaticResource SpaceTSBXS}" />
                    <TextBox x:Name="RenamePrefixBox" Style="{StaticResource MaTextBox}" Height="32" Width="100" HorizontalAlignment="Left"
                             Text="{Binding RenamePrefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prefix" />
                    <TextBlock Text="The badge its terminal titles start with, e.g. JR in [JR] Repo [Claude]: up to 3 letters or digits. Blank takes it from the name."
                               Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource RowGutter}" />
                </StackPanel>
                <StackPanel x:Name="LimitSection" Visibility="{Binding HasLimitSection, Converter={StaticResource Visible}}">
                <TextBlock Text="5-hour cutoff (% of the 5-hour window)" Margin="{StaticResource SpaceTSBXS}" />
                <TextBox x:Name="LimitFiveHourBox" Style="{StaticResource MaTextBox}" Height="32" Width="100" HorizontalAlignment="Left"
                         Text="{Binding LimitFiveHour, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="5-hour cutoff percent" />
                <TextBlock Text="Weekly cutoff (% of the week)" Margin="{StaticResource SpaceTSBXS}" />
                <TextBox x:Name="LimitWeeklyBox" Style="{StaticResource MaTextBox}" Height="32" Width="100" HorizontalAlignment="Left"
                         Text="{Binding LimitWeekly, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weekly cutoff percent" />
                <TextBlock Text="{Binding LimitHint}" Style="{StaticResource MaMutedText}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" />
                </StackPanel>
                <TextBlock Text="{Binding LimitError}" Foreground="{DynamicResource MaBad}" TextWrapping="Wrap" Margin="{StaticResource SpaceTS}" AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding LimitError, Converter={x:Static vm:Converters.EmptyToCollapsed}}" />
            </StackPanel>
            <mc:MaModal.Footer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaButton}" Content="Defaults" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Command="{Binding ResetLimitCommand}"
                            Visibility="{Binding HasLimitSection, Converter={StaticResource Visible}}"
                            ToolTip="Fill in the default cutoffs, 98% of the 5-hour window and 90% of the week; Save keeps them" />
                    <Button Style="{StaticResource MaButton}" Content="Cancel" Padding="{StaticResource SpaceHLVS}" Margin="{StaticResource SpaceRS}" Command="{Binding CancelUserSettingsCommand}" />
                    <Button Style="{StaticResource MaPrimaryButton}" Content="Save" Padding="{StaticResource SpaceHLVS}" Command="{Binding SaveUserSettingsCommand}" />
                </StackPanel>
            </mc:MaModal.Footer>
        </mc:MaModal>
    </Grid>
</Window>
