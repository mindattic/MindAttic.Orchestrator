<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MindAttic.Orchestrator.Wpf</RootNamespace>
    <AssemblyName>MindAttic.Orchestrator.Desktop</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only. M.ORCH-T1888: the major goes up by one with every commit that touches
         src\ (data-sync and docs commits don't), counted from OrchestratorVersionBase (v1) by OrchestratorVersionFromGit
         below; this is only the fallback when git can't be asked. The window title shows it: "MindAttic Orchestrator vN". -->
    <Version>1.0.0</Version>
    <OrchestratorVersionBase>e6f98479</OrchestratorVersionBase>
    <!-- The exe's own icon: Explorer, the shortcuts and a Start or taskbar pin all show it. -->
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <!-- LibraryImport's generated marshalling (TerminalFocus's user32 calls) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- M.ORCH-T1597: the dashboard and its daemon both run this exe; transcript reads leave the large-object heap
         fragmented (57 MB seen live, 357 MB committed for a 186 MB live heap). ConserveMemory has the GC compact it
         back. DOTNET_GCConserveMemory overrides it per process. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same icon for the window's title bar and taskbar button. -->
    <Resource Include="..\..\assets\logo.ico" Link="logo.ico" />
    <!-- Outfit, Regular and Bold (M.ORCH-T1274): the Font setting's alternative to Segoe UI, loaded by FontChoice. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- M.ORCH-T2028, from the Launcher (M.LNCH-T111): Ciantic/VirtualDesktopAccessor (MIT,
         https://github.com/Ciantic/VirtualDesktopAccessor), a vendored prebuilt x64 DLL behind Services\VirtualDesktops.
         It lives under Native\, but DllImport("VirtualDesktopAccessor.dll") needs it flat next to the exe (the Windows
         loader's search path), hence the Link. -->
    <Content Include="Native\VirtualDesktopAccessor.dll" Link="VirtualDesktopAccessor.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\VirtualDesktopAccessor.LICENSE.txt" Link="VirtualDesktopAccessor.LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Each person's Terminals panel (M.ORCH-T810): the Windows Terminal renderer over ConPTY, a true TTY. -->
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <PackageReference Include="MindAttic.Components.Wpf" Version="48.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray.cs's NotifyIcon (M.ORCH-T1889): the assemblies only, not UseWindowsForms - that also adds WinForms'
         own implicit global usings (Brush, TextBox, Button, Panel, Point, Size...), colliding project-wide with
         WPF's identically-named ones. Tray.cs always qualifies with its Forms./Drawing. aliases instead. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Orchestrator.Core\MindAttic.Orchestrator.Core.csproj" />
    <!-- RelayTerminal and RelayConnection, shared with the standalone TermViewer (M.ORCH-T960). -->
    <ProjectReference Include="..\MindAttic.Orchestrator.Term.Wpf\MindAttic.Orchestrator.Term.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MindAttic.Orchestrator.Term.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Orchestrator.Tests" />
  </ItemGroup>

  <!-- M.ORCH-T1888: N.0.0, N = 1 + the commits since OrchestratorVersionBase that touch src\. release.ps1, building from a
       git archive, passes OrchestratorVersion itself (counted on the commit it ships); version.ps1 prints the same number. -->
  <Target Name="OrchestratorVersionFromGit" BeforeTargets="GetAssemblyVersion" Condition="'$(OrchestratorVersion)' == ''">
    <Exec Command="git rev-list --count $(OrchestratorVersionBase)..HEAD -- ." WorkingDirectory="$(MSBuildThisFileDirectory).."
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OrchestratorCommits" />
      <Output TaskParameter="ExitCode" PropertyName="_OrchestratorGitExit" />
    </Exec>
    <PropertyGroup Condition="'$(_OrchestratorGitExit)' == '0' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_OrchestratorCommits)', '^\d+$'))">
      <OrchestratorVersion>$([MSBuild]::Add($(_OrchestratorCommits), 1)).0.0</OrchestratorVersion>
    </PropertyGroup>
  </Target>
  <Target Name="ApplyOrchestratorVersion" AfterTargets="OrchestratorVersionFromGit" BeforeTargets="GetAssemblyVersion" Condition="'$(OrchestratorVersion)' != ''">
    <PropertyGroup>
      <Version>$(OrchestratorVersion)</Version>
      <VersionPrefix>$(OrchestratorVersion)</VersionPrefix>
      <AssemblyVersion>$(OrchestratorVersion).0</AssemblyVersion>
      <FileVersion>$(OrchestratorVersion).0</FileVersion>
      <InformationalVersion>$(OrchestratorVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
