<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MindAttic.Orchestrator.Wpf</RootNamespace>
    <AssemblyName>MindAttic.Orchestrator.Desktop</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <!-- The exe's own icon: Explorer, the shortcuts and a Start or taskbar pin all show it. -->
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <!-- LibraryImport's generated marshalling (TerminalFocus's user32 calls) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- M.ORCH-T1597: the dashboard and its daemon both run this exe; transcript reads leave the large-object heap
         fragmented (57 MB seen live, 357 MB committed for a 186 MB live heap). ConserveMemory has the GC compact it
         back. DOTNET_GCConserveMemory overrides it per process. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same icon for the window's title bar and taskbar button. -->
    <Resource Include="..\..\assets\logo.ico" Link="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each person's Terminals panel (M.ORCH-T810): the Windows Terminal renderer over ConPTY, a true TTY. -->
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <PackageReference Include="MindAttic.Components.Wpf" Version="43.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Orchestrator.Core\MindAttic.Orchestrator.Core.csproj" />
    <!-- RelayTerminal and RelayConnection, shared with the standalone TermViewer (M.ORCH-T960). -->
    <ProjectReference Include="..\MindAttic.Orchestrator.Term.Wpf\MindAttic.Orchestrator.Term.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="MindAttic.Orchestrator.Term.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Orchestrator.Tests" />
  </ItemGroup>

</Project>
