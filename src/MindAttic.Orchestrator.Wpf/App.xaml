<Application x:Class="MindAttic.Orchestrator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Every control, text style, card, list, tile, tab strip, scroll area, focus ring, chart, scroll bar and colour comes
                 from MindAttic.Components.Wpf (M.ORCH-T499, M.ORCH-T531, M.ORCH-T181, M.ORCH-T667), whose palette meets WCAG 2.2 AA
                 by itself (the text fields' 3:1 MaFieldBorder outline, MaRec at 4.5:1) and follows Windows high contrast. The
                 dashboard has no style of its own: LibraryOnlyXamlTests fails any element that isn't the library's. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MindAttic.Components.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
