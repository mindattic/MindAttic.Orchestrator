<Application x:Class="MindAttic.Orchestrator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Every control, text style, card, pill, focus ring, chart and scroll bar comes from MindAttic.Components.Wpf
                 (M.ORCH-T499, M.ORCH-T531). Only the repo tile and the text fields' outline below are the dashboard's own. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MindAttic.Components.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- WCAG 2.2 AA: a text field's outline at the theme's #34363E is 1.2:1; it needs 3:1 to show where to type (1.4.11). -->
            <SolidColorBrush x:Key="FieldBorder" Color="#FF8A8C96" />
            <Style x:Key="McTextBox" TargetType="TextBox" BasedOn="{StaticResource McTextBox}">
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            </Style>
            <Style x:Key="McTextArea" TargetType="TextBox" BasedOn="{StaticResource McTextArea}">
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            </Style>

            <!-- A repo tile: McTileButton with room for a state bar, two lines and a token count. -->
            <Style x:Key="RepoTile" TargetType="Button" BasedOn="{StaticResource McTileButton}">
                <!-- No width or margin: the repo grid (an AlignedGrid) sizes every tile and the gaps between them. -->
                <Setter Property="Height" Value="78" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource McFocusRing}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource McFocus}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
