<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- One spacing scale for every view, card and row (M.ORCH-T853): 4 / 8 / 12 / 16 / 24. Every Margin and Padding in the
         dashboard is one of these, never a literal (the close button of the compact CLI tabs keeps its deliberate negative margin). -->
    <sys:Double x:Key="SpaceXSPx">4</sys:Double>
    <sys:Double x:Key="SpaceSPx">8</sys:Double>
    <sys:Double x:Key="SpaceMPx">12</sys:Double>
    <sys:Double x:Key="SpaceLPx">16</sys:Double>
    <sys:Double x:Key="SpaceXLPx">24</sys:Double>
    <Thickness x:Key="CardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="RowGutter">0,4,0,0</Thickness>
    <Thickness x:Key="SectionGap">0,24,0,0</Thickness>
    <Thickness x:Key="SpaceBL">0,0,0,16</Thickness>
    <Thickness x:Key="SpaceBS">0,0,0,8</Thickness>
    <Thickness x:Key="SpaceBXS">0,0,0,4</Thickness>
    <Thickness x:Key="SpaceH0VM">0,12,0,12</Thickness>
    <Thickness x:Key="SpaceH0VS">0,8,0,8</Thickness>
    <Thickness x:Key="SpaceH0VXS">0,4,0,4</Thickness>
    <Thickness x:Key="SpaceHLV0">16,0,16,0</Thickness>
    <Thickness x:Key="SpaceHLVS">16,8,16,8</Thickness>
    <Thickness x:Key="SpaceHLVXS">16,4,16,4</Thickness>
    <Thickness x:Key="SpaceHMVXS">12,4,12,4</Thickness>
    <Thickness x:Key="SpaceHSVXS">8,4,8,4</Thickness>
    <Thickness x:Key="SpaceLM">12,0,0,0</Thickness>
    <Thickness x:Key="SpaceLS">8,0,0,0</Thickness>
    <Thickness x:Key="SpaceLSTXS">8,4,0,0</Thickness>
    <Thickness x:Key="SpaceLXLRXL">24,0,24,0</Thickness>
    <Thickness x:Key="SpaceLXLTLRXL">24,16,24,0</Thickness>
    <Thickness x:Key="SpaceLXLTSRXL">24,8,24,0</Thickness>
    <Thickness x:Key="SpaceLXS">4,0,0,0</Thickness>
    <Thickness x:Key="SpaceRL">0,0,16,0</Thickness>
    <Thickness x:Key="SpaceRM">0,0,12,0</Thickness>
    <Thickness x:Key="SpaceRS">0,0,8,0</Thickness>
    <Thickness x:Key="SpaceRXS">0,0,4,0</Thickness>
    <Thickness x:Key="SpaceTL">0,16,0,0</Thickness>
    <Thickness x:Key="SpaceTM">0,12,0,0</Thickness>
    <Thickness x:Key="SpaceTS">0,8,0,0</Thickness>
    <Thickness x:Key="SpaceTSBXS">0,8,0,4</Thickness>
    <Thickness x:Key="SpaceTXSBM">0,4,0,12</Thickness>
    <Thickness x:Key="SpaceTXSBS">0,4,0,8</Thickness>
    <Thickness x:Key="SpaceXL">24,24,24,24</Thickness>
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
</ResourceDictionary>
