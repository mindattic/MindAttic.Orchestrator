<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MindAttic.Orchestrator</RootNamespace>
    <AssemblyName>MindAttic.Orchestrator.Core</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <!-- LibraryImport's generated marshalling (CommandLineToArgvW) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Log" Version="3.0.0" />
    <PackageReference Include="MindAttic.Vault" Version="6.0.0" />
    <!-- 4.1.0: TicketsDb.Activity, the workspace's change feed the daemon turns into ticket events on the bus (M.ORCH-T879). -->
    <PackageReference Include="MindAttic.Tickets" Version="4.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- SqlClient's own (9.0.x) has known vulnerabilities; the build treats NU1902/NU1903 as errors. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!-- M.ORCH-T932: the side-by-side TermHost resolver and cleanup live in the dependency-free Term library.
       M.ORCH-T925: so do the session registry and the term-session bus records TermLauncher returns. -->
  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Orchestrator.Term\MindAttic.Orchestrator.Term.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Orchestrator.Tests" />
  </ItemGroup>

</Project>
