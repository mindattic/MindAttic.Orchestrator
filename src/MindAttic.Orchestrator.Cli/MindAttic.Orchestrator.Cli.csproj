<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MindAttic.Orchestrator.Cli</RootNamespace>
    <AssemblyName>orchestrator</AssemblyName>
    <!-- HOUSE-LAW-1: whole-number versions only; bump the major. -->
    <Version>1.0.0</Version>
    <!-- The workspace holding the sibling repos. run.ps1 passes the main checkout's parent, because its deploy worktree
         under MindAttic.worktrees has no siblings at ..\..\.. (M.ORCH-T1313). -->
    <MindAtticRoot Condition="'$(MindAtticRoot)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\..\MindAttic.Helpers')">$(MSBuildThisFileDirectory)..\..\..\</MindAtticRoot>
    <!-- Any other worktree (<workspace>.worktrees\<repo>\<name>, e.g. the orchestrator's main-tests run) finds the
         workspace by dropping ".worktrees" from that folder's name, so a plain build there resolves too (M.ORCH-T1310). -->
    <_MindAtticWorktreesDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..'))</_MindAtticWorktreesDir>
    <MindAtticRoot Condition="'$(MindAtticRoot)' == '' And $(_MindAtticWorktreesDir.EndsWith('.worktrees'))">$(_MindAtticWorktreesDir.Substring(0, $([MSBuild]::Subtract($(_MindAtticWorktreesDir.Length), 10))))\</MindAtticRoot>
    <MindAtticRoot Condition="'$(MindAtticRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</MindAtticRoot>
    <MindAtticDir>$([MSBuild]::EnsureTrailingSlash('$(MindAtticRoot)'))</MindAtticDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Orchestrator.Core\MindAttic.Orchestrator.Core.csproj" />
    <!-- MindAttic.Helpers.Ascii.AsciiMockup (M.HELP-T20): the CLI's own mockup command draws Orchestrator's screens as
         Braille-dot wireframes with it (M.ORCH-T1309). Only the Cli project wants it so far. -->
    <ProjectReference Include="$(MindAtticDir)MindAttic.Helpers\MindAttic.Helpers\MindAttic.Helpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Orchestrator.Tests" />
  </ItemGroup>

</Project>
